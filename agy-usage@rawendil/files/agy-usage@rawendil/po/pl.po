#. applet.js:96
msgid "Waiting for data from `agy`…"
msgstr "Czekam na dane z `agy`…"

#. applet.js:358
msgid "auth"
msgstr "zaloguj"

#. applet.js:363
msgid "n/a"
msgstr "brak"

#. lib.js:98
msgid "data from moments ago"
msgstr "dane sprzed chwili"

#. lib.js:101
#, javascript-format
msgid "data from %d min ago"
msgstr "dane sprzed %d min"

#. lib.js:103
#, javascript-format
msgid "data from %d h %d min ago"
msgstr "dane sprzed %d h %d min"

#. lib.js:120
#, javascript-format
msgid "%s — %s:"
msgstr "%s — %s:"

#. lib.js:126
msgid "5h"
msgstr "5h"

#. lib.js:127
msgid "weekly"
msgstr "tydzień"

#. lib.js:134
#, javascript-format
msgid "reset %s"
msgstr "reset %s"

#. lib.js:162
#, javascript-format
msgid "Last update: %s"
msgstr "Ostatnia aktualizacja: %s"

#. lib.js:165
msgid "never"
msgstr "nigdy"

#. lib.js:170
msgid "(click to refresh)"
msgstr "(kliknij, aby odświeżyć)"

#. lib.js:179
msgid "`agy` not found. Set the path in the applet settings."
msgstr "Nie znaleziono `agy`. Ustaw ścieżkę w ustawieniach apletu."

#. lib.js:181
msgid "`agy` timed out (30 s)."
msgstr "`agy` przekroczył limit czasu (30 s)."

#. lib.js:183
msgid "Could not read the response from `agy`."
msgstr "Nie udało się odczytać odpowiedzi `agy`."

#. lib.js:185
msgid "Sign-in required — run `agy` in a terminal."
msgstr "Wymagane logowanie — uruchom `agy` w terminalu."

#. lib.js:187
msgid "No connection to the Antigravity backend."
msgstr "Brak połączenia z backendem Antigravity."

#. lib.js:222
msgid "no message"
msgstr "brak komunikatu"

#. lib.js:236
#, javascript-format
msgid "`agy` exited with code %d: %s"
msgstr "`agy` zakończył się kodem %d: %s"

#. metadata.json->name
msgid "Antigravity Usage Monitor"
msgstr "Monitor zużycia Antigravity"

#. metadata.json->description
msgid "Display Google Antigravity usage limits (5-hour and weekly)"
msgstr ""
"Pokazuje zużycie limitów Google Antigravity (5-godzinnego i tygodniowego)"

#. settings-schema.json->update-interval->units
msgid "minutes"
msgstr "minut"

#. settings-schema.json->update-interval->description
msgid "Update interval"
msgstr "Częstotliwość odświeżania"

#. settings-schema.json->update-interval->tooltip
msgid "How often the applet runs `agy -p \"/usage\"`"
msgstr "Jak często aplet uruchamia `agy -p \"/usage\"`"

#. settings-schema.json->model-group->description
msgid "Model group on panel"
msgstr "Grupa modeli na panelu"

#. settings-schema.json->model-group->options
msgid "Gemini"
msgstr "Gemini"

#. settings-schema.json->model-group->options
msgid "Claude / GPT"
msgstr "Claude / GPT"

#. settings-schema.json->model-group->tooltip
msgid ""
"Which group of limits appears on the panel. The tooltip always shows both."
msgstr "Która grupa limitów pojawia się na panelu. Dymek zawsze pokazuje obie."

#. settings-schema.json->agy-path->description
msgid "Path to the agy binary"
msgstr "Ścieżka do binarki agy"

#. settings-schema.json->agy-path->tooltip
msgid "Set this when `agy` is not in PATH or in ~/.local/bin"
msgstr "Ustaw, gdy `agy` nie leży w PATH ani w ~/.local/bin"
