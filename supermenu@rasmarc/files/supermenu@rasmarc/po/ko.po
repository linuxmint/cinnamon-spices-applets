msgstr "가져오기 파일이 32 MB를 초과합니다."

msgid "The import file is too large."
msgstr "가져오기 파일이 너무 큽니다."

#, python-format
msgid "The menu layout requires the native function %s."
msgstr "메뉴 배치에 필요한 기본 함수: %s."

msgid "The menu nesting is too deep."
msgstr "메뉴 중첩이 너무 깊습니다."

#, python-format
msgid "The override %s is not part of the settings schema."
msgstr "설정 스키마에 없는 재정의 값: %s."

msgid "The session buttons in this Cinnamon menu version are not supported."
msgstr "이 Cinnamon 메뉴 버전의 세션 버튼은 지원하지 않습니다."

msgid "The target directory does not belong to SuperMenu; no files were changed."
msgstr "대상 디렉터리는 SuperMenu의 것이 아닙니다. 파일을 변경하지 않았습니다."

msgid "The target is a symbolic link; use --target-dir to specify the actual directory."
msgstr "대상은 심볼릭 링크입니다. --target-dir로 실제 디렉터리를 지정하세요."

msgid "Then restart Cinnamon or log out and back in."
msgstr "그런 다음 Cinnamon을 다시 시작하거나 로그아웃 후 다시 로그인하세요."

msgid "This Cinnamon menu arrangement is not supported."
msgstr "이 Cinnamon 메뉴 배치는 지원하지 않습니다."

msgid "This Cinnamon menu entry point is not supported; nothing was installed."
msgstr "이 Cinnamon 메뉴 진입점은 지원하지 않습니다. 아무것도 설치하지 않았습니다."

msgid "This Cinnamon menu version has no supported settings layout."
msgstr "이 Cinnamon 메뉴 버전에는 지원하는 설정 배치가 없습니다."

#, python-format
msgid "This Cinnamon menu version lacks the required function %s."
msgstr "이 Cinnamon 메뉴 버전에 없는 필수 함수: %s."

msgid "This category…"
msgstr "이 범주…"

