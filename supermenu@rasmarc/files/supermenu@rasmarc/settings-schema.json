{
    "layout": {
        "type": "layout",
        "pages": [
            "content",
            "appearance",
            "behavior"
        ],
        "content": {
            "type": "page",
            "title": "Content",
            "sections": [
                "content-content",
                "content-places",
                "content-backup"
            ]
        },
        "content-places": {
            "type": "section",
            "title": "Places",
            "keys": [
                "pm-place-home-row",
                "pm-place-desktop-row",
                "pm-place-documents-row",
                "pm-place-downloads-row",
                "pm-place-music-row",
                "pm-place-pictures-row",
                "pm-place-videos-row",
                "pm-place-bookmarks-row"
            ]
        },
        "content-content": {
            "type": "section",
            "title": "Content",
            "keys": [
                "pm-personal-enabled",
                "pm-personal-places-row",
                "pm-personal-recent-row"
            ]
        },
        "content-backup": {
            "type": "section",
            "title": "Backup",
            "keys": [
                "pm-content-export",
                "pm-content-import",
                "pm-import-replace-row"
            ]
        },
        "appearance": {
            "type": "page",
            "title": "Appearance",
            "sections": [
                "appearance-all-programs",
                "appearance-personal",
                "appearance-panel",
                "appearance-reset"
            ]
        },
        "appearance-all-programs": {
            "type": "section",
            "title": "Applications menu",
            "keys": [
                "pm-program-layout-row",
                "pm-program-drawer-mode-row",
                "show-description-row",
                "pm-search-position-row",
                "pm-group-system-buttons-row",
                "pm-flat-system-buttons-row",
                "pm-program-follow-panel-icon-size",
                "pm-program-icon-size-row",
                "pm-show-lock",
                "pm-show-logout",
                "pm-show-shutdown",
                "pm-shutdown-red-row"
            ]
        },
        "appearance-personal": {
            "type": "section",
            "title": "Custom menu",
            "keys": [
                "pm-editor-header",
                "pm-personal-layout-row",
                "pm-personal-drawer-mode-row",
                "pm-personal-default-category-row",
                "pm-personal-full-drawer-row",
                "pm-personal-recent-visible-limit-row",
                "pm-personal-list-sort-row",
                "pm-personal-list-icons-only-row",
                "pm-personal-grid-sort-row",
                "pm-personal-grid-icons-only-row",
                "pm-personal-grid-columns-row",
                "pm-personal-grid-width-row",
                "pm-personal-follow-panel-icon-size-row",
                "pm-personal-icon-size-row"
            ]
        },
        "appearance-panel": {
            "type": "section",
            "title": "Panel",
            "keys": [
                "pm-primary-style-row",
                "pm-secondary-style-row",
                "pm-spacing-side-row",
                "pm-spacing-percent-row"
            ]
        },
        "appearance-reset": {
            "type": "section",
            "title": "Reset",
            "keys": [
                "reset-menu-size-button"
            ]
        },
        "behavior": {
            "type": "page",
            "title": "Behavior",
            "sections": [
                "behavior-general",
                "behavior-program",
                "behavior-personal",
                "behavior-panel"
            ]
        },
        "behavior-general": {
            "type": "section",
            "title": "General",
            "keys": [
                "enable-autoscroll",
                "enable-animation",
                "activate-on-hover",
                "hover-delay-row"
            ]
        },
        "behavior-program": {
            "type": "section",
            "title": "Applications menu",
            "keys": [
                "category-hover-row"
            ]
        },
        "behavior-personal": {
            "type": "section",
            "title": "Custom menu",
            "keys": [
                "pm-personal-centered-row",
                "pm-editor-block-execution-row",
                "pm-editor-hint-row",
                "pm-editor-hint-blink-row",
                "pm-editor-hint-hide-on-actions-row",
                "pm-extended-context-menu-row"
            ]
        },
        "behavior-panel": {
            "type": "section",
            "title": "Keyboard shortcuts",
            "keys": [
                "pm-menu-shortcut",
                "pm-personal-menu-shortcut-row",
                "pm-editor-shortcut-row"
            ]
        }
    },
    "menu-custom": {
        "type": "switch",
        "default": true,
        "description": "Use a custom icon and label"
    },
    "menu-icon": {
        "type": "iconfilechooser",
        "default": "linuxmint-logo-ring-symbolic",
        "description": "Icon",
        "default_icon": "linuxmint-logo-ring-symbolic",
        "icon_categories": [
            {
                "name": "Linux Mint",
                "icons": [
                    "linuxmint-logo",
                    "linuxmint-logo-badge",
                    "linuxmint-logo-badge-symbolic",
                    "linuxmint-logo-filled-badge",
                    "linuxmint-logo-filled-leaf-badge",
                    "linuxmint-logo-filled-leaf",
                    "linuxmint-logo-filled-ring",
                    "linuxmint-logo-leaf-badge",
                    "linuxmint-logo-leaf-badge-symbolic",
                    "linuxmint-logo-leaf",
                    "linuxmint-logo-leaf-symbolic",
                    "linuxmint-logo-neon",
                    "linuxmint-logo-ring",
                    "linuxmint-logo-ring-symbolic",
                    "linuxmint-logo-simple",
                    "linuxmint-logo-simple-symbolic",
                    "cinnamon-symbolic",
                    "emblem-favorite-symbolic",
                    "user-bookmarks-symbolic",
                    "start-here-symbolic"
                ]
            }
        ],
        "default_category": "Linux Mint"
    },
    "menu-icon-size": {
        "type": "spinbutton",
        "default": 32,
        "min": 16,
        "max": 96,
        "step": 1,
        "units": "px",
        "description": "Icon size"
    },
    "menu-label": {
        "type": "entry",
        "default": "",
        "description": "Text"
    },
    "symbolic-category-icons": {
        "type": "switch",
