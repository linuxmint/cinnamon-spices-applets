{
    "layout": {
        "type": "layout",
        "pages": ["general"],
        "general": {
            "type": "page",
            "title": "General",
            "sections": ["refresh", "location", "vegetation", "panel", "alerts"]
        },
        "refresh": {
            "type": "section",
            "title": "Refresh",
            "keys": ["refresh-interval"]
        },
        "location": {
            "type": "section",
            "title": "Location",
            "keys": ["location-mode", "open-coordinate-map", "manual-latitude", "manual-longitude"]
        },
        "vegetation": {
            "type": "section",
            "title": "Nearby vegetation",
            "keys": ["enable-vegetation-context", "show-vegetation-in-popup", "vegetation-radius"]
        },
        "panel": {
            "type": "section",
            "title": "Panel",
            "keys": ["show-panel-text"]
        },
        "alerts": {
            "type": "section",
            "title": "Notifications",
            "keys": ["notification-level", "test-notification"]
        }
    },
    "refresh-interval": {
        "type": "combobox",
        "default": 60,
        "description": "Refresh interval",
        "options": {
            "30 minutes": 30,
            "60 minutes": 60,
            "120 minutes": 120,
            "240 minutes": 240,
            "360 minutes": 360
        }
    },
    "show-panel-text": {
        "type": "switch",
        "default": true,
        "description": "Show label in panel"
    },
    "location-mode": {
        "type": "combobox",
        "default": "automatic",
        "description": "Location source",
        "options": {
            "Automatic": "automatic",
            "Manual coordinates": "manual"
        }
    },
    "open-coordinate-map": {
        "type": "button",
        "description": "Open coordinate map",
        "callback": "on_open_coordinate_map_pressed",
        "tooltip": "Opens OpenStreetMap in your browser so you can choose a location and copy its coordinates."
    },
    "manual-latitude": {
        "type": "entry",
        "default": "",
        "description": "Manual latitude",
        "tooltip": "Used when Location source is Manual coordinates, and as a fallback if automatic location fails."
    },
    "manual-longitude": {
        "type": "entry",
        "default": "",
        "description": "Manual longitude",
        "tooltip": "Used when Location source is Manual coordinates, and as a fallback if automatic location fails."
    },
    "enable-vegetation-context": {
        "type": "switch",
        "default": true,
        "description": "Enable nearby vegetation context"
    },
    "show-vegetation-in-popup": {
        "type": "switch",
        "default": false,
        "description": "Show vegetation details in popup"
    },
    "vegetation-radius": {
        "type": "combobox",
        "default": 2000,
        "description": "Vegetation search radius",
        "options": {
            "1 km": 1000,
            "2 km": 2000,
            "5 km": 5000
        }
    },
    "notification-level": {
        "type": "combobox",
        "default": "disabled",
        "description": "Notifications",
        "options": {
            "Disabled": "disabled",
            "High + Very High": "high-very-high",
            "Very High only": "very-high"
        }
    },
    "test-notification": {
        "type": "button",
        "description": "Send test notification",
        "callback": "on_test_notification_pressed",
        "tooltip": "Sends one sample High notification. It does not change the current risk."
    }
}
