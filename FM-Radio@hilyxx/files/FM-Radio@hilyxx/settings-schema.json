{
    "layout": {
        "type": "layout",
        "pages": [
            "page_stations",
            "page_settings",
            "tips"
        ],
        "page_stations": {
            "type": "page",
            "title": "Radios",
            "sections": [
                "section_search",
                "section_list"
            ]
        },
        "tips":{
            "type":"page",
            "title":"Tips",
            "sections":[
                "tips-section"
            ]
        },
        "page_settings": {
            "type": "page",
            "title": "Settings",
            "sections": [
                "section_settings",
                 "section_backup",
                "section_shortcuts"
            ]
        },
        "section_search": {
            "type": "section",
            "title": "Radio station search (Radio-Browser API)",
            "keys": [
                "search_keyword",
                "search_button",
                "search_results",
                "clear_button"
            ]
        },
        "section_list": {
            "type": "section",
            "title": "Station management",
            "keys": [
                "custom_stations"
            ]
        },
        "tips-section":{
            "type":"section",
            "title":"Tips",
            "keys":[
                "info1",
                "info2"
            ]
        },
        "section_settings": {
            "type": "section",
            "title": "Recording",
            "keys": [
                "show_recording_notifications",
                "recording_folder",
                "reset_folder_button"
            ]
        },
        "section_shortcuts": {
            "type": "section",
            "title": "Keyboard Shortcuts",
            "keys": [
                "key_play_pause"
            ]
        },
        "section_backup": {
            "type": "section",
            "title": "Backup and Restore radio stations",
            "keys": [
                "export_button",
                "import_file",
                "import_button"
            ]
        }
    },
    "search_keyword": {
        "type": "entry",
        "default": "",
        "description": "Radio station name to search for"
    },
    "search_button": {
        "type": "button",
        "description": "Launch search",
        "callback": "_onSearchClicked"
    },
    "search_results": {
        "type": "textview",
        "description": "Search results (Copy the URL and add it to your list below):",
        "default": "Results will be displayed here..."
    },
    "clear_button": {
        "type": "button",
        "description": "Clear results",
        "callback": "_onClearClicked"
    },
    "custom_stations": {
        "type": "list",
        "description": "Custom radio stations",
        "columns": [
            {"id": "name", "title": "Station name", "type": "string"},
            {"id": "link", "title": "Stream URL", "type": "string"},
            {"id": "pic", "title": "Image path (e.g., /home/user/logo.png)", "type": "string"}
        ],
        "default": [
            {
                "name": "Cinemix HD", 
                "link": "https://kathy.torontocast.com:1825/stream", 
                "pic": "/images/cinemix.png"
            },
            {
                "name": "Radio BOB", 
                "link": "https://regiocast.streamabc.net/regc-boblivenational-mp3-192-4076554", 
                "pic": "/images/BOB.png"
            },
            {
                "name": "Darksynth", 
                "link": "https://stream.nightride.fm/darksynth.mp3", 
                "pic": "/images/darkSynth.jpg"
            }
        ]
    },
    "info1":{
        "type":"label",
        "description":"\nTo create a custom image for a radio station:\n• Create an image of any format (png, jpeg, or svg) with a square 'cover' style size (e.g., 300x300).\n• Station images are stored by default in the applet's image folder, and the path is /images/yourcover.png. For images located in another folder, apply the same process and adapt the path accordingly.\n• The easiest way is to copy the desired image and paste it into the provided field; this will directly paste the image path.\n"
    },
    "info2":{
        "type":"label",
        "description":"\nTo record a live stream, simply click on the cover icon.\nClick it again to stop the recording.\n"
    },
    "show_recording_notifications": {
        "type": "switch",
        "default": true,
        "description": "Show a notification at the start and end of a recording"
    },
    "recording_folder": {
        "type": "filechooser",
        "select-dir": true,
        "default": "",
        "description": "Custom recording folder",
        "tooltip": "Leave empty to use the default Music folder."
    },
    "reset_folder_button": {
        "type": "button",
        "description": "Reset to default Music folder",
        "callback": "_onResetFolderClicked"
    },
    "key_play_pause": {
        "type": "keybinding",
        "description": "Play / Stop",
        "default": "<Primary><Alt>p"
    },
    "export_button": {
        "type": "button",
        "description": "Export stations",
        "callback": "_onExportClicked"
    },
    "import_file": {
        "type": "filechooser",
        "default": "",
        "description": "Select a Backup file (.json) to restore"
    },
    "import_button": {
        "type": "button",
        "description": "Restore stations from the selected file",
        "callback": "_onImportClicked"
    }
}
