#: applet.js
msgid "Checking public IP…"
msgstr "Проверка публичного IP…"

#: applet.js
msgid "Not checked yet"
msgstr "Проверка ещё не выполнялась"

#: applet.js
msgid "Refresh now"
msgstr "Обновить сейчас"

#: applet.js
msgid "a network device was added"
msgstr "добавлено сетевое устройство"

#: applet.js
msgid "a network device was removed"
msgstr "удалено сетевое устройство"

#: applet.js
msgid "active connections changed"
msgstr "изменились активные подключения"

#: applet.js
msgid "the device list changed"
msgstr "изменился список устройств"

#: applet.js
msgid "an interface state changed"
msgstr "изменилось состояние интерфейса"

#: applet.js
#, javascript-format
msgid "Refreshing public IP after %s."
msgstr "Обновляем публичный IP после события: %s."

#: applet.js
#, javascript-format
msgid "Could not start ip: %s"
msgstr "Не удалось запустить ip: %s"

#: applet.js
msgid "Could not read network interfaces."
msgstr "Не удалось прочитать сетевые интерфейсы."

#: applet.js
msgid "network interfaces changed"
msgstr "изменились сетевые интерфейсы"

#: applet.js
#, javascript-format
msgid "Could not start curl: %s"
msgstr "Не удалось запустить curl: %s"

#: applet.js
msgid "The HTTP request failed."
msgstr "HTTP-запрос завершился с ошибкой."

#: applet.js
#, javascript-format
msgid "Could not retrieve the public IP: %s"
msgstr "Не удалось получить публичный IP: %s"

#: applet.js
msgid "l2.io returned invalid JSON."
msgstr "l2.io вернул некорректный JSON."

#: applet.js
msgid "The l2.io response did not contain a valid IP address."
msgstr "В ответе l2.io отсутствует корректный IP-адрес."

#: applet.js
#, javascript-format
msgid "Country lookup failed: %s"
msgstr "Не удалось определить страну: %s"

#: applet.js
msgid "The geolocation service rejected the request."
msgstr "Сервис геолокации отклонил запрос."

#: applet.js
#, javascript-format
msgid "Country: %s (%s)"
msgstr "Страна: %s (%s)"

#: applet.js
#, javascript-format
msgid "Country: %s"
msgstr "Страна: %s"

#: applet.js
msgid "Country unknown."
msgstr "Страна не определена."

#: applet.js
msgid "The IP address was retrieved, but the country response could not be parsed."
msgstr "IP получен, но ответ с данными о стране не удалось разобрать."

#: applet.js
msgid "IP unavailable"
msgstr "IP: —"

#: applet.js
msgid "Public IP is not available yet."
msgstr "Публичный IP пока не получен."

#: applet.js
#, javascript-format
msgid "Public IP: %s"
msgstr "Публичный IP: %s"

#: applet.js
#, javascript-format
msgid "Country code: %s"
msgstr "Код страны: %s"

#: applet.js
msgid "IP source: l2.io"
msgstr "Источник IP: l2.io"

#. metadata.json->name
msgid "Public IP"
msgstr "Публичный IP"

#. metadata.json->description
msgid "Displays the public IP address and country flag, refreshing after network and VPN changes."
msgstr "Показывает публичный IP-адрес и флаг страны, обновляя данные после изменений сети и VPN."
