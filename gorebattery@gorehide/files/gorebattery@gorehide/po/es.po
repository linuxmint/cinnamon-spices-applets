#: ../applet.js:330
msgid "Battery not available"
msgstr "Batería no disponible"

#: ../applet.js:339
msgid "plugged in"
msgstr "conectado a la corriente"

#: ../applet.js:339
msgid "on battery"
msgstr "con batería"

#: ../applet.js:340
msgid "Alert below"
msgstr "Aviso al bajar de"

#: settings-schema.json:1
msgid "Alert"
msgstr "Alerta"

#: settings-schema.json:2
msgid "Battery to monitor"
msgstr "Batería sobre la que actuar"

#: settings-schema.json:3
msgid "Automatic (first battery)"
msgstr "Automática (la primera)"

#: settings-schema.json:4
msgid "Alert when the battery drops below (%)"
msgstr "Avisar cuando la batería baje de (%)"

#: settings-schema.json:5
msgid "The alert only triggers when the charger is unplugged"
msgstr "La alerta solo salta con el cargador desconectado"

#: settings-schema.json:6
msgid "Glow duration (seconds, 0 = until the charger is plugged in)"
msgstr "Duración del halo (segundos, 0 = hasta conectar el cargador)"

#: settings-schema.json:7
msgid "Glow style"
msgstr "Estilo del halo"

#: settings-schema.json:8
msgid "Soft glow"
msgstr "Halo suave"

#: settings-schema.json:9
msgid "Two-color gradient"
msgstr "Degradado de dos colores"

#: settings-schema.json:10
msgid "Fire"
msgstr "Fuego"

#: settings-schema.json:11
msgid "Glow color (not used by Fire)"
msgstr "Color del halo (no se usa en Fuego)"

#: settings-schema.json:12
msgid "Second color (Two-color gradient only)"
msgstr "Segundo color (solo en Degradado de dos colores)"

#: settings-schema.json:13
msgid "Check the battery every (seconds)"
msgstr "Comprobar la batería cada (segundos)"

#: settings-schema.json:14
msgid "Fewer seconds = faster reaction when plugging or unplugging"
msgstr "Menos segundos = reacciona antes al enchufar o desenchufar"

#: settings-schema.json:15
msgid "Appearance"
msgstr "Apariencia"

#: settings-schema.json:16
msgid "Show the percentage in the panel"
msgstr "Mostrar el porcentaje en el panel"
