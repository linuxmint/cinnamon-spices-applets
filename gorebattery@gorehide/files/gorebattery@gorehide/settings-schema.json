{
    "alertHeader": {
        "type": "header",
        "description": "Alert"
    },
    "battery": {
        "type": "combobox",
        "description": "Battery to monitor",
        "default": "auto",
        "options": {
            "Automatic (first battery)": "auto"
        }
    },
    "threshold": {
        "type": "scale",
        "description": "Alert when the battery drops below (%)",
        "tooltip": "The alert only triggers when the charger is unplugged",
        "min": 1,
        "max": 99,
        "step": 1,
        "default": 20
    },
    "glowDuration": {
        "type": "spinbutton",
        "description": "Glow duration (seconds, 0 = until the charger is plugged in)",
        "min": 0,
        "max": 300,
        "step": 1,
        "default": 10,
        "units": "s"
    },
    "glowStyle": {
        "type": "combobox",
        "description": "Glow style",
        "default": "glow",
        "options": {
            "Soft glow": "glow",
            "Two-color gradient": "gradient",
            "Fire": "fire"
        }
    },
    "glowColor": {
        "type": "colorchooser",
        "description": "Glow color (not used by Fire)",
        "default": "rgb(255,0,0)"
    },
    "glowColor2": {
        "type": "colorchooser",
        "description": "Second color (Two-color gradient only)",
        "default": "rgb(255,165,0)"
    },
    "checkInterval": {
        "type": "spinbutton",
        "description": "Check the battery every (seconds)",
        "tooltip": "Fewer seconds = faster reaction when plugging or unplugging",
        "min": 1,
        "max": 60,
        "step": 1,
        "default": 1,
        "units": "s"
    },
    "appearanceHeader": {
        "type": "header",
        "description": "Appearance"
    },
    "showPercent": {
        "type": "switch",
        "description": "Show the percentage in the panel",
        "default": true
    }
}