#: applet.js:866
msgid "Tray icons"
msgstr "Ícones da bandeja"

#: applet.js:867
msgid "All applets"
msgstr "Todos os applets"

#: applet.js:995 applet.js:1016
#, javascript-format
msgid "Group %d"
msgstr "Grupo %d"

#: applet.js:995
msgid "Group"
msgstr "Grupo"

#: applet.js:1044
msgid "No tray icons"
msgstr "Sem ícones da bandeja"

#: applet.js:1250
msgid "Collapse"
msgstr "Recolher"

#: applet.js:1250
