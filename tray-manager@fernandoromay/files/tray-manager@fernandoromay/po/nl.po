#: applet.js:866
msgid "Tray icons"
msgstr "Pictogrammen van het systeemvak"

#: applet.js:867
msgid "All applets"
msgstr "Alle applets"

#: applet.js:995 applet.js:1016
#, javascript-format
msgid "Group %d"
msgstr "Groep %d"

#: applet.js:995
msgid "Group"
msgstr "Groep"

#: applet.js:1044
msgid "No tray icons"
msgstr "Geen pictogrammen van het systeemvak"

