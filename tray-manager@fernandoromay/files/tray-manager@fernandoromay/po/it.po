#: applet.js:866
msgid "Tray icons"
msgstr "Icone del vassoio"

#: applet.js:867
msgid "All applets"
msgstr "Tutti gli applet"

#: applet.js:995 applet.js:1016
#, javascript-format
msgid "Group %d"
msgstr "Gruppo %d"

#: applet.js:995
msgid "Group"
msgstr "Gruppo"

#: applet.js:1044
msgid "No tray icons"
msgstr "Nessuna icona del vassoio"

