#: applet.js:866
msgid "Tray icons"
msgstr "Íconos de la bandeja"

#: applet.js:867
msgid "All applets"
msgstr "Todos los applets"

#: applet.js:995 applet.js:1016
#, javascript-format
msgid "Group %d"
msgstr "Grupo %d"

#: applet.js:995
msgid "Group"
msgstr "Grupo"

#: applet.js:1044
msgid "No tray icons"
msgstr "Sin íconos de la bandeja"

