#: applet.js:866
msgid "Tray icons"
msgstr "Icônes du tiroir"

#: applet.js:867
msgid "All applets"
msgstr "Tous les applets"

#: applet.js:995 applet.js:1016
#, javascript-format
msgid "Group %d"
msgstr "Groupe %d"

#: applet.js:995
msgid "Group"
msgstr "Groupe"

#: applet.js:1044
msgid "No tray icons"
msgstr "Aucune icône de tiroir"

#: applet.js:1250
msgid "Collapse"
msgstr "Réduire"

#: applet.js:1250
