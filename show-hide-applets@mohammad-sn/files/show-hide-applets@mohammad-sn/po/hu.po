#. metadata.json->name
msgid "Drawer (show/hide applets)"
msgstr "Fiók (kisalkalmazások megjelenítése / elrejtése)"

#. metadata.json->description
#, fuzzy
msgid ""
"Hide a few applets to have a neater panel, and make them show up again by a "
"click"
msgstr ""
"rejtsen el néhány kisalkalmazást, a rendezettebb panel érdekében, később "
"újra megjelenítheti azokat egy kattintással"

#. 3.0->settings-schema.json->head->description
#. 6.6->settings-schema.json->head->description
msgid "Settings for show-hide-applets@mohammad-sn"
msgstr "Show-hide-applets@mohammad-sn beállításai"

#. 3.0->settings-schema.json->autohide->tooltip
#. 6.6->settings-schema.json->do_autohide->tooltip
msgid ""
"Check it if you want to hide applets automatically, unless you should click "
"on applet to do so.\n"
"Its status can be changed by middle-clicking on this applet."
msgstr ""
"Jelölje be, ha automatikusan el szeretné rejteni a kisalkalmazásokat, "
"különben a kisalkalmazásra kell kattintania ehhez.\n"
"Állapotát ezen kisalkalmazásra való középső kattintással módosíthatja."

#. 3.0->settings-schema.json->statusintooltip->description
msgid "Show Autohide status in tooltip"
msgstr "Az automatikus elrejtés állapotának megjelenítése az eszköztippekben"

#. 3.0->settings-schema.json->disablestarttimeautohide->description
msgid "Disable start time autohide"
msgstr "Letiltja a kezdési idő automatikus elrejtését"

#. 3.0->settings-schema.json->disablestarttimeautohide->tooltip
msgid "if not in autohide mode"
msgstr "ha nem automatikus elrejtés módban"

#. 3.0->settings-schema.json->hidetime->units
#. 3.0->settings-schema.json->autohiderstime->units
#. 6.6->settings-schema.json->hidetime->units
msgid "seconds"
msgstr "másodperc"

#. 3.0->settings-schema.json->hidetime->description
#. 6.6->settings-schema.json->hidetime->description
msgid "Autohide after "
msgstr "Automatikus elrejtés ennyi idő múlva "

#. 3.0->settings-schema.json->hoveractivates->description
msgid "Activate on hover"
msgstr "Aktiválódjon ha az egér rámutat"

#. 3.0->settings-schema.json->hoveractivates->tooltip
#. 6.6->settings-schema.json->hoveractivates->tooltip
msgid "show applets on mouse hover"
msgstr "kisalkalmazások megjelenítése ha az egér rámutat"

#. 3.0->settings-schema.json->hoveractivateshide->description
#. 6.6->settings-schema.json->hoveractivateshide->description
msgid "Hide on hovering again"
msgstr "Elrejtés, ha az egér újra rámutat"

#. 3.0->settings-schema.json->hoveractivateshide->tooltip
#. 6.6->settings-schema.json->hoveractivateshide->tooltip
msgid "toggle visibility of applets on mouse hover"
msgstr "kapcsolja be az kisalkalmazások láthatóságát ha az egér rámutat"

#. 3.0->settings-schema.json->hovertime->units
#. 6.6->settings-schema.json->hovertime->units
msgid "miliseconds"
msgstr "ezredmásodperc"

#. 3.0->settings-schema.json->hovertime->description
