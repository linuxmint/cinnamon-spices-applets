msgstr "Ngăn kéo (ẩn/hiện applet)"

#. metadata.json->description
#, fuzzy
msgid ""
"Hide a few applets to have a neater panel, and make them show up again by a "
"click"
msgstr ""
"Ẩn một vài applet để bảng gọn gàng hơn và hiển thị lại chúng bằng một cú "
"nhấp chuột"

#. 3.0->settings-schema.json->head->description
#. 6.6->settings-schema.json->head->description
msgid "Settings for show-hide-applets@mohammad-sn"
msgstr "Cài đặt cho show-hide-applets@mohammad-sn"

#. 3.0->settings-schema.json->autohide->tooltip
#. 6.6->settings-schema.json->do_autohide->tooltip
msgid ""
"Check it if you want to hide applets automatically, unless you should click "
"on applet to do so.\n"
"Its status can be changed by middle-clicking on this applet."
msgstr ""
"Chọn mục này nếu bạn muốn ẩn các applet tự động, nếu không bạn phải nhấp vào "
"applet để thực hiện.\n"
"Có thể thay đổi trạng thái bằng cách nhấp chuột giữa vào applet này."

#. 3.0->settings-schema.json->statusintooltip->description
msgid "Show Autohide status in tooltip"
msgstr "Hiển thị trạng thái tự ẩn trong chú giải"

#. 3.0->settings-schema.json->disablestarttimeautohide->description
msgid "Disable start time autohide"
msgstr "Vô hiệu hóa tự ẩn khi khởi động"

#. 3.0->settings-schema.json->disablestarttimeautohide->tooltip
msgid "if not in autohide mode"
msgstr "nếu không ở chế độ tự ẩn"

