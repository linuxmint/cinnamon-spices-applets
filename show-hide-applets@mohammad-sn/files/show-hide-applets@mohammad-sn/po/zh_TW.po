msgstr "滑鼠游標停留後啟用/隱藏延遲時間 "

#. 3.0->settings-schema.json->autohiders->description
#. 6.6->settings-schema.json->autohiders->description
msgid "Autohide reshowing applets"
msgstr "自動隱藏重新顯示的小程式"

#. 3.0->settings-schema.json->autohiderstime->description
msgid "Reshowers' autohide delay: "
msgstr "重新顯示後的自動隱藏延遲時間 "

#. 3.0->settings-schema.json->hideuntilseparator->description
#. 6.6->settings-schema.json->hideuntilseparator->description
msgid "Only hide until next separator"
msgstr "僅隱藏至下一個分隔符號"

#. 3.0->settings-schema.json->hideuntilseparator->tooltip
#. 6.6->settings-schema.json->hideuntilseparator->tooltip
msgid "Only hide everything until the next separator element occurs."
msgstr "僅隱藏所有內容直到下一個分隔符號元素出現為止。"

