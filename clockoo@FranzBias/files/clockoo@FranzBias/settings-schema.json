{
    "layout": {
        "type": "layout",
        "pages": ["page-cuckoo", "page-alarms", "page-timer", "page-general"],
        "page-cuckoo": {
            "type": "page",
            "title": "Cuckoo",
            "sections": ["section-cuckoo"]
        },
        "page-alarms": {
            "type": "page",
            "title": "Alarms",
            "sections": ["section-alarms"]
        },
        "page-timer": {
            "type": "page",
            "title": "Timer",
            "sections": ["section-timer"]
        },
        "page-general": {
            "type": "page",
            "title": "General",
            "sections": ["section-voice", "section-panel"]
        },
        "section-cuckoo": {
            "type": "section",
            "title": "Hourly cuckoo",
            "keys": ["cuckoo-enabled", "cuckoo-hours", "cuckoo-minute", "cuckoo-sound", "cuckoo-count-hours"]
        },
        "section-alarms": {
            "type": "section",
            "title": "Alarms",
            "keys": ["alarms-help", "alarms"]
        },
        "section-timer": {
            "type": "section",
            "title": "Countdown timer",
            "keys": ["timer-sound", "timer-text", "timer-voice", "timer-repeat", "timer-custom-minutes"]
        },
        "section-voice": {
            "type": "section",
            "title": "Voice and snooze",
            "keys": ["snooze-minutes", "piper-dir", "piper-help"]
        },
        "section-panel": {
            "type": "section",
            "title": "Panel",
            "keys": ["show-countdown"]
        }
    },

    "cuckoo-enabled": {
        "type": "switch",
        "default": false,
        "description": "Hourly cuckoo"
    },
    "cuckoo-hours": {
        "type": "entry",
        "default": "7-21",
        "description": "Hours",
        "tooltip": "Hours when the cuckoo calls, e.g. 7-21, or 8,12,18, or 0-23",
        "dependency": "cuckoo-enabled"
    },
    "cuckoo-minute": {
        "type": "spinbutton",
        "default": 0,
        "min": 0,
        "max": 59,
        "step": 1,
        "units": "minutes past the hour",
        "description": "Minute",
        "dependency": "cuckoo-enabled"
    },
    "cuckoo-sound": {
        "type": "soundfilechooser",
        "default": "",
        "description": "Sound",
        "tooltip": "Leave empty for the bundled cuckoo",
        "dependency": "cuckoo-enabled"
    },
    "cuckoo-count-hours": {
        "type": "switch",
        "default": false,
        "description": "Call as many times as the hour",
        "tooltip": "Like a real cuckoo clock: 3 calls at 3 o'clock, 12 at noon",
        "dependency": "cuckoo-enabled"
    },

    "alarms-help": {
        "type": "label",
        "description": "Time as HH:MM. An alarm set to \"Once\" switches itself off after ringing. The text is read aloud in the chosen language."
    },
    "alarms": {
        "type": "list",
        "description": "Alarms",
        "height": 300,
        "columns": [
            {"id": "enabled", "title": "On", "type": "boolean", "default": true},
            {"id": "name", "title": "Name", "type": "string", "default": ""},
            {"id": "time", "title": "Time", "type": "string", "default": "07:00"},
            {"id": "days", "title": "Days", "type": "string", "default": "01234",
             "options": {
                 "Every day": "0123456",
                 "Monday to Friday": "01234",
                 "Saturday and Sunday": "56",
                 "Once": "",
                 "Monday": "0",
                 "Tuesday": "1",
                 "Wednesday": "2",
                 "Thursday": "3",
                 "Friday": "4",
                 "Saturday": "5",
                 "Sunday": "6"
             }},
            {"id": "sound", "title": "Sound", "type": "sound", "default": ""},
            {"id": "text", "title": "Text to read aloud", "type": "string", "default": ""},
            {"id": "voice", "title": "Voice", "type": "string", "default": "",
             "options": {
                 "Automatic": "",
                 "English": "en",
                 "Italiano": "it",
                 "Deutsch": "de",
                 "Español": "es",
                 "Français": "fr"
             }},
            {"id": "repeat", "title": "Repeat", "type": "integer", "default": 3, "min": 1, "max": 20}
        ],
        "default": []
    },

    "timer-sound": {
        "type": "soundfilechooser",
        "default": "",
        "description": "Sound",
        "tooltip": "Leave empty for the bundled kitchen timer"
    },
    "timer-text": {
        "type": "entry",
        "default": "",
        "description": "Text to read aloud (optional)"
    },
    "timer-voice": {
        "type": "combobox",
        "default": "",
        "description": "Voice",
        "options": {
            "Automatic": "",
            "English": "en",
            "Italiano": "it",
            "Deutsch": "de",
            "Español": "es",
            "Français": "fr"
        }
    },
    "timer-repeat": {
        "type": "spinbutton",
        "default": 3,
        "min": 1,
        "max": 20,
        "step": 1,
        "units": "times",
        "description": "Repeat"
    },
    "timer-custom-minutes": {
        "type": "spinbutton",
        "default": 25,
        "min": 1,
        "max": 1440,
        "step": 1,
        "units": "minutes",
        "description": "Custom timer in the menu"
    },

    "snooze-minutes": {
        "type": "spinbutton",
        "default": 5,
        "min": 1,
        "max": 60,
        "step": 1,
        "units": "minutes",
        "description": "Snooze"
    },
    "piper-dir": {
        "type": "filechooser",
        "select-dir": true,
        "default": "",
        "description": "Piper folder (optional)",
        "tooltip": "Only if piper is already installed on this computer: the folder that contains piper/piper and voices/. Leave empty to use speech-dispatcher (spd-say)."
    },
    "piper-help": {
        "type": "label",
        "description": "Text is spoken with speech-dispatcher. If you already have piper, choose its folder for more natural voices."
    },

    "show-countdown": {
        "type": "switch",
        "default": true,
        "description": "Show the running timer in the panel"
    },

    "once-dates": {
        "type": "generic",
        "default": {}
    }
}
