#. settings-schema.json->alarms->columns->title
#. settings-schema.json->timer-repeat->description
msgid "Repeat"
msgstr "Wiederholen"

#. settings-schema.json->timer-sound->tooltip
msgid "Leave empty for the bundled kitchen timer"
msgstr "Leer lassen für den mitgelieferten Küchenwecker"

