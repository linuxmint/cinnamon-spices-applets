#. metadata.json->name
msgid "Clockoo"
msgstr "Clockoo"

#. metadata.json->description
msgid ""
"Hourly cuckoo, named alarms read aloud and countdown timers that keep "
"ringing even if Cinnamon restarts"
msgstr ""
"Stündlicher Kuckuck, benannte Wecker mit Vorlesefunktion und Timer, die auch"
" nach einem Neustart von Cinnamon klingeln"

#. settings-schema.json->page-cuckoo->title
msgid "Cuckoo"
msgstr "Kuckuck"

#. settings-schema.json->page-alarms->title
#. settings-schema.json->section-alarms->title
#. settings-schema.json->alarms->description
msgid "Alarms"
msgstr "Wecker"

#. settings-schema.json->page-general->title
msgid "General"
msgstr "Allgemein"

#. settings-schema.json->section-timer->title
msgid "Countdown timer"
msgstr "Countdown-Timer"

#. settings-schema.json->section-voice->title
msgid "Voice and snooze"
msgstr "Stimme und Schlummern"

#. settings-schema.json->section-panel->title
msgid "Panel"
msgstr "Leiste"

#. settings-schema.json->cuckoo-hours->description
msgid "Hours"
msgstr "Stunden"

#. settings-schema.json->cuckoo-hours->tooltip
msgid "Hours when the cuckoo calls, e.g. 7-21, or 8,12,18, or 0-23"
msgstr "Stunden, in denen der Kuckuck ruft, z. B. 7-21 oder 8,12,18 oder 0-23"

#. settings-schema.json->cuckoo-minute->units
msgid "minutes past the hour"
msgstr "Minuten nach der vollen Stunde"

#. settings-schema.json->cuckoo-minute->description
msgid "Minute"
msgstr "Minute"

#. settings-schema.json->cuckoo-sound->description
#. settings-schema.json->alarms->columns->title
#. settings-schema.json->timer-sound->description
msgid "Sound"
msgstr "Klang"

#. settings-schema.json->cuckoo-sound->tooltip
msgid "Leave empty for the bundled cuckoo"
msgstr "Leer lassen für den mitgelieferten Kuckuck"

#. settings-schema.json->cuckoo-count-hours->description
msgid "Call as many times as the hour"
msgstr "So oft rufen, wie es Uhr ist"

#. settings-schema.json->cuckoo-count-hours->tooltip
msgid "Like a real cuckoo clock: 3 calls at 3 o'clock, 12 at noon"
msgstr "Wie eine echte Kuckucksuhr: 3 Rufe um 3 Uhr, 12 am Mittag"

#. settings-schema.json->alarms-help->description
msgid ""
"Time as HH:MM. An alarm set to \"Once\" switches itself off after ringing. "
"The text is read aloud in the chosen language."
msgstr ""
"Uhrzeit als HH:MM. Ein Wecker auf „Once“ (einmal) schaltet sich nach dem "
"Klingeln selbst ab. Der Text wird in der gewählten Sprache vorgelesen."

#. settings-schema.json->alarms->columns->title
msgid "On"
msgstr "An"

#. settings-schema.json->alarms->columns->title
msgid "Name"
msgstr "Name"

#. settings-schema.json->alarms->columns->title
msgid "Time"
msgstr "Uhrzeit"

#. settings-schema.json->alarms->columns->title
msgid "Days"
msgstr "Tage"

#. settings-schema.json->alarms->columns->title
msgid "Text to read aloud"
msgstr "Vorzulesender Text"

