#. 4.0->settings-schema.json->info1->description
#. 5.8->settings-schema.json->info1->description
msgid ""
"\n"
"• Drag on the menu edge to change the menu size."
msgstr ""
"\n"
"• Arrastre sobre el borde del menú para cambiar su tamaño."

#. 4.0->settings-schema.json->info2->description
#. 5.8->settings-schema.json->info3->description
msgid ""
"\n"
"• Drag and drop menu categories to change their order."
msgstr ""
"\n"
"• Arrastre y suelte las categorías del menú para cambiar su orden."

#. 4.0->settings-schema.json->info3->description
#. 5.8->settings-schema.json->info4->description
msgid ""
"\n"
"• Folders can be set up and removed as menu categories by right-clicking on "
"them."
msgstr ""
"\n"
"• Las carpetas pueden configurarse y eliminarse como categorías de menú "
"haciendo clic con el botón derecho del ratón sobre ellas."

#. 4.0->settings-schema.json->info4->description
#. 5.8->settings-schema.json->info5->description
#, fuzzy
msgid ""
"\n"
"• Additional key option:\n"
"ctrl-d — Open .desktop file of currently highlighted app in default text "
"editor.\n"
msgstr ""
"\n"
"• Opciones de teclas adicionales:\n"
"ctrl-p — Abrir el diálogo de propiedades del lanzador de la aplicación "
"seleccionada.\n"
"ctrl-d — Abrir el archivo .desktop de la aplicación seleccionada en el "
"editor de texto predeterminado.\n"

