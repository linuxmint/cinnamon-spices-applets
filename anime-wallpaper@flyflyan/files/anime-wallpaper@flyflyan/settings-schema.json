{
    "section1": {
        "type": "section",
        "description": "Configure"
    },
    "resource": {
        "type": "entry",
        "default": "https://www.loliapi.com/acg/pc/",
        "description": "Current wallpaper source",
        "tooltip": "Right-click the applet icon and pick a wallpaper source, or type a URL here"
    },
    "customUrls": {
        "type": "textview",
        "default": "",
        "height": 140,
        "description": "Custom wallpaper URLs (one per line)",
        "tooltip": "One http:// or https:// URL per line. These URLs are added to the wallpaper source list in the right-click menu. Plain http:// is not encrypted, so prefer https://."
    },
    "saveImage": {
        "type": "checkbox",
        "default": false,
        "description": "Automatically save background images",
        "tooltip": "Automatically save background images"
    },
    "saveImagePath": {
        "type": "filechooser",
        "select-dir": true,
        "default": "",
        "description": "Save background images to",
        "tooltip": "Automatically save background images to this directory"
    },
    "slideshow": {
        "type": "checkbox",
        "default": true,
        "description": "Play backgrounds as a slideshow",
        "tooltip": "Play backgrounds as a slideshow"
    },
    "delay": {
        "type": "spinbutton",
        "default": 10,
        "min": 1,
        "max": 60,
        "step": 1,
        "units": "minutes",
        "description": "Delay",
        "tooltip": "Delay"
    },
    "clickAction": {
        "type": "combobox",
        "default": "switch",
        "description": "Left-click action",
        "options": {
            "Switch to another wallpaper": "switch",
            "Save the current wallpaper": "save"
        },
        "tooltip": "Switch: left click loads a new wallpaper (and saves it when 'Automatically save background images' is enabled). Save: left click saves the current wallpaper into the save folder, and 'Switch wallpaper' moves to the right-click menu."
    }
}
