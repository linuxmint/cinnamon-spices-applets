#. metadata.json->name
#. applet.js:144 applet.js:338 applet.js:382
msgid "Anime Desktop Wallpaper"
msgstr "Sfondo del Desktop Anime"

#. settings-schema.json->saveImage->description
#. settings-schema.json->saveImage->tooltip
#. applet.js:227
msgid "Automatically save background images"
msgstr "Salva automaticamente le immagini di sfondo"

#. settings-schema.json->slideshow->description
#. settings-schema.json->slideshow->tooltip
#. applet.js:231
msgid "Play backgrounds as a slideshow"
msgstr "Riproduci gli sfondi come una presentazione"

#. applet.js:237
msgid "Switch wallpaper"
msgstr "Cambia sfondo"

#. applet.js:241
msgid "Wallpaper source"
msgstr "Origine dello sfondo"

#. applet.js:283
#, javascript-format
msgid "Custom · %s"
msgstr "Personalizzato · %s"

#. metadata.json->description
msgid "Download and apply Anime Wallpaper to your desktop"
msgstr "Scarica e applica Sfondi Anime sul tuo desktop"

#. settings-schema.json->section1->description
msgid "Configure"
msgstr "Configurazione"

#. settings-schema.json->resource->description
msgid "Current wallpaper source"
msgstr "Origine attuale dello sfondo"

#. settings-schema.json->resource->tooltip
msgid ""
"Right-click the applet icon and pick a wallpaper source, or type a URL here"
msgstr ""
"Fai clic con il pulsante destro sull'icona dell'applet e scegli un'origine "
"per lo sfondo, oppure digita un URL qui"

#. settings-schema.json->customUrls->description
msgid "Custom wallpaper URLs (one per line)"
msgstr "URL di sfondi personalizzati (una per riga)"

#. settings-schema.json->customUrls->tooltip
msgid ""
"One http:// or https:// URL per line. These URLs are added to the wallpaper "
"source list in the right-click menu. Plain http:// is not encrypted, so "
"prefer https://."
msgstr ""
"Un URL http:// o https:// per riga. Questi URL vengono aggiunti all'elenco "
"delle sorgenti di sfondi nel menu contestuale. Il semplice http:// non è "
"crittografato, quindi preferisci https://."

#. settings-schema.json->saveImagePath->description
msgid "Save background images to"
msgstr "Salva le immagini di sfondo in"

#. settings-schema.json->saveImagePath->tooltip
msgid "Automatically save background images to this directory"
msgstr "Salva automaticamente le immagini di sfondo in questa directory"

#. settings-schema.json->delay->units
msgid "minutes"
msgstr "minuti"

#. settings-schema.json->delay->description
#. settings-schema.json->delay->tooltip
msgid "Delay"
msgstr "Ritardo"

#. settings-schema.json->clickAction->description
msgid "Left-click action"
msgstr "Azione del clic sinistro"

#. settings-schema.json->clickAction->options
msgid "Switch to another wallpaper"
msgstr "Passa a un altro sfondo"

#. settings-schema.json->clickAction->options
msgid "Save the current wallpaper"
msgstr "Salva lo sfondo attuale"

#. settings-schema.json->clickAction->tooltip
msgid ""
"Switch: left click loads a new wallpaper (and saves it when 'Automatically "
"save background images' is enabled). Save: left click saves the current "
"wallpaper into the save folder, and 'Switch wallpaper' moves to the right-"
"click menu."
msgstr ""
"Cambia: il clic sinistro carica un nuovo sfondo (e lo salva se «Salva "
"automaticamente le immagini di sfondo» è attivo). Salva: il clic sinistro "
"salva lo sfondo attuale nella cartella di salvataggio, e «Cambia sfondo» "
"passa nel menu contestuale."
