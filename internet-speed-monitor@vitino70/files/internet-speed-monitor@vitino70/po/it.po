#. metadata.json->name
msgid "Internet Speed Monitor"
msgstr "Internet Speed Monitor"

#. metadata.json->description
msgid "Real download and upload speed of the connections that reach the Internet (Wi-Fi, USB tethering, Ethernet, mobile), with mini graphs"
msgstr "Velocità reali di download e upload delle connessioni verso Internet (Wi-Fi, tethering USB, Ethernet, rete mobile), con mini grafici"

#. settings-schema.json->head-general->description
msgid "General"
msgstr "Generale"

#. settings-schema.json->update-interval->description
msgid "Update interval"
msgstr "Intervallo di aggiornamento"

#. settings-schema.json->update-interval->units
msgid "seconds"
msgstr "secondi"

#. settings-schema.json->unit->description
msgid "Unit"
msgstr "Unità di misura"

#. settings-schema.json->unit->options
msgid "Bytes (kB/s, MB/s)"
msgstr "Byte (kB/s, MB/s)"

#. settings-schema.json->unit->options
msgid "Bits (kb/s, Mb/s)"
msgstr "Bit (kb/s, Mb/s)"

#. settings-schema.json->head-iface->description
msgid "Interfaces"
msgstr "Interfacce"

#. settings-schema.json->iface-mode->description
msgid "Monitored interfaces"
msgstr "Interfacce monitorate"

#. settings-schema.json->iface-mode->options
msgid "Automatic: interfaces reaching the Internet (default route)"
msgstr "Automatico: interfacce con accesso a Internet (rotta predefinita)"

#. settings-schema.json->iface-mode->options
msgid "All active physical interfaces"
msgstr "Tutte le interfacce fisiche attive"

#. settings-schema.json->iface-mode->options
msgid "Manual"
msgstr "Manuale"

#. settings-schema.json->manual-ifaces->description
msgid "Interfaces (comma separated)"
msgstr "Interfacce (separate da virgola)"

#. settings-schema.json->manual-ifaces->tooltip
msgid "Example: wlp2s0, enx0a1b2c3d4e5f"
msgstr "Esempio: wlp2s0, enx0a1b2c3d4e5f"

#. settings-schema.json->head-look->description
msgid "Panel appearance"
msgstr "Aspetto nel pannello"

#. settings-schema.json->show-graphs->description
msgid "Show mini graphs"
msgstr "Mostra mini grafici"

#. settings-schema.json->graph-mode->description
msgid "Graph type"
msgstr "Tipo di grafico"

#. settings-schema.json->graph-mode->options
msgid "Two graphs (download and upload)"
msgstr "Due grafici (download e upload)"

#. settings-schema.json->graph-mode->options
msgid "One combined graph"
msgstr "Grafico unico combinato"

#. settings-schema.json->graph-width->description
msgid "Width of each graph"
msgstr "Larghezza di ogni grafico"

#. settings-schema.json->graph-width->units
msgid "pixels"
msgstr "pixel"

#. settings-schema.json->graph-scale->description
msgid "Graph scale"
msgstr "Scala dei grafici"

#. settings-schema.json->graph-scale->options
msgid "Logarithmic (shows both low and high traffic)"
msgstr "Logaritmica (mostra bene sia traffico basso che alto)"

#. settings-schema.json->graph-scale->options
msgid "Linear (auto-scaling)"
msgstr "Lineare (autoadattiva)"

#. settings-schema.json->show-text->description
msgid "Show speed as text"
msgstr "Mostra velocità in testo"

#. settings-schema.json->text-layout->description
msgid "Text layout"
msgstr "Disposizione del testo"

#. settings-schema.json->text-layout->options
msgid "Two lines (compact)"
msgstr "Su due righe (compatto)"

#. settings-schema.json->text-layout->options
msgid "Single line"
msgstr "Su una riga"

#. settings-schema.json->color-down->description
msgid "Download color"
msgstr "Colore download"

#. settings-schema.json->color-up->description
msgid "Upload color"
msgstr "Colore upload"

#. settings-schema.json->color-text->description
msgid "Color the text like the graphs"
msgstr "Colora il testo come i grafici"
