{
	"layout": {
		"type" : "layout",
        "pages": ["appearance-page", "saving-page", "export-page"],

        "appearance-page": {
        	"type" : "page",
            "title": "Appearance",
            "sections": ["appearance-section"]
        },
        
        "saving-page": {
        	"type" : "page",
            "title": "Saving",
            "sections": ["saving-section", "monthly-report-section"]
        },
		
		"export-page": {
        	"type" : "page",
            "title": "Export",
            "sections": ["export-section"]
        },

        "appearance-section": {
        	"type" : "section",
            "title": "Appearance",
            "keys": ["icon-size", "apps-visible", "max-char-for-app-label"]
        },
        
        "saving-section": {
        	"type" : "section",
            "title": "Saving",
            "keys": ["enable-saving", "save-interval", "save-path", "save-now-btn"]
        },
        
        "monthly-report-section": {
        	"type" : "section",
            "title": "Monthly report (Work in progress)",
            "keys": ["enable-monthly-report"]
        },
		
		"export-section": {
        	"type" : "section",
            "title": "Exporting data",
            "keys": ["enable-export-dbus", "show-export-buttons", "export-path"]
        }
    },
	
	"icon-size": {
		"type": "combobox",
		"default": 24,
		"description": "Section icon size",
		"tooltip": "Select the size each app icon uses.",
		"options": {
			"16": 16,
			"24": 24,
			"32": 32,
			"64": 64,
			"128": 128,
			"256": 256,
			"512": 512
		}
	},
	
	"apps-visible": {
		"type": "scale",
		"default": 5,
		"min": 3,
		"max": 10,
		"step": 1,
		"description": "App count before overflowing",
		"tooltip": "Set how many apps should fit within the menu's height before a slider shows up.",
        "callback": "AppsVisibleCountChanged"
	},

    "max-char-for-app-label": {
        "type": "spinbutton",
        "default": 30,
        "min": 20,
		"max": 60,
		"step": 1,
        "callback": "AppLabelCharCountChanged",
        "description": "Max characters for app label",
        "tooltip": "How many characters an app selection allows before cutting the word and adding \"...\" at the end."
    },
	
	"enable-saving": {
		"type": "switch",
		"default": false,
		"description": "Allow Saving progress",
		"tooltip": "Turning this on allow's the applet to save it's progress during the day."
  	},
  	
  	"save-interval": {
		"type": "spinbutton",
		"dependency": "enable-saving",
		"default": 1,
		"min": 1,
		"max": 10,
		"step": 1,
		"units": "Hours",
		"description": "Save interval",
		"tooltip": "The amount of time in hours between saving."
	},
	
	"save-path": {
        "type": "filechooser",
        "dependency": "enable-saving",
        "default": "~/",
        "description": "Progress Save File",
        "tooltip": "This file is used to save app time in case you - (the user) were to shutdown and turn on the device later during the same day. \nWhen \"None\" is set, a default path is used \n\nDefault path: \"home/username/.cache/DailyAppUsage/save.bin\""
    }, 
	
	"save-now-btn": {
		"type": "button",
		"description": "Save now",
		"callback": "SaveBtnPressed"
	},
	
	"enable-monthly-report": {
		"type": "switch",
		"default": false,
		"description": "Allow monthly reports",
		"tooltip": "Turning this will enable monthly reports. This will gather data throughout the month into a single spreadsheet"
  	},
	
	"enable-export-dbus": {
		"type": "switch",
		"default": false,
		"description": "Enable export DBus",
		"tooltip": "When on runs a dbus interface in the background, allowing other apps to retrive app data."
  	},
	
	"show-export-buttons": {
		"type": "combobox",
		"default": "opNone",
		"description": "Export buttons used",
		"tooltip": "Select which buttons will be exported",
		"options": {
			"None": "opNone",
			"CSV": "opCSV",
			"JSON": "opJSON",
			"Both": "opBoth"
		}
	},
	
	"export-path": {
        "type": "entry",
        "default": "",
        "description": "Export Directory",
        "tooltip": "Directory in which export files will be created. files will be named {datetime}.{extension}"
    }
}
