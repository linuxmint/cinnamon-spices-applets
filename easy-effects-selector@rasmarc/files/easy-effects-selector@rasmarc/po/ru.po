#, python-format
msgid "%s (no longer available)"
msgstr "%s (больше недоступен)"

msgid "A blue dot shows a matching preset at its assigned position. Mouse-wheel selection can be enabled or disabled under Controls. Nothing is loaded at startup."
msgstr "Синяя точка обозначает совпадающий пресет в назначенной позиции. Выбор колёсиком мыши можно включить или выключить в разделе «Управление». При запуске ничего не загружается."

msgid "A custom PipeWire configuration is in use; it was left unchanged."
msgstr "Используется собственная конфигурация PipeWire; она оставлена без изменений."

msgid "A physical default output device could not be found."
msgstr "Физическое устройство вывода по умолчанию не найдено."

#, python-format
msgid "A required command is missing: %s"
msgstr "Отсутствует необходимая команда: %s"

msgid "A routing file is a symbolic link; it was left unchanged."
msgstr "Файл маршрутизации является символической ссылкой; он оставлен без изменений."

msgid "An existing routing configuration was left unchanged."
msgstr "Существующая конфигурация маршрутизации оставлена без изменений."

msgid "Another configuration already defines the Easy Effects route."
msgstr "Маршрут Easy Effects уже задан другой конфигурацией."

