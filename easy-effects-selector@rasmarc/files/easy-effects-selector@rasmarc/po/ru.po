msgstr "Внизу"

#, javascript-format
msgid "Bypass could not be changed: %s"
msgstr "Не удалось изменить состояние обхода: %s"

#, javascript-format
msgid "Bypass could not be restored: %s"
msgstr "Не удалось восстановить состояние обхода: %s"

#, javascript-format
msgid "Bypass preservation could not be changed.\n%s"
msgstr "Не удалось изменить сохранение состояния обхода.\n%s"

msgid "Bypass status"
msgstr "Состояние обхода"

msgid "Changed settings"
msgstr "Изменённые настройки"

msgid "Comparison errors"
msgstr "Ошибки сравнения"

