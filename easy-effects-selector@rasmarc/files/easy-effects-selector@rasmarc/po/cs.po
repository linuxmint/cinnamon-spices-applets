msgstr "Easy Effects nenačetl výstupní předvolbu. Zkontrolujte její soubor."

msgid "Effect settings changed"
msgstr "Nastavení efektů změněno"

msgid "Global bypass enabled"
msgstr "Globální bypass zapnut"

msgid "Global bypass is unavailable"
msgstr "Globální bypass není k dispozici"

