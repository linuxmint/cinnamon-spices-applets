#, python-format
msgid "%s (no longer available)"
msgstr "%s (již není k dispozici)"

msgid "A blue dot shows a matching preset at its assigned position. Mouse-wheel selection can be enabled or disabled under Controls. Nothing is loaded at startup."
msgstr "Modrá tečka označuje odpovídající předvolbu na přiřazené pozici. Výběr kolečkem myši lze zapnout nebo vypnout v části Ovládání. Při spuštění se nic nenačítá."

msgid "A custom PipeWire configuration is in use; it was left unchanged."
msgstr "Používá se vlastní konfigurace PipeWire; nebyla změněna."

msgid "A physical default output device could not be found."
msgstr "Nepodařilo se najít fyzické výchozí výstupní zařízení."

#, python-format
msgid "A required command is missing: %s"
msgstr "Chybí požadovaný příkaz: %s"

msgid "A routing file is a symbolic link; it was left unchanged."
msgstr "Soubor přesměrování je symbolický odkaz; nebyl změněn."

msgid "An existing routing configuration was left unchanged."
msgstr "Stávající konfigurace přesměrování nebyla změněna."

msgid "Another configuration already defines the Easy Effects route."
msgstr "Jiná konfigurace již definuje přesměrování Easy Effects."

