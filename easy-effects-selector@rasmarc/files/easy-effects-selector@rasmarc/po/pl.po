#, python-format
msgid "%s (no longer available)"
msgstr "%s (już niedostępne)"

msgid "A blue dot shows a matching preset at its assigned position. Mouse-wheel selection can be enabled or disabled under Controls. Nothing is loaded at startup."
msgstr "Niebieska kropka oznacza zgodne ustawienie wstępne na przypisanej pozycji. Wybór kółkiem myszy można włączyć lub wyłączyć w sekcji Obsługa. Przy uruchamianiu nic nie jest wczytywane."

msgid "A custom PipeWire configuration is in use; it was left unchanged."
msgstr "Używana jest niestandardowa konfiguracja PipeWire; nie została zmieniona."

msgid "A physical default output device could not be found."
msgstr "Nie znaleziono fizycznego domyślnego urządzenia wyjściowego."

#, python-format
msgid "A required command is missing: %s"
msgstr "Brakuje wymaganego polecenia: %s"

msgid "A routing file is a symbolic link; it was left unchanged."
msgstr "Plik przekierowania jest dowiązaniem symbolicznym; nie został zmieniony."

msgid "An existing routing configuration was left unchanged."
msgstr "Istniejąca konfiguracja przekierowania nie została zmieniona."

msgid "Another configuration already defines the Easy Effects route."
msgstr "Inna konfiguracja już definiuje przekierowanie Easy Effects."

#, javascript-format
msgid "Autostart could not be changed: %s"
msgstr "Nie udało się zmienić automatycznego uruchamiania: %s"

msgid "Bottom"
msgstr "Dół"

#, javascript-format
msgid "Bypass could not be changed: %s"
msgstr "Nie udało się zmienić stanu pomijania: %s"

#, javascript-format
msgid "Bypass could not be restored: %s"
msgstr "Nie udało się przywrócić stanu pomijania: %s"

#, javascript-format
msgid "Bypass preservation could not be changed.\n%s"
msgstr "Nie udało się zmienić zachowywania stanu pomijania.\n%s"

msgid "Bypass status"
msgstr "Stan pomijania"

msgid "Changed settings"
msgstr "Zmienione ustawienia"

msgid "Comparison errors"
msgstr "Błędy porównania"

