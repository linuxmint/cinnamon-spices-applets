msgstr "%s (ya no está disponible)"

msgid "A blue dot shows a matching preset at its assigned position. Mouse-wheel selection can be enabled or disabled under Controls. Nothing is loaded at startup."
msgstr "Un punto azul indica un preajuste coincidente en la posición asignada. La selección con la rueda del ratón se puede activar o desactivar en Controles. No se carga nada al iniciar."

msgid "A custom PipeWire configuration is in use; it was left unchanged."
msgstr "Se está usando una configuración personalizada de PipeWire; no se ha modificado."

msgid "A physical default output device could not be found."
msgstr "No se ha encontrado un dispositivo físico de salida predeterminado."

#, python-format
msgid "A required command is missing: %s"
msgstr "Falta un comando necesario: %s"

msgid "A routing file is a symbolic link; it was left unchanged."
msgstr "Un archivo de enrutamiento es un enlace simbólico; no se ha modificado."

msgid "An existing routing configuration was left unchanged."
msgstr "No se ha modificado una configuración de enrutamiento existente."

msgid "Another configuration already defines the Easy Effects route."
msgstr "Otra configuración ya define la ruta de Easy Effects."

