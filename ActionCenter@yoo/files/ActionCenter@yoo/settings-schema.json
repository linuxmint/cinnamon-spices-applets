{
    "layout": {
        "type": "layout",
        "pages": [
            "page-basic",
            "page-toggles",
            "page-context"
        ],
        "page-basic": {
            "type": "page",
            "title": "Basic",
            "sections": [
                "sec-icon",
                "sec-shot",
                "sec-power",
                "sec-player",
                "sec-smooth"
            ]
        },
        "page-toggles": {
            "type": "page",
            "title": "Toggle Switches",
            "sections": [
                "sec-toggles",
                "sec-theme"
            ]
        },
        "page-context": {
            "type": "page",
            "title": "Context Menu",
            "sections": [
                "sec-ctx-sound",
                "sec-ctx-net"
            ]
        },
        "sec-icon": {
            "type": "section",
            "title": "Panel Icon",
            "keys": [
                "panel-icon",
                "panel-icon-height"
            ]
        },
        "sec-shot": {
            "type": "section",
            "title": "Screenshot",
            "keys": [
                "screenshot-command"
            ]
        },
        "sec-power": {
            "type": "section",
            "title": "Power Menu",
            "keys": [
                "power-mode"
            ]
        },
        "sec-player": {
            "type": "section",
            "title": "Player Module",
            "keys": [
                "show-player",
                "player-auto-switch"
            ]
        },
        "sec-toggles": {
            "type": "section",
            "title": "Toggle Switches",
            "keys": [
                "show-toggle-performance",
                "show-toggle-nightlight",
                "show-toggle-darkmode",
                "show-toggle-airplane"
            ]
        },
        "sec-theme": {
            "type": "section",
            "title": "Dark Style Theme",
            "keys": [
                "dark-gtk-theme",
                "dark-icon-theme",
                "dark-cursor-theme",
                "light-gtk-theme",
                "light-icon-theme",
                "light-cursor-theme"
            ]
        },
        "sec-ctx-sound": {
            "type": "section",
            "title": "Sound",
            "keys": [
                "show-context-sound",
                "show-context-mute",
                "show-context-sink-single"
            ]
        },
        "sec-ctx-net": {
            "type": "section",
            "title": "Network",
            "keys": [
                "show-context-network",
                "show-context-wired",
                "show-context-wireless",
                "show-context-wwan"
            ]
        },
        "sec-smooth": {
            "type": "section",
            "title": "Smooth Menu",
            "keys": [
                "smooth-animation"
            ]
        }
    },
    "panel-icon": {
        "type": "iconfilechooser",
        "default": "icons/panel-icon-dark.png",
        "description": "Panel Icon",
        "tooltip": "Custom panel icon image"
    },
    "panel-icon-height": {
        "type": "spinbutton",
        "default": 0,
        "min": 0,
        "max": 64,
        "step": 1,
        "description": "Panel Icon Height (px, 0=auto)",
        "tooltip": "0 = use panel icon size"
    },
    "screenshot-command": {
        "type": "entry",
        "default": "gnome-screenshot",
        "description": "Screenshot Command",
        "tooltip": "Command to run when clicking the screenshot button"
    },
    "show-player": {
        "type": "switch",
        "default": true,
        "description": "Show Player Module",
        "tooltip": "Show/hide the MPRIS media player module"
    },
    "player-auto-switch": {
        "type": "switch",
        "default": false,
        "description": "Auto-switch to Playing Player",
        "tooltip": "Automatically switch to the player that starts playing"
    },
    "show-toggle-performance": {
        "type": "switch",
        "default": true,
        "description": "Show Power Mode Toggle"
    },
    "show-toggle-nightlight": {
        "type": "switch",
        "default": true,
        "description": "Show Night Light Toggle"
    },
    "show-toggle-darkmode": {
        "type": "switch",
        "default": true,
        "description": "Show Dark Style Toggle"
    },
    "show-toggle-airplane": {
        "type": "switch",
        "default": true,
        "description": "Show Airplane Mode Toggle"
    },
    "power-mode": {
        "type": "switch",
        "default": false,
        "description": "Use System Dialog for Power Off",
        "tooltip": "Yes: use cinnamon-session-quit dialog. No: show individual power items"
    },
