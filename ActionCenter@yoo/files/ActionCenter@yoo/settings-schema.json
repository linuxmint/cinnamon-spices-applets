{
    "layout": {
        "type": "layout",
        "pages": [
            "page-basic",
            "page-toggles",
            "page-context"
        ],
        "page-basic": {
            "type": "page",
            "title": "Basic",
            "sections": [
                "sec-icon",
                "sec-shot",
                "sec-power",
                "sec-player",
                "sec-smooth"
            ]
        },
        "page-toggles": {
            "type": "page",
            "title": "Toggle Switches",
            "sections": [
                "sec-toggles",
                "sec-theme"
            ]
        },
        "page-context": {
            "type": "page",
            "title": "Context Menu",
            "sections": [
                "sec-ctx-sound",
                "sec-ctx-net"
            ]
        },
        "sec-icon": {
            "type": "section",
            "title": "Panel Icon",
            "keys": [
                "panel-icon",
                "panel-icon-height"
            ]
        },
        "sec-shot": {
            "type": "section",
            "title": "Screenshot",
            "keys": [
                "screenshot-command"
            ]
        },
        "sec-power": {
            "type": "section",
            "title": "Power Menu",
            "keys": [
                "power-mode"
            ]
        },
        "sec-player": {
            "type": "section",
            "title": "Player Module",
            "keys": [
                "show-player",
                "player-auto-switch"
            ]
        },
        "sec-toggles": {
            "type": "section",
            "title": "Toggle Switches",
            "keys": [
                "show-toggle-performance",
                "show-toggle-nightlight",
                "show-toggle-darkmode",
                "show-toggle-airplane"
            ]
        },
        "sec-theme": {
            "type": "section",
            "title": "Dark Style Theme",
            "keys": [
                "dark-gtk-theme",
                "dark-icon-theme",
                "dark-cursor-theme",
                "light-gtk-theme",
                "light-icon-theme",
                "light-cursor-theme"
            ]
        },
        "sec-ctx-sound": {
            "type": "section",
            "title": "Sound",
            "keys": [
                "show-context-sound",
                "show-context-mute",
                "show-context-sink-single"
            ]
        },
        "sec-ctx-net": {
            "type": "section",
            "title": "Network",
            "keys": [
                "show-context-network",
                "show-context-wired",
                "show-context-wireless",
                "show-context-wwan"
            ]
        },
        "sec-smooth": {
            "type": "section",
            "title": "Smooth Menu",
            "keys": [
                "smooth-animation"
            ]
        }
    },
    "panel-icon": {
        "type": "iconfilechooser",
        "default": "icons/panel-icon-dark.png",
        "description": "Panel Icon",
        "tooltip": "Custom panel icon image"
    },
    "panel-icon-height": {
        "type": "spinbutton",
        "default": 0,
        "min": 0,
        "max": 64,
        "step": 1,
        "description": "Panel Icon Height (px, 0=auto)",
        "tooltip": "0 = use panel icon size"
    },
    "screenshot-command": {
        "type": "entry",
        "default": "gnome-screenshot",
        "description": "Screenshot Command",
        "tooltip": "Command to run when clicking the screenshot button"
    },
    "show-player": {
        "type": "switch",
        "default": true,
        "description": "Show Player Module",
        "tooltip": "Show/hide the MPRIS media player module"
    },
    "player-auto-switch": {
        "type": "switch",
        "default": false,
        "description": "Auto-switch to Playing Player",
        "tooltip": "Automatically switch to the player that starts playing"
    },
    "show-toggle-performance": {
        "type": "switch",
        "default": true,
        "description": "Show Power Mode Toggle"
    },
    "show-toggle-nightlight": {
        "type": "switch",
        "default": true,
        "description": "Show Night Light Toggle"
    },
    "show-toggle-darkmode": {
        "type": "switch",
        "default": true,
        "description": "Show Dark Style Toggle"
    },
    "show-toggle-airplane": {
        "type": "switch",
        "default": true,
        "description": "Show Airplane Mode Toggle"
    },
    "power-mode": {
        "type": "switch",
        "default": false,
        "description": "Use System Dialog for Power Off",
        "tooltip": "Yes: use cinnamon-session-quit dialog. No: show individual power items"
    },
    "dark-gtk-theme": {
        "type": "combobox",
        "default": "",
        "description": "GTK Theme (dark mode)",
        "tooltip": "GTK theme when Dark Style is enabled",
        "options": {
            "(None)": ""
        }
    },
    "dark-icon-theme": {
        "type": "combobox",
        "default": "",
        "description": "Icon Theme (dark mode)",
        "tooltip": "Icon theme when Dark Style is enabled",
        "options": {
            "(None)": ""
        }
    },
    "dark-cursor-theme": {
        "type": "combobox",
        "default": "",
        "description": "Cursor Theme (dark mode)",
        "tooltip": "Cursor theme when Dark Style is enabled",
        "options": {
            "(None)": ""
        }
    },
    "light-gtk-theme": {
        "type": "combobox",
        "default": "",
        "description": "GTK Theme (light mode)",
        "tooltip": "GTK theme when Dark Style is disabled",
        "options": {
            "(None)": "",
            "Adwaita": "Adwaita",
            "Adwaita-dark": "Adwaita-dark",
            "HighContrast": "HighContrast",
            "Mint-L": "Mint-L",
            "Mint-L-Dark": "Mint-L-Dark",
            "Mint-L-Darker": "Mint-L-Darker",
            "Mint-X": "Mint-X",
            "Mint-Y": "Mint-Y",
            "Mint-Y-Dark": "Mint-Y-Dark",
            "Mint-Y-Darker": "Mint-Y-Darker"
        }
    },
    "light-icon-theme": {
        "type": "combobox",
        "default": "",
        "description": "Icon Theme (light mode)",
        "tooltip": "Icon theme when Dark Style is disabled",
        "options": {
            "(None)": "",
            "Adwaita": "Adwaita",
            "ePapirus": "ePapirus",
            "ePapirus-Dark": "ePapirus-Dark",
            "Mint-L": "Mint-L",
            "Mint-X": "Mint-X",
            "Mint-Y": "Mint-Y",
            "Papirus": "Papirus",
            "Papirus-Dark": "Papirus-Dark",
            "Papirus-Light": "Papirus-Light"
        }
    },
    "light-cursor-theme": {
        "type": "combobox",
        "default": "",
        "description": "Cursor Theme (light mode)",
        "tooltip": "Cursor theme when Dark Style is disabled",
        "options": {
            "(None)": "",
            "Adwaita": "Adwaita",
            "Bibata-Modern-Classic": "Bibata-Modern-Classic",
            "Bibata-Modern-Ice": "Bibata-Modern-Ice",
            "Bibata-Original-Classic": "Bibata-Original-Classic",
            "Bibata-Original-Ice": "Bibata-Original-Ice",
            "DMZ-Black": "DMZ-Black",
            "DMZ-White": "DMZ-White",
            "GoogleDot-Black": "GoogleDot-Black",
            "GoogleDot-White": "GoogleDot-White",
            "XCursor-Pro-Dark": "XCursor-Pro-Dark",
            "XCursor-Pro-Light": "XCursor-Pro-Light"
        }
    },
    "show-context-sound": {
        "type": "switch",
        "default": true,
        "description": "Show Sound Items"
    },
    "show-context-mute": {
        "type": "switch",
        "default": false,
        "description": "Show Mute Switches",
        "dependency": "show-context-sound"
    },
    "show-context-network": {
        "type": "switch",
        "default": true,
        "description": "Show Network Items"
    },
    "show-context-wired": {
        "type": "switch",
        "default": true,
        "description": "Show Wired Switch",
        "dependency": "show-context-network"
    },
    "show-context-wireless": {
        "type": "switch",
        "default": true,
        "description": "Show Wireless Switch + Wi-Fi List",
        "dependency": "show-context-network"
    },
    "show-context-wwan": {
        "type": "switch",
        "default": false,
        "description": "Show Mobile Broadband Switch",
        "tooltip": "Off by default (most machines have no WWAN hardware)",
        "dependency": "show-context-network"
    },
    "smooth-animation": {
        "type": "switch",
        "default": true,
        "description": "Enable Animation Effects",
        "tooltip": "Smooth expand/collapse animations for submenus and Wi-Fi list. Turn off on low-end machines."
    },
    "show-context-sink-single": {
        "type": "switch",
        "default": false,
        "description": "Show Output Selector With Single Device",
        "tooltip": "Still show the output device submenu when only one device exists",
        "dependency": "show-context-sound"
    }
}
