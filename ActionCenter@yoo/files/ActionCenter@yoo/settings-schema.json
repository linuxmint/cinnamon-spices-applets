    },
    "show-context-sound": {
        "type": "switch",
        "default": true,
        "description": "Show Sound Items"
    },
    "show-context-mute": {
        "type": "switch",
        "default": false,
        "description": "Show Mute Switches",
        "dependency": "show-context-sound"
    },
    "show-context-network": {
        "type": "switch",
        "default": true,
        "description": "Show Network Items"
    },
    "show-context-wired": {
        "type": "switch",
        "default": true,
        "description": "Show Wired Switch",
        "dependency": "show-context-network"
    },
    "show-context-wireless": {
        "type": "switch",
        "default": true,
        "description": "Show Wireless Switch + Wi-Fi List",
        "dependency": "show-context-network"
    },
    "show-context-wwan": {
        "type": "switch",
        "default": false,
        "description": "Show Mobile Broadband Switch",
        "tooltip": "Off by default (most machines have no WWAN hardware)",
