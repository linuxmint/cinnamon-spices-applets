#. metadata.json->name
msgid "Orloj"
msgstr "Orloj"

#. metadata.json->description
msgid "Prague-style astronomical clock applet"
msgstr "Prahalaistyylinen tähtitieteellinen kello"

#. settings-schema.json->latitude->description
msgid "Latitude (decimal degrees, north positive)"
msgstr "Leveysaste (pohjoinen positiivinen)"

#. settings-schema.json->latitude->tooltip
msgid "Your geographic latitude in decimal degrees, e.g. 50.0875 for Prague"
msgstr "Maantieteellinen leveysasteesi, esim. 50,0875 on Praha"

#. settings-schema.json->longitude->description
msgid "Longitude (decimal degrees, east positive)"
msgstr "Pituusaste (itä positiivinen)"

#. settings-schema.json->longitude->tooltip
msgid "Your geographic longitude in decimal degrees, e.g. 14.4214 for Prague"
msgstr "Maantieteellinen pituusasteesi, esim. 14,4214 Praha"

#. settings-schema.json->refresh-seconds->units
msgid "seconds"
msgstr "sekuntia"

#. settings-schema.json->refresh-seconds->description
msgid "Refresh interval"
msgstr "Päivitysväli"

#. settings-schema.json->accent-color->description
msgid "Accent color"
msgstr "Korostusväri"

#. settings-schema.json->accent-color->tooltip
msgid ""
"Sun, time hand, equinox and LST stars, and the sunrise/sunset glow on the "
"hour ring and sky band"
msgstr ""

#. settings-schema.json->foreground-color->description
msgid "Foreground color"
msgstr "Etualan väri"

#. settings-schema.json->foreground-color->tooltip
msgid ""
"Hour numerals, LST readout, zodiac and planet glyphs, the moon, and the "
"dial's rules and hairlines"
msgstr ""

#. settings-schema.json->background-color->description
msgid "Background color"
msgstr "Taustaväri"

#. settings-schema.json->day-color->description
msgid "Daylight color"
msgstr ""

#. settings-schema.json->day-color->tooltip
msgid "Color of the fully-lit sky on the hour ring and sky band"
msgstr ""

#. settings-schema.json->dial-size->units
msgid "pixels"
msgstr "pikseliä"

#. settings-schema.json->dial-size->description
msgid "Dial size"
msgstr "Kellotaulun koko"

#. settings-schema.json->dial-size->tooltip
msgid "Diameter of the dial in the popup; larger values improve readability"
msgstr "Mittarin halkaisija; suuremmat arvot parantavat luettavuutta"
