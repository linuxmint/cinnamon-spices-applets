{
  "layout": {
    "type": "layout",
    "pages": [
      "pg_widgets",
      "pg_look",
      "pg_text",
      "pg_behaviour"
    ],
    "pg_widgets": {
      "type": "page",
      "title": "Widgets",
      "sections": [
        "sec_widgets"
      ]
    },
    "pg_look": {
      "type": "page",
      "title": "Background",
      "sections": [
        "sec_glass",
        "sec_shape",
        "sec_graphics"
      ]
    },
    "pg_text": {
      "type": "page",
      "title": "Text and colours",
      "sections": [
        "sec_text",
        "sec_alerts"
      ]
    },
    "pg_behaviour": {
      "type": "page",
      "title": "Behaviour",
      "sections": [
        "sec_update",
        "sec_click",
        "sec_claude",
        "sec_weather",
        "sec_devices"
      ]
    },
    "sec_widgets": {
      "type": "section",
      "title": "Widgets in the strip, left to right. Add, remove, reorder and edit them here.",
      "keys": [
        "widgets",
        "widgets_help"
      ]
    },
    "sec_glass": {
      "type": "section",
      "title": "Glass",
      "keys": [
        "glass_on",
        "glass_top",
        "glass_bottom",
        "glass_opacity",
        "border_color",
        "border_width",
        "shadow_on"
      ]
    },
    "sec_shape": {
      "type": "section",
      "title": "Shape and spacing",
      "keys": [
        "strip_height",
        "v_offset",
        "radius",
        "pad_x",
        "pad_y",
        "seg_spacing",
        "separators",
        "separator_color"
      ]
    },
    "sec_graphics": {
      "type": "section",
      "title": "Rings, bars and graphs",
      "keys": [
        "gfx_size",
        "ring_width",
        "bar_width",
        "graph_width",
        "graph_points",
        "track_color",
        "graph_fill"
      ]
    },
    "sec_text": {
      "type": "section",
      "title": "Text",
      "keys": [
        "font_family",
        "show_captions",
        "caption_size",
        "caption_color",
        "value_size",
        "value_color",
        "value_min_width",
        "text_shadow",
        "show_units"
      ]
    },
    "sec_alerts": {
      "type": "section",
      "title": "Alert colours (percent widgets and temperatures in °C)",
      "keys": [
        "warn_at",
        "warn_color",
        "hot_at",
        "hot_color",
        "color_value_text"
      ]
    },
    "sec_update": {
      "type": "section",
      "title": "Updating",
      "keys": [
        "refresh_ms",
        "smooth_samples",
        "custom_every"
      ]
    },
    "sec_click": {
      "type": "section",
      "title": "Clicks",
      "keys": [
        "drag_reorder",
        "left_click",
        "middle_click",
        "custom_click_cmd",
        "menu_details",
        "menu_toggles"
      ]
    },
    "sec_claude": {
      "type": "section",
      "title": "Claude Code",
      "keys": [
        "claude_file",
        "claude_stale_hours",
        "claude_show_reset",
        "stats_cmd"
      ]
    },
    "sec_weather": {
      "type": "section",
      "title": "Weather (Open-Meteo, no key needed)",
      "keys": [
        "weather_units",
        "weather_every",
        "weather_caption"
      ]
    },
    "sec_devices": {
      "type": "section",
      "title": "Wireless device batteries",
      "keys": [
        "logi_enabled",
        "logi_every"
      ]
    }
  },
  "widgets": {
    "type": "list",
    "description": "Widgets",
    "height": 420,
    "columns": [
      {
        "id": "enabled",
        "title": "On",
        "type": "boolean",
        "default": true
      },
      {
        "id": "type",
        "title": "Widget",
        "type": "string",
        "options": {
          "Claude weekly limit": "claude_week",
          "Claude 5 hour limit": "claude_5h",
          "Uptime": "uptime",
          "CPU usage": "cpu",
          "CPU temperature": "cpu_temp",
          "Load average": "load",
          "RAM": "ram",
          "Swap": "swap",
          "GPU usage": "gpu",
          "GPU temperature": "gpu_temp",
          "GPU memory (VRAM)": "vram",
          "Disk space": "disk",
          "Disk read+write": "disk_io",
          "Network download": "net_down",
          "Network upload": "net_up",
          "Battery (laptop)": "battery",
          "Bluetooth / wireless device battery": "device_bat",
          "Weather": "weather",
          "Clock / date": "clock",
          "Custom command": "custom"
        },
        "default": "cpu"
      },
      {
        "id": "style",
        "title": "Style",
        "type": "string",
        "options": {
          "Default for type": "auto",
          "Ring": "ring",
          "Bar": "bar",
