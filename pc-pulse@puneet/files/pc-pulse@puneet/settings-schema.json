  "widgets_help": {
    "type": "label",
    "description": "Option column: Disk space = mount path (/). Network = interface (blank = all). Battery (laptop) = device name from /sys/class/power_supply (blank = first). Bluetooth / wireless device battery = part of the device name, for example NuPhy or MX Vertical (blank = first found; hover the widget to see names). Weather = latitude,longitude, for example 51.51,-0.13 (fetched from Open-Meteo). Clock = strftime format (%H:%M, %a %d). Custom command = shell command; first line of output is shown, a bare number 0 to 100 also fills the ring. CPU/GPU temperature = hwmon sensor name to force (k10temp, coretemp, amdgpu)."
  },
  "glass_on": {
    "type": "switch",
    "default": true,
    "description": "Glass background"
  },
  "glass_top": {
    "type": "colorchooser",
    "default": "rgb(150,165,200)",
    "description": "Glass colour, top"
  },
  "glass_bottom": {
    "type": "colorchooser",
    "default": "rgb(70,82,115)",
    "description": "Glass colour, bottom"
  },
  "glass_opacity": {
    "type": "scale",
    "default": 60,
    "min": 0,
    "max": 100,
    "step": 1,
    "show-value": true,
    "description": "Glass opacity (%)"
  },
  "border_color": {
    "type": "colorchooser",
    "default": "rgba(255,255,255,0.38)",
    "description": "Border colour"
  },
  "border_width": {
    "type": "spinbutton",
    "default": 1,
    "min": 0,
    "max": 4,
    "step": 1,
    "units": "px",
    "description": "Border width"
  },
  "shadow_on": {
    "type": "switch",
    "default": true,
    "description": "Top highlight line"
  },
  "strip_height": {
    "type": "spinbutton",
    "default": 0,
    "min": 0,
    "max": 120,
    "step": 1,
    "units": "px",
    "description": "Strip height (0 = panel height minus 8 px)"
  },
  "v_offset": {
    "type": "spinbutton",
    "default": 0,
    "min": -10,
    "max": 10,
    "step": 1,
    "units": "px",
    "description": "Vertical nudge (negative = up)"
  },
  "radius": {
    "type": "spinbutton",
    "default": 15,
    "min": 0,
    "max": 30,
    "step": 1,
    "units": "px",
    "description": "Corner radius"
  },
  "pad_x": {
    "type": "spinbutton",
    "default": 10,
    "min": 0,
    "max": 30,
    "step": 1,
    "units": "px",
    "description": "Inner padding, sides"
  },
  "pad_y": {
    "type": "spinbutton",
    "default": 0,
    "min": 0,
    "max": 10,
    "step": 1,
    "units": "px",
    "description": "Inner padding, top and bottom"
  },
  "seg_spacing": {
    "type": "spinbutton",
    "default": 4,
    "min": 0,
    "max": 30,
    "step": 1,
    "units": "px",
    "description": "Space between widgets"
  },
  "separators": {
    "type": "switch",
    "default": true,
    "description": "Dividers between widgets"
  },
  "separator_color": {
    "type": "colorchooser",
    "default": "rgba(255,255,255,0.30)",
    "description": "Divider colour"
  },
  "gfx_size": {
    "type": "spinbutton",
    "default": 22,
    "min": 12,
    "max": 34,
    "step": 1,
    "units": "px",
    "description": "Ring size"
  },
  "ring_width": {
    "type": "spinbutton",
    "default": 3.2,
    "min": 1,
    "max": 8,
    "step": 0.2,
    "units": "px",
    "description": "Ring thickness"
  },
  "bar_width": {
    "type": "spinbutton",
    "default": 34,
    "min": 12,
    "max": 80,
    "step": 1,
    "units": "px",
    "description": "Bar length"
  },
  "graph_width": {
    "type": "spinbutton",
    "default": 34,
    "min": 16,
    "max": 120,
    "step": 1,
    "units": "px",
    "description": "Graph width"
  },
  "graph_points": {
    "type": "spinbutton",
    "default": 40,
    "min": 10,
    "max": 300,
    "step": 5,
    "units": "samples",
    "description": "Graph history"
  },
  "track_color": {
    "type": "colorchooser",
    "default": "rgba(0,0,0,0.28)",
    "description": "Empty track colour"
  },
  "graph_fill": {
    "type": "switch",
    "default": true,
    "description": "Fill under graphs"
  },
  "font_family": {
    "type": "entry",
    "default": "",
    "description": "Font (blank = theme font)",
    "tooltip": "Any installed font, for example Inter, Ubuntu, JetBrains Mono"
  },
  "show_captions": {
    "type": "switch",
    "default": true,
    "description": "Show captions above values"
  },
  "caption_size": {
    "type": "spinbutton",
    "default": 7,
    "min": 5,
    "max": 14,
    "step": 0.5,
    "units": "pt",
    "description": "Caption size"
  },
  "caption_color": {
    "type": "colorchooser",
    "default": "rgba(255,255,255,0.80)",
    "description": "Caption colour"
  },
  "value_size": {
    "type": "spinbutton",
    "default": 10,
    "min": 6,
    "max": 20,
    "step": 0.5,
    "units": "pt",
    "description": "Value size"
  },
  "value_color": {
    "type": "colorchooser",
    "default": "rgb(255,255,255)",
    "description": "Value colour"
  },
  "value_min_width": {
    "type": "spinbutton",
    "default": 34,
    "min": 0,
    "max": 120,
    "step": 1,
    "units": "px",
    "description": "Value minimum width (stops jitter)"
  },
  "text_shadow": {
    "type": "switch",
    "default": true,
    "description": "Text shadow"
  },
  "show_units": {
    "type": "switch",
    "default": true,
    "description": "Show units (%, °C, GB)"
  },
  "warn_at": {
    "type": "spinbutton",
    "default": 75,
    "min": 1,
    "max": 100,
    "step": 1,
    "units": "",
    "description": "Warning from"
  },
  "warn_color": {
    "type": "colorchooser",
    "default": "rgb(255,179,71)",
    "description": "Warning colour"
  },
  "hot_at": {
    "type": "spinbutton",
    "default": 90,
    "min": 1,
    "max": 100,
    "step": 1,
    "units": "",
    "description": "Critical from"
  },
  "hot_color": {
    "type": "colorchooser",
    "default": "rgb(255,107,107)",
    "description": "Critical colour"
  },
  "color_value_text": {
    "type": "switch",
    "default": true,
    "description": "Colour the value text too"
  },
  "refresh_ms": {
    "type": "spinbutton",
    "default": 1000,
    "min": 250,
    "max": 10000,
    "step": 250,
    "units": "ms",
    "description": "Refresh every"
  },
  "smooth_samples": {
    "type": "spinbutton",
    "default": 3,
    "min": 1,
    "max": 20,
    "step": 1,
    "units": "samples",
    "description": "GPU smoothing",
    "tooltip": "The AMD busy counter jumps a lot; the strip shows the mean of this many readings"
  },
  "custom_every": {
    "type": "spinbutton",
    "default": 30,
    "min": 1,
    "max": 3600,
    "step": 1,
    "units": "s",
    "description": "Run custom commands every"
  },
  "left_click": {
    "type": "combobox",
    "default": "menu",
    "options": {
      "Open the menu": "menu",
      "Open Claude stats page": "stats",
      "Open system monitor": "sysmon",
      "Open settings": "settings",
      "Run custom command": "custom"
    },
    "description": "Left click"
  },
  "middle_click": {
    "type": "combobox",
    "default": "sysmon",
    "options": {
      "Nothing": "none",
      "Open Claude stats page": "stats",
      "Open system monitor": "sysmon",
      "Open settings": "settings",
      "Run custom command": "custom"
    },
    "description": "Middle click"
  },
  "custom_click_cmd": {
    "type": "entry",
    "default": "gnome-system-monitor",
    "description": "Custom click command"
  },
  "menu_details": {
    "type": "switch",
    "default": true,
    "description": "Menu shows live details"
  },
  "menu_toggles": {
    "type": "switch",
    "default": true,
    "description": "Menu shows on/off switches for widgets"
  },
  "claude_file": {
    "type": "entry",
    "default": "",
    "description": "Limits file (blank = auto)",
    "tooltip": "JSON with rate_limits.seven_day / five_hour, written by the bundled claude-statusline.py (see README). Auto reads ~/.cache/pc-pulse/claude-limits.json"
  },
  "claude_stale_hours": {
    "type": "spinbutton",
    "default": 6,
    "min": 1,
    "max": 168,
    "step": 1,
    "units": "h",
    "description": "Dim the figure when older than"
  },
  "claude_show_reset": {
    "type": "switch",
    "default": true,
    "description": "Show time to reset in the caption"
  },
  "drag_reorder": {
    "type": "switch",
    "default": true,
    "description": "Drag widgets in the panel to reorder them",
    "tooltip": "Hold left click on a widget, drag it sideways, let go"
  },
  "logi_enabled": {
    "type": "switch",
    "default": true,
    "description": "Read exact % from Logitech devices (HID++)",
    "tooltip": "The Linux driver gives only Full/High/Low for some Logitech mice; this asks the device itself through the receiver"
  },
  "logi_every": {
    "type": "spinbutton",
    "default": 5,
    "min": 1,
    "max": 60,
    "step": 1,
    "units": "min",
    "description": "Check Logitech devices every"
  },
  "weather_units": {
    "type": "combobox",
    "default": "celsius",
    "options": {
      "Celsius, km/h": "celsius",
      "Fahrenheit, mph": "fahrenheit"
    },
    "description": "Units"
  },
  "weather_every": {
    "type": "spinbutton",
    "default": 15,
    "min": 5,
    "max": 180,
    "step": 5,
    "units": "min",
    "description": "Update weather every"
  },
  "weather_caption": {
    "type": "combobox",
    "default": "condition",
    "options": {
      "Condition (Partly cloudy)": "condition",
      "Feels like": "feels",
      "Today low / high": "range",
      "Plain caption": "plain"
    },
    "description": "Weather caption"
  },
  "stats_cmd": {
    "type": "entry",
    "default": "",
    "description": "Stats page command (optional)",
    "tooltip": "A command that opens your own usage stats page; adds a menu entry and a click action"
  }
}