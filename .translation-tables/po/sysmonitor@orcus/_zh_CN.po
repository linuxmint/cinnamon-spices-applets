#. 3.2->settings-schema.json->net_minimum_graph_scale->description
msgid "Minimum graph scale"
msgstr ""

#. 3.2->settings-schema.json->net_minimum_graph_scale->units
msgid "Mb/s"
msgstr ""

#. 3.2->settings-schema.json->net_minimum_graph_scale->tooltip
msgid ""
"The minimum scale for the graph in Megabits per second.\n"
"The graph will not scale below this minimum, but it will automatically scale "
"if the network speed exceeds this value.\n"
"\n"
"To always automatically scale, set the value to 0."
msgstr ""

#. 3.2->settings-schema.json->net_rescan_interval->description
#. 3.0->settings-schema.json->net_rescan_interval->description
msgid "Rescan interval"
msgstr ""

#. 3.2->settings-schema.json->net_rescan_interval->units
#. 3.0->settings-schema.json->net_rescan_interval->units
msgid "seconds"
msgstr ""

#. 3.2->settings-schema.json->net_rescan_interval->tooltip
#. 3.0->settings-schema.json->net_rescan_interval->tooltip
msgid ""
"How often to look for network interfaces that were added since the applet "
"started (USB network adapters, Docker bridges, VPN tunnels, ...).\n"
"\n"
"Interfaces that were removed are always ignored automatically.\n"
"\n"
"To disable rescanning, set the value to 0."
msgstr ""
