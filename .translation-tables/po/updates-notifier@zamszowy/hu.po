#. metadata.json->name
msgid "Updates notifier"
msgstr "Frissítésértesítő"

#. metadata.json->description
msgid "Shows icons for pending update packages"
msgstr "Megjeleníti a frissítésre váró csomagok ikonjait"

#. settings-schema.json->pageBehavior->title
msgid "Behavior"
msgstr "Viselkedés"

#. settings-schema.json->pageAppearance->title
msgid "Appearance"
msgstr "Megjelenés"

#. settings-schema.json->sectionSettings->title
msgid "Settings"
msgstr "Beállítások"

#. settings-schema.json->sectionIconLabel->title
msgid "Icon/Label"
msgstr "Ikon/Címke"

#. settings-schema.json->sectionClick->title
msgid "Applet click"
msgstr "Kattintás a kisalkalmazásra"

#. settings-schema.json->sectionMenu->title
msgid "Menu"
msgstr "Menü"

#. settings-schema.json->sectionTheme->title
msgid "Theme"
msgstr "Téma"

#. settings-schema.json->use-timer->description
#, fuzzy
msgid "Automatically check for updates"
msgstr "Hiba a frissítések ellenőrzésekor"

#. settings-schema.json->use-timer->tooltip
msgid ""
"When turned off, updates will still show when checked manually or refreshed "
"by another process"
msgstr ""

#. settings-schema.json->update-refresh->description
#, fuzzy
msgid "Active minutes to wait before refreshing updates"
msgstr "Várakozási idő a frissítések ellenőrzése előtt (perc)"

#. settings-schema.json->update-refresh->tooltip
msgid ""
"Refresh wait time is reset when applet or Cinnamon are reset and does not "
"include inactive time (e.g. when computer is suspended)"
msgstr ""

#. settings-schema.json->show-firmware->description
msgid "Show firmware updates"
msgstr "Firmware-frissítések megjelenítése"

#. settings-schema.json->hide-applet->description
msgid "Hide applet if there are no updates"
msgstr "Kisalkalmazás elrejtése, ha nincsenek frissítések"

#. settings-schema.json->different-levels->description
msgid "Show different applet icon for different updgradeable packages count"
msgstr ""
"Különböző kisalkalmazás-ikonok megjelenítése a frissíthető csomagok számának "
"függvényében"

#. settings-schema.json->level-1->description
msgid "Show low level icon when updates count is between 0 and this value "
msgstr ""
"Alacsony szintű ikon megjelenítése, ha a frissítések száma 0 és ezen "
"megadott érték között van "

#. settings-schema.json->level-2->description
msgid ""
"Show medium level icon when updates count is between low level value and "
"this value. Show high level icon if it's higher than this value."
msgstr ""
"Közepes szintű ikon megjelenítése, ha a frissítések száma az alacsony szintű "
"érték és ezen megadott érték között van. Magas szintű ikon megjelenítése, ha "
"ennél az értéknél magasabb."

#. settings-schema.json->show-label->description
msgid "Show label with updates count"
msgstr "Címke megjelenítése a frissítések számával"

#. settings-schema.json->label-font-size->description
msgid "Label font size"
msgstr "Címke betűmérete"

#. settings-schema.json->label-font-weight->description
msgid "Label font weight"
msgstr "Címke betűvastagsága"

#. settings-schema.json->label-vertical-position->description
msgid "Label vertical position"
msgstr "Címke függőleges pozíciója"

#. settings-schema.json->show-window-on-click->description
msgid "Show updates window on left click and menu entries on right click"
msgstr ""
"Bal egérgombbal a frissítések ablaka, jobb egérgombbal a menüpontok "
"jelenjenek meg"

#. settings-schema.json->refresh-when-no-updates->description
msgid "Refresh updates list on left click if there are no updates"
msgstr ""
"Ha nincs frissítés, a bal egérgombbal kattintva frissüljön a frissítések "
"listája"

#. settings-schema.json->commandUpdate-show->description
msgid "Show \"Check for new updates\" command"
msgstr "„Új frissítések keresése” parancs megjelenítése"

#. settings-schema.json->commandUpgrade-show->description
msgid "Show \"Upgrade packages\" command"
msgstr "„Csomagok frissítése” parancs megjelenítése"

#. settings-schema.json->commandUpgrade->description
msgid "Upgrade packages command:"
msgstr "Parancs a csomagok frissítéséhez:"

