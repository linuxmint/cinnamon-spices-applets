#. applet.js:506
msgid "No windows open"
msgstr "Nincsenek nyitott ablakok"

#. applet.js:689
msgid "All windows closed!"
msgstr "Minden ablak zárva!"

#. metadata.json->description
msgid "Click to see all open windows. Click a window to close it."
msgstr ""
"Kattintson az összes nyitott ablak megtekintéséhez. Kattintson egy ablakra a "
"bezárásához."
