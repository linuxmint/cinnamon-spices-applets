#. applet.js:70 applet.js:368
msgid "Window Closer"
msgstr "Cerrador de ventanas"

#. applet.js:377
msgid "Click a window to close it · Scroll for more · Esc to exit"
msgstr ""
"Haga clic en una ventana para cerrarla · Desplácese para ver más · Pulse Esc "
"para salir"

#. applet.js:378
msgid "Click a window to close it · Esc to exit"
msgstr "Haga clic en una ventana para cerrarla · Pulse Esc para salir"

#. applet.js:506
msgid "No windows open"
msgstr "No hay ventanas abiertas"

#. applet.js:689
msgid "All windows closed!"
msgstr "¡Todas las ventanas cerradas!"

#. metadata.json->description
msgid "Click to see all open windows. Click a window to close it."
msgstr ""
"Haga clic para ver todas las ventanas abiertas. Haga clic en una ventana "
"para cerrarla."
