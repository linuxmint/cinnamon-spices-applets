#: applet.js:62
#, javascript-format
msgid "AWS · Configure"
msgstr "AWS · 配置"

#: applet.js:90
#, javascript-format
msgid "Refresh now"
msgstr "立即刷新"

#: applet.js:91
#, javascript-format
msgid "Configure…"
msgstr "配置…"

#: applet.js:180
#, javascript-format
msgid "Could not send the system notification."
msgstr "无法发送系统通知。"

#: applet.js:197
#, javascript-format
msgid "AWS · Internal error"
msgstr "AWS · 内部错误"

#: applet.js:210
#, javascript-format
msgid "no percentage"
msgstr "暂无百分比"

#: applet.js:214
#, javascript-format
msgid "AWS · Error"
msgstr "AWS · 错误"

#: applet.js:214
#, javascript-format
msgid "AWS · Retrying"
msgstr "AWS · 正在重试"

#: applet.js:214
#, javascript-format
msgid "AWS %s"
msgstr "AWS %s"

#: applet.js:214
#, javascript-format
msgid "AWS · %s"
msgstr "AWS · %s"

#: applet.js:218
#, javascript-format
msgid "AWS Cold Restore Monitor: %s"
msgstr "AWS Cold Restore Monitor：%s"

#: applet.js:219
#, javascript-format
msgid "%s · %s"
msgstr "%s · %s"

#: applet.js:220
#, javascript-format
msgid "Right-click and choose Configure to select a restore job."
msgstr "右键单击并选择“配置”，以选择还原任务。"

#: applet.js:223
#, javascript-format
msgid ""
"Automatic queries are paused. Fix the problem and click Refresh now or "
"change the settings."
msgstr "自动查询已暂停。请解决问题后单击“立即刷新”，或更改设置。"

#: applet.js:224
#, javascript-format
msgid "AWS: %s"
msgstr "AWS：%s"

#: applet.js:226
#, javascript-format
msgid "Status: %s (previous result; query pending)"
msgstr "状态：%s（上次结果；等待查询）"

#: applet.js:226
#, javascript-format
msgid "Status: %s"
msgstr "状态：%s"

#: applet.js:227
#, javascript-format
msgid "Estimated progress: %s"
msgstr "预计进度：%s"

#: applet.js:228
#, javascript-format
msgid "Job: %s"
msgstr "任务：%s"

#: applet.js:228
#, javascript-format
msgid "not configured"
msgstr "未配置"

#: applet.js:229
#, javascript-format
msgid "Profile: %s · Region: %s"
msgstr "配置文件：%s · 区域：%s"

#: applet.js:230
#, javascript-format
msgid "Started: %s"
msgstr "开始时间：%s"

#: applet.js:231
#, javascript-format
msgid "Completed: %s"
msgstr "完成时间：%s"

#: applet.js:232
#, javascript-format
msgid "Last successful query: %s"
msgstr "上次查询成功时间：%s"

#: applet.js:273
#, javascript-format
msgid "Configure"
msgstr "配置"

#: applet.js:274
#, javascript-format
msgid ""
"Enter the profile, region, restore job ID, and AWS CLI path in Configure."
msgstr "请在“配置”中填写配置文件、区域、还原任务 ID 和 AWS CLI 路径。"

#: applet.js:278
#, javascript-format
msgid "The interval must be between 10 and 3600 seconds. Check the settings."
msgstr "查询间隔必须介于 10 到 3600 秒之间。请检查设置。"

#: applet.js:281
#, javascript-format
msgid "Querying…"
msgstr "正在查询…"

#: applet.js:339
#, javascript-format
msgid "AWS reports that the restore failed. Review the job in AWS Backup."
msgstr "AWS 报告还原失败。请在 AWS Backup 中查看该任务。"

#: applet.js:339
#, javascript-format
msgid "AWS reports that the restore was aborted. Review the job in AWS Backup."
msgstr "AWS 报告还原已中止。请在 AWS Backup 中查看该任务。"

#: applet.js:343
#, javascript-format
msgid "Query successful"
msgstr "查询成功"

#: applet.js:345
#, javascript-format
msgid ""
"AWS has not reported a valid percentage. The job status is still available."
msgstr "AWS 尚未提供有效的百分比。仍可查看任务状态。"

#: applet.js:348
#, javascript-format
msgid ""
"The query succeeded, but AWS CLI issued a warning. Run the query in your "
"terminal to review it."
msgstr "查询成功，但 AWS CLI 发出了警告。请在终端中运行该查询以查看警告。"

#: applet.js:380
#, javascript-format
msgid "Could not load the applet. Check the installation and add it again."
msgstr "无法加载小程序。请检查安装情况并重新添加小程序。"

#: errors.js:28
#, javascript-format
msgid "The query exceeded 60 seconds. It will be retried automatically."
msgstr "查询已超过 60 秒，将自动重试。"

#: errors.js:30
#, javascript-format
msgid ""
"The monitor encountered an internal error. Remove the applet and add it "
"again."
msgstr "监视器遇到内部错误。请移除小程序后重新添加。"

#: errors.js:32
#, javascript-format
msgid ""
"AWS returned an invalid response. Check the query with AWS CLI and click "
"Refresh now."
msgstr "AWS 返回了无效响应。请使用 AWS CLI 检查查询，然后单击“立即刷新”。"

#: errors.js:34
#, javascript-format
msgid ""
"Could not authenticate with AWS. Check your credentials or renew your SSO "
"session, then click Refresh now."
msgstr "无法通过 AWS 身份验证。请检查凭证或续期 SSO 会话，然后单击“立即刷新”。"

#: errors.js:36
#, javascript-format
msgid ""
"AWS denied access. Check the backup:DescribeRestoreJob permission for this "
"profile."
msgstr "AWS 拒绝访问。请检查此配置文件的 backup:DescribeRestoreJob 权限。"

#: errors.js:38
#, javascript-format
msgid ""
"The job or profile was not found. Check the profile, region, and restore job "
"ID."
msgstr "未找到任务或配置文件。请检查配置文件、区域和还原任务 ID。"

#: errors.js:40
#, javascript-format
msgid ""
"The secure connection could not be verified. Check your certificates and "
"network configuration."
msgstr "无法验证安全连接。请检查证书和网络配置。"

#: errors.js:42
#, javascript-format
msgid ""
"Could not start AWS CLI. Check that it is installed and that the executable "
"path and permissions are correct."
msgstr "无法启动 AWS CLI。请确认已安装 AWS CLI，且可执行文件的路径和权限正确。"

#: errors.js:44
#, javascript-format
msgid ""
"The AWS CLI configuration or arguments are invalid. Check the applet "
"settings."
msgstr "AWS CLI 配置或参数无效。请检查小程序设置。"

#: errors.js:46
#, javascript-format
msgid ""
"AWS is throttling requests. The query will be retried after a longer delay."
msgstr "AWS 正在限制请求频率。将延长等待时间后重试。"

#: errors.js:48
#, javascript-format
msgid ""
"AWS is unavailable or there is a network problem. The query will be retried "
"automatically."
msgstr "AWS 不可用或网络出现问题，将自动重试查询。"

#: errors.js:50
#, javascript-format
msgid ""
"Communication with AWS CLI was interrupted. The query will be retried "
"automatically."
msgstr "与 AWS CLI 的通信已中断，将自动重试查询。"

#: errors.js:51
#, javascript-format
msgid ""
"AWS CLI exited with an unrecognized error. Check the query in your terminal "
"and click Refresh now."
msgstr "AWS CLI 因未知错误退出。请在终端中检查查询，然后单击“立即刷新”。"

#: settings-schema.json
#, javascript-format
msgid "Restore job"
msgstr "还原任务"

#: settings-schema.json
#, javascript-format
msgid "AWS profile (PROFILE)"
msgstr "AWS 配置文件（PROFILE）"

#: settings-schema.json
#, javascript-format
msgid "Region (REGION)"
msgstr "区域（REGION）"

#: settings-schema.json
#, javascript-format
msgid "Restore job ID (RESTORE_JOB_ID)"
msgstr "还原任务 ID（RESTORE_JOB_ID）"

#: settings-schema.json
#, javascript-format
msgid "seconds"
msgstr "秒"

#: settings-schema.json
#, javascript-format
msgid "Polling interval"
msgstr "查询间隔"

#: settings-schema.json
#, javascript-format
msgid "AWS CLI executable"
msgstr "AWS CLI 可执行文件"

#: settings-schema.json
#, javascript-format
msgid ""
"Use aws or the absolute path returned by command -v aws in your terminal."
msgstr "请使用 aws，或在终端中运行 command -v aws 后得到的绝对路径。"

#: metadata.json
#, javascript-format
msgid ""
"Monitor the status and progress of cold storage restores through AWS Backup."
msgstr "通过 AWS Backup 监控冷存储还原任务的状态和进度。"

#: metadata.json
#, javascript-format
msgid "AWS Cold Restore Monitor"
msgstr "AWS Cold Restore Monitor"
