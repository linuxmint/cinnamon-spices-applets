#: applet.js:62
#, javascript-format
msgid "AWS · Configure"
msgstr "AWS · Konfiguruj"

#: applet.js:90
#, javascript-format
msgid "Refresh now"
msgstr "Odśwież teraz"

#: applet.js:91
#, javascript-format
msgid "Configure…"
msgstr "Konfiguruj…"

#: applet.js:180
#, javascript-format
msgid "Could not send the system notification."
msgstr "Nie udało się wysłać powiadomienia systemowego."

#: applet.js:197
#, javascript-format
msgid "AWS · Internal error"
msgstr "AWS · Błąd wewnętrzny"

#: applet.js:210
#, javascript-format
msgid "no percentage"
msgstr "brak wartości procentowej"

#: applet.js:214
#, javascript-format
msgid "AWS · Error"
msgstr "AWS · Błąd"

#: applet.js:214
#, javascript-format
msgid "AWS · Retrying"
msgstr "AWS · Ponawianie"

#: applet.js:214
#, javascript-format
msgid "AWS %s"
msgstr "AWS %s"

#: applet.js:214
#, javascript-format
msgid "AWS · %s"
msgstr "AWS · %s"

#: applet.js:218
#, javascript-format
msgid "AWS Cold Restore Monitor: %s"
msgstr "AWS Cold Restore Monitor: %s"

#: applet.js:219
#, javascript-format
msgid "%s · %s"
msgstr "%s · %s"

#: applet.js:220
#, javascript-format
msgid "Right-click and choose Configure to select a restore job."
msgstr "Kliknij prawym przyciskiem myszy i wybierz „Konfiguruj”, aby wybrać zadanie przywracania."

#: applet.js:223
#, javascript-format
msgid ""
"Automatic queries are paused. Fix the problem and click Refresh now or "
"change the settings."
msgstr "Automatyczne zapytania są wstrzymane. Rozwiąż problem i kliknij „Odśwież teraz” lub zmień ustawienia."

#: applet.js:224
#, javascript-format
msgid "AWS: %s"
msgstr "AWS: %s"

#: applet.js:226
#, javascript-format
msgid "Status: %s (previous result; query pending)"
msgstr "Stan: %s (poprzedni wynik; oczekiwanie na zapytanie)"

#: applet.js:226
#, javascript-format
msgid "Status: %s"
msgstr "Stan: %s"

#: applet.js:227
#, javascript-format
msgid "Estimated progress: %s"
msgstr "Szacowany postęp: %s"

#: applet.js:228
#, javascript-format
msgid "Job: %s"
msgstr "Zadanie: %s"

#: applet.js:228
#, javascript-format
msgid "not configured"
msgstr "nie skonfigurowano"

#: applet.js:229
#, javascript-format
msgid "Profile: %s · Region: %s"
msgstr "Profil: %s · Region: %s"

#: applet.js:230
#, javascript-format
msgid "Started: %s"
msgstr "Rozpoczęcie: %s"

#: applet.js:231
#, javascript-format
msgid "Completed: %s"
msgstr "Zakończenie: %s"

#: applet.js:232
#, javascript-format
msgid "Last successful query: %s"
msgstr "Ostatnie udane zapytanie: %s"

#: applet.js:273
#, javascript-format
msgid "Configure"
msgstr "Konfiguruj"

#: applet.js:274
#, javascript-format
msgid ""
"Enter the profile, region, restore job ID, and AWS CLI path in Configure."
msgstr "W oknie „Konfiguruj” podaj profil, region, identyfikator zadania przywracania i ścieżkę do AWS CLI."

#: applet.js:278
#, javascript-format
msgid "The interval must be between 10 and 3600 seconds. Check the settings."
msgstr "Odstęp musi wynosić od 10 do 3600 sekund. Sprawdź ustawienia."

#: applet.js:281
#, javascript-format
msgid "Querying…"
msgstr "Wysyłanie zapytania…"

#: applet.js:339
#, javascript-format
msgid "AWS reports that the restore failed. Review the job in AWS Backup."
msgstr "AWS zgłasza, że przywracanie nie powiodło się. Sprawdź zadanie w AWS Backup."

#: applet.js:339
#, javascript-format
msgid "AWS reports that the restore was aborted. Review the job in AWS Backup."
msgstr "AWS zgłasza, że przywracanie zostało przerwane. Sprawdź zadanie w AWS Backup."

#: applet.js:343
#, javascript-format
msgid "Query successful"
msgstr "Zapytanie zakończone pomyślnie"

#: applet.js:345
#, javascript-format
msgid ""
"AWS has not reported a valid percentage. The job status is still available."
msgstr "AWS nie podał prawidłowej wartości procentowej. Stan zadania jest nadal dostępny."

#: applet.js:348
#, javascript-format
msgid ""
"The query succeeded, but AWS CLI issued a warning. Run the query in your "
"terminal to review it."
msgstr "Zapytanie zakończyło się pomyślnie, ale AWS CLI zgłosił ostrzeżenie. Uruchom zapytanie w terminalu, aby je wyświetlić."

#: applet.js:380
#, javascript-format
msgid "Could not load the applet. Check the installation and add it again."
msgstr "Nie udało się załadować apletu. Sprawdź instalację i dodaj go ponownie."

#: errors.js:28
#, javascript-format
msgid "The query exceeded 60 seconds. It will be retried automatically."
msgstr "Zapytanie przekroczyło limit 60 sekund. Zostanie automatycznie ponowione."

#: errors.js:30
#, javascript-format
msgid ""
"The monitor encountered an internal error. Remove the applet and add it "
"again."
msgstr "W monitorze wystąpił błąd wewnętrzny. Usuń aplet z panelu i dodaj go ponownie."

#: errors.js:32
#, javascript-format
msgid ""
"AWS returned an invalid response. Check the query with AWS CLI and click "
"Refresh now."
msgstr "AWS zwrócił nieprawidłową odpowiedź. Sprawdź zapytanie za pomocą AWS CLI i kliknij „Odśwież teraz”."

#: errors.js:34
#, javascript-format
msgid ""
"Could not authenticate with AWS. Check your credentials or renew your SSO "
"session, then click Refresh now."
msgstr "Nie udało się uwierzytelnić w AWS. Sprawdź dane uwierzytelniające lub odnów sesję SSO, a następnie kliknij „Odśwież teraz”."

#: errors.js:36
#, javascript-format
msgid ""
"AWS denied access. Check the backup:DescribeRestoreJob permission for this "
"profile."
msgstr "AWS odmówił dostępu. Sprawdź uprawnienie backup:DescribeRestoreJob dla tego profilu."

#: errors.js:38
#, javascript-format
msgid ""
"The job or profile was not found. Check the profile, region, and restore job "
"ID."
msgstr "Nie znaleziono zadania lub profilu. Sprawdź profil, region i identyfikator zadania przywracania."

#: errors.js:40
#, javascript-format
msgid ""
"The secure connection could not be verified. Check your certificates and "
"network configuration."
msgstr "Nie udało się zweryfikować bezpiecznego połączenia. Sprawdź certyfikaty i konfigurację sieci."

#: errors.js:42
#, javascript-format
msgid ""
"Could not start AWS CLI. Check that it is installed and that the executable "
"path and permissions are correct."
msgstr "Nie udało się uruchomić AWS CLI. Sprawdź, czy jest zainstalowany oraz czy ścieżka i uprawnienia pliku wykonywalnego są prawidłowe."

#: errors.js:44
#, javascript-format
msgid ""
"The AWS CLI configuration or arguments are invalid. Check the applet "
"settings."
msgstr "Konfiguracja lub argumenty AWS CLI są nieprawidłowe. Sprawdź ustawienia apletu."

#: errors.js:46
#, javascript-format
msgid ""
"AWS is throttling requests. The query will be retried after a longer delay."
msgstr "AWS ogranicza częstotliwość żądań. Zapytanie zostanie ponowione po dłuższej przerwie."

#: errors.js:48
#, javascript-format
msgid ""
"AWS is unavailable or there is a network problem. The query will be retried "
"automatically."
msgstr "AWS jest niedostępny lub wystąpił problem z siecią. Zapytanie zostanie automatycznie ponowione."

#: errors.js:50
#, javascript-format
msgid ""
"Communication with AWS CLI was interrupted. The query will be retried "
"automatically."
msgstr "Komunikacja z AWS CLI została przerwana. Zapytanie zostanie automatycznie ponowione."

#: errors.js:51
#, javascript-format
msgid ""
"AWS CLI exited with an unrecognized error. Check the query in your terminal "
"and click Refresh now."
msgstr "AWS CLI zakończył działanie z nierozpoznanym błędem. Sprawdź zapytanie w terminalu i kliknij „Odśwież teraz”."

#: settings-schema.json
#, javascript-format
msgid "Restore job"
msgstr "Zadanie przywracania"

#: settings-schema.json
#, javascript-format
msgid "AWS profile (PROFILE)"
msgstr "Profil AWS (PROFILE)"

#: settings-schema.json
#, javascript-format
msgid "Region (REGION)"
msgstr "Region (REGION)"

#: settings-schema.json
#, javascript-format
msgid "Restore job ID (RESTORE_JOB_ID)"
msgstr "Identyfikator zadania przywracania (RESTORE_JOB_ID)"

#: settings-schema.json
#, javascript-format
msgid "seconds"
msgstr "sekund"

#: settings-schema.json
#, javascript-format
msgid "Polling interval"
msgstr "Odstęp między zapytaniami"

#: settings-schema.json
#, javascript-format
msgid "AWS CLI executable"
msgstr "Plik wykonywalny AWS CLI"

#: settings-schema.json
#, javascript-format
msgid ""
"Use aws or the absolute path returned by command -v aws in your terminal."
msgstr "Użyj aws lub ścieżki bezwzględnej zwróconej przez command -v aws w terminalu."

#: metadata.json
#, javascript-format
msgid ""
"Monitor the status and progress of cold storage restores through AWS Backup."
msgstr "Monitoruj stan i postęp przywracania danych z zimnej pamięci masowej za pomocą AWS Backup."

#: metadata.json
#, javascript-format
msgid "AWS Cold Restore Monitor"
msgstr "AWS Cold Restore Monitor"
