#: applet.js:62
#, javascript-format
msgid "AWS · Configure"
msgstr "AWS · Configurer"

#: applet.js:90
#, javascript-format
msgid "Refresh now"
msgstr "Actualiser maintenant"

#: applet.js:91
#, javascript-format
msgid "Configure…"
msgstr "Configurer…"

#: applet.js:180
#, javascript-format
msgid "Could not send the system notification."
msgstr "Impossible d’envoyer la notification système."

#: applet.js:197
#, javascript-format
msgid "AWS · Internal error"
msgstr "AWS · Erreur interne"

#: applet.js:210
#, javascript-format
msgid "no percentage"
msgstr "pourcentage indisponible"

#: applet.js:214
#, javascript-format
msgid "AWS · Error"
msgstr "AWS · Erreur"

#: applet.js:214
#, javascript-format
msgid "AWS · Retrying"
msgstr "AWS · Nouvelle tentative"

#: applet.js:214
#, javascript-format
msgid "AWS %s"
msgstr "AWS %s"

#: applet.js:214
#, javascript-format
msgid "AWS · %s"
msgstr "AWS · %s"

#: applet.js:218
#, javascript-format
msgid "AWS Cold Restore Monitor: %s"
msgstr "AWS Cold Restore Monitor : %s"

#: applet.js:219
#, javascript-format
msgid "%s · %s"
msgstr "%s · %s"

#: applet.js:220
#, javascript-format
msgid "Right-click and choose Configure to select a restore job."
msgstr "Faites un clic droit et choisissez Configurer pour sélectionner une tâche de restauration."

#: applet.js:223
#, javascript-format
msgid ""
"Automatic queries are paused. Fix the problem and click Refresh now or "
"change the settings."
msgstr "Les requêtes automatiques sont suspendues. Corrigez le problème, puis cliquez sur Actualiser maintenant ou modifiez les paramètres."

#: applet.js:224
#, javascript-format
msgid "AWS: %s"
msgstr "AWS : %s"

#: applet.js:226
#, javascript-format
msgid "Status: %s (previous result; query pending)"
msgstr "État : %s (résultat précédent ; requête en attente)"

#: applet.js:226
#, javascript-format
msgid "Status: %s"
msgstr "État : %s"

#: applet.js:227
#, javascript-format
msgid "Estimated progress: %s"
msgstr "Progression estimée : %s"

#: applet.js:228
#, javascript-format
msgid "Job: %s"
msgstr "Tâche : %s"

#: applet.js:228
#, javascript-format
msgid "not configured"
msgstr "non configuré"

#: applet.js:229
#, javascript-format
msgid "Profile: %s · Region: %s"
msgstr "Profil : %s · Région : %s"

#: applet.js:230
#, javascript-format
msgid "Started: %s"
msgstr "Début : %s"

#: applet.js:231
#, javascript-format
msgid "Completed: %s"
msgstr "Fin : %s"

#: applet.js:232
#, javascript-format
msgid "Last successful query: %s"
msgstr "Dernière requête réussie : %s"

#: applet.js:273
#, javascript-format
msgid "Configure"
msgstr "Configurer"

#: applet.js:274
#, javascript-format
msgid ""
"Enter the profile, region, restore job ID, and AWS CLI path in Configure."
msgstr "Dans Configurer, renseignez le profil, la région, l’identifiant de la tâche de restauration et le chemin d’AWS CLI."

#: applet.js:278
#, javascript-format
msgid "The interval must be between 10 and 3600 seconds. Check the settings."
msgstr "L’intervalle doit être compris entre 10 et 3600 secondes. Vérifiez les paramètres."

#: applet.js:281
#, javascript-format
msgid "Querying…"
msgstr "Requête en cours…"

#: applet.js:339
#, javascript-format
msgid "AWS reports that the restore failed. Review the job in AWS Backup."
msgstr "AWS indique que la restauration a échoué. Examinez la tâche dans AWS Backup."

#: applet.js:339
#, javascript-format
msgid "AWS reports that the restore was aborted. Review the job in AWS Backup."
msgstr "AWS indique que la restauration a été interrompue. Examinez la tâche dans AWS Backup."

#: applet.js:343
#, javascript-format
msgid "Query successful"
msgstr "Requête réussie"

#: applet.js:345
#, javascript-format
msgid ""
"AWS has not reported a valid percentage. The job status is still available."
msgstr "AWS n’a pas fourni de pourcentage valide. L’état de la tâche reste disponible."

#: applet.js:348
#, javascript-format
msgid ""
"The query succeeded, but AWS CLI issued a warning. Run the query in your "
"terminal to review it."
msgstr "La requête a réussi, mais AWS CLI a émis un avertissement. Exécutez la requête dans votre terminal pour le consulter."

#: applet.js:380
#, javascript-format
msgid "Could not load the applet. Check the installation and add it again."
msgstr "Impossible de charger l’applet. Vérifiez l’installation et ajoutez à nouveau l’applet."

#: errors.js:28
#, javascript-format
msgid "The query exceeded 60 seconds. It will be retried automatically."
msgstr "La requête a dépassé 60 secondes. Une nouvelle tentative sera effectuée automatiquement."

#: errors.js:30
#, javascript-format
msgid ""
"The monitor encountered an internal error. Remove the applet and add it "
"again."
msgstr "Le moniteur a rencontré une erreur interne. Retirez l’applet, puis ajoutez-le à nouveau."

#: errors.js:32
#, javascript-format
msgid ""
"AWS returned an invalid response. Check the query with AWS CLI and click "
"Refresh now."
msgstr "AWS a renvoyé une réponse invalide. Vérifiez la requête avec AWS CLI, puis cliquez sur Actualiser maintenant."

#: errors.js:34
#, javascript-format
msgid ""
"Could not authenticate with AWS. Check your credentials or renew your SSO "
"session, then click Refresh now."
msgstr "Impossible de s’authentifier auprès d’AWS. Vérifiez vos identifiants ou renouvelez votre session SSO, puis cliquez sur Actualiser maintenant."

#: errors.js:36
#, javascript-format
msgid ""
"AWS denied access. Check the backup:DescribeRestoreJob permission for this "
"profile."
msgstr "AWS a refusé l’accès. Vérifiez l’autorisation backup:DescribeRestoreJob pour ce profil."

#: errors.js:38
#, javascript-format
msgid ""
"The job or profile was not found. Check the profile, region, and restore job "
"ID."
msgstr "La tâche ou le profil est introuvable. Vérifiez le profil, la région et l’identifiant de la tâche de restauration."

#: errors.js:40
#, javascript-format
msgid ""
"The secure connection could not be verified. Check your certificates and "
"network configuration."
msgstr "Impossible de vérifier la connexion sécurisée. Vérifiez vos certificats et votre configuration réseau."

#: errors.js:42
#, javascript-format
msgid ""
"Could not start AWS CLI. Check that it is installed and that the executable "
"path and permissions are correct."
msgstr "Impossible de démarrer AWS CLI. Vérifiez qu’il est installé et que le chemin et les permissions de l’exécutable sont corrects."

#: errors.js:44
#, javascript-format
msgid ""
"The AWS CLI configuration or arguments are invalid. Check the applet "
"settings."
msgstr "La configuration ou les arguments d’AWS CLI sont invalides. Vérifiez les paramètres de l’applet."

#: errors.js:46
#, javascript-format
msgid ""
"AWS is throttling requests. The query will be retried after a longer delay."
msgstr "AWS limite la fréquence des requêtes. Une nouvelle tentative sera effectuée après un délai plus long."

#: errors.js:48
#, javascript-format
msgid ""
"AWS is unavailable or there is a network problem. The query will be retried "
"automatically."
msgstr "AWS est indisponible ou un problème réseau est survenu. Une nouvelle tentative sera effectuée automatiquement."

#: errors.js:50
#, javascript-format
msgid ""
"Communication with AWS CLI was interrupted. The query will be retried "
"automatically."
msgstr "La communication avec AWS CLI a été interrompue. Une nouvelle tentative sera effectuée automatiquement."

#: errors.js:51
#, javascript-format
msgid ""
"AWS CLI exited with an unrecognized error. Check the query in your terminal "
"and click Refresh now."
msgstr "AWS CLI s’est terminé avec une erreur non reconnue. Vérifiez la requête dans votre terminal, puis cliquez sur Actualiser maintenant."

#: settings-schema.json
#, javascript-format
msgid "Restore job"
msgstr "Tâche de restauration"

#: settings-schema.json
#, javascript-format
msgid "AWS profile (PROFILE)"
msgstr "Profil AWS (PROFILE)"

#: settings-schema.json
#, javascript-format
msgid "Region (REGION)"
msgstr "Région (REGION)"

#: settings-schema.json
#, javascript-format
msgid "Restore job ID (RESTORE_JOB_ID)"
msgstr "Identifiant de la tâche de restauration (RESTORE_JOB_ID)"

#: settings-schema.json
#, javascript-format
msgid "seconds"
msgstr "secondes"

#: settings-schema.json
#, javascript-format
msgid "Polling interval"
msgstr "Intervalle des requêtes"

#: settings-schema.json
#, javascript-format
msgid "AWS CLI executable"
msgstr "Exécutable AWS CLI"

#: settings-schema.json
#, javascript-format
msgid ""
"Use aws or the absolute path returned by command -v aws in your terminal."
msgstr "Utilisez aws ou le chemin absolu renvoyé par command -v aws dans votre terminal."

#: metadata.json
#, javascript-format
msgid ""
"Monitor the status and progress of cold storage restores through AWS Backup."
msgstr "Suivez l’état et la progression des restaurations depuis le stockage à froid avec AWS Backup."

#: metadata.json
#, javascript-format
msgid "AWS Cold Restore Monitor"
msgstr "AWS Cold Restore Monitor"
