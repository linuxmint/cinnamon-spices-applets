#: applet.js:62
#, javascript-format
msgid "AWS · Configure"
msgstr "AWS · 設定"

#: applet.js:90
#, javascript-format
msgid "Refresh now"
msgstr "今すぐ更新"

#: applet.js:91
#, javascript-format
msgid "Configure…"
msgstr "設定…"

#: applet.js:180
#, javascript-format
msgid "Could not send the system notification."
msgstr "システム通知を送信できませんでした。"

#: applet.js:197
#, javascript-format
msgid "AWS · Internal error"
msgstr "AWS · 内部エラー"

#: applet.js:210
#, javascript-format
msgid "no percentage"
msgstr "進捗率不明"

#: applet.js:214
#, javascript-format
msgid "AWS · Error"
msgstr "AWS · エラー"

#: applet.js:214
#, javascript-format
msgid "AWS · Retrying"
msgstr "AWS · 再試行中"

#: applet.js:214
#, javascript-format
msgid "AWS %s"
msgstr "AWS %s"

#: applet.js:214
#, javascript-format
msgid "AWS · %s"
msgstr "AWS · %s"

#: applet.js:218
#, javascript-format
msgid "AWS Cold Restore Monitor: %s"
msgstr "AWS Cold Restore Monitor: %s"

#: applet.js:219
#, javascript-format
msgid "%s · %s"
msgstr "%s · %s"

#: applet.js:220
#, javascript-format
msgid "Right-click and choose Configure to select a restore job."
msgstr "右クリックして「設定」を選び、復元ジョブを選択してください。"

#: applet.js:223
#, javascript-format
msgid ""
"Automatic queries are paused. Fix the problem and click Refresh now or "
"change the settings."
msgstr "自動問い合わせは一時停止中です。問題を解決して「今すぐ更新」をクリックするか、設定を変更してください。"

#: applet.js:224
#, javascript-format
msgid "AWS: %s"
msgstr "AWS: %s"

#: applet.js:226
#, javascript-format
msgid "Status: %s (previous result; query pending)"
msgstr "状態: %s（前回の結果・問い合わせ待ち）"

#: applet.js:226
#, javascript-format
msgid "Status: %s"
msgstr "状態: %s"

#: applet.js:227
#, javascript-format
msgid "Estimated progress: %s"
msgstr "推定進捗率: %s"

#: applet.js:228
#, javascript-format
msgid "Job: %s"
msgstr "ジョブ: %s"

#: applet.js:228
#, javascript-format
msgid "not configured"
msgstr "未設定"

#: applet.js:229
#, javascript-format
msgid "Profile: %s · Region: %s"
msgstr "プロファイル: %s · リージョン: %s"

#: applet.js:230
#, javascript-format
msgid "Started: %s"
msgstr "開始日時: %s"

#: applet.js:231
#, javascript-format
msgid "Completed: %s"
msgstr "完了日時: %s"

#: applet.js:232
#, javascript-format
msgid "Last successful query: %s"
msgstr "最終問い合わせ成功日時: %s"

#: applet.js:273
#, javascript-format
msgid "Configure"
msgstr "設定"

#: applet.js:274
#, javascript-format
msgid ""
"Enter the profile, region, restore job ID, and AWS CLI path in Configure."
msgstr "「設定」でプロファイル、リージョン、復元ジョブ ID、AWS CLI のパスを入力してください。"

#: applet.js:278
#, javascript-format
msgid "The interval must be between 10 and 3600 seconds. Check the settings."
msgstr "間隔は 10～3600 秒の範囲で指定してください。設定を確認してください。"

#: applet.js:281
#, javascript-format
msgid "Querying…"
msgstr "問い合わせ中…"

#: applet.js:339
#, javascript-format
msgid "AWS reports that the restore failed. Review the job in AWS Backup."
msgstr "AWS から復元の失敗が報告されました。AWS Backup でジョブを確認してください。"

#: applet.js:339
#, javascript-format
msgid "AWS reports that the restore was aborted. Review the job in AWS Backup."
msgstr "AWS から復元の中止が報告されました。AWS Backup でジョブを確認してください。"

#: applet.js:343
#, javascript-format
msgid "Query successful"
msgstr "問い合わせ成功"

#: applet.js:345
#, javascript-format
msgid ""
"AWS has not reported a valid percentage. The job status is still available."
msgstr "AWS から有効な進捗率が返されていません。ジョブの状態は引き続き確認できます。"

#: applet.js:348
#, javascript-format
msgid ""
"The query succeeded, but AWS CLI issued a warning. Run the query in your "
"terminal to review it."
msgstr "問い合わせは成功しましたが、AWS CLI が警告を出力しました。内容を確認するには、端末で問い合わせを実行してください。"

#: applet.js:380
#, javascript-format
msgid "Could not load the applet. Check the installation and add it again."
msgstr "アプレットを読み込めませんでした。インストール状態を確認し、再度追加してください。"

#: errors.js:28
#, javascript-format
msgid "The query exceeded 60 seconds. It will be retried automatically."
msgstr "問い合わせに 60 秒以上かかりました。自動的に再試行します。"

#: errors.js:30
#, javascript-format
msgid ""
"The monitor encountered an internal error. Remove the applet and add it "
"again."
msgstr "モニターで内部エラーが発生しました。アプレットを削除してから再度追加してください。"

#: errors.js:32
#, javascript-format
msgid ""
"AWS returned an invalid response. Check the query with AWS CLI and click "
"Refresh now."
msgstr "AWS から無効な応答が返されました。AWS CLI で問い合わせを確認し、「今すぐ更新」をクリックしてください。"

#: errors.js:34
#, javascript-format
msgid ""
"Could not authenticate with AWS. Check your credentials or renew your SSO "
"session, then click Refresh now."
msgstr "AWS で認証できませんでした。認証情報を確認するか SSO セッションを更新してから、「今すぐ更新」をクリックしてください。"

#: errors.js:36
#, javascript-format
msgid ""
"AWS denied access. Check the backup:DescribeRestoreJob permission for this "
"profile."
msgstr "AWS によってアクセスが拒否されました。このプロファイルの backup:DescribeRestoreJob 権限を確認してください。"

#: errors.js:38
#, javascript-format
msgid ""
"The job or profile was not found. Check the profile, region, and restore job "
"ID."
msgstr "ジョブまたはプロファイルが見つかりませんでした。プロファイル、リージョン、復元ジョブ ID を確認してください。"

#: errors.js:40
#, javascript-format
msgid ""
"The secure connection could not be verified. Check your certificates and "
"network configuration."
msgstr "安全な接続を検証できませんでした。証明書とネットワーク設定を確認してください。"

#: errors.js:42
#, javascript-format
msgid ""
"Could not start AWS CLI. Check that it is installed and that the executable "
"path and permissions are correct."
msgstr "AWS CLI を起動できませんでした。インストールされていること、および実行ファイルのパスと権限が正しいことを確認してください。"

#: errors.js:44
#, javascript-format
msgid ""
"The AWS CLI configuration or arguments are invalid. Check the applet "
"settings."
msgstr "AWS CLI の設定または引数が無効です。アプレットの設定を確認してください。"

#: errors.js:46
#, javascript-format
msgid ""
"AWS is throttling requests. The query will be retried after a longer delay."
msgstr "AWS がリクエストの頻度を制限しています。待機時間を延ばしてから再試行します。"

#: errors.js:48
#, javascript-format
msgid ""
"AWS is unavailable or there is a network problem. The query will be retried "
"automatically."
msgstr "AWS が利用できないか、ネットワークに問題があります。自動的に再試行します。"

#: errors.js:50
#, javascript-format
msgid ""
"Communication with AWS CLI was interrupted. The query will be retried "
"automatically."
msgstr "AWS CLI との通信が中断されました。自動的に再試行します。"

#: errors.js:51
#, javascript-format
msgid ""
"AWS CLI exited with an unrecognized error. Check the query in your terminal "
"and click Refresh now."
msgstr "AWS CLI が不明なエラーで終了しました。端末で問い合わせを確認し、「今すぐ更新」をクリックしてください。"

#: settings-schema.json
#, javascript-format
msgid "Restore job"
msgstr "復元ジョブ"

#: settings-schema.json
#, javascript-format
msgid "AWS profile (PROFILE)"
msgstr "AWS プロファイル（PROFILE）"

#: settings-schema.json
#, javascript-format
msgid "Region (REGION)"
msgstr "リージョン（REGION）"

#: settings-schema.json
#, javascript-format
msgid "Restore job ID (RESTORE_JOB_ID)"
msgstr "復元ジョブ ID（RESTORE_JOB_ID）"

#: settings-schema.json
#, javascript-format
msgid "seconds"
msgstr "秒"

#: settings-schema.json
#, javascript-format
msgid "Polling interval"
msgstr "問い合わせ間隔"

#: settings-schema.json
#, javascript-format
msgid "AWS CLI executable"
msgstr "AWS CLI 実行ファイル"

#: settings-schema.json
#, javascript-format
msgid ""
"Use aws or the absolute path returned by command -v aws in your terminal."
msgstr "aws、または端末で command -v aws を実行して得られる絶対パスを指定してください。"

#: metadata.json
#, javascript-format
msgid ""
"Monitor the status and progress of cold storage restores through AWS Backup."
msgstr "AWS Backup によるコールドストレージからの復元の状態と進捗を監視します。"

#: metadata.json
#, javascript-format
msgid "AWS Cold Restore Monitor"
msgstr "AWS Cold Restore Monitor"
