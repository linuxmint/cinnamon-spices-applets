#: applet.js:62
#, javascript-format
msgid "AWS · Configure"
msgstr "AWS · Configurar"

#: applet.js:90
#, javascript-format
msgid "Refresh now"
msgstr "Actualizar ahora"

#: applet.js:91
#, javascript-format
msgid "Configure…"
msgstr "Configurar…"

#: applet.js:180
#, javascript-format
msgid "Could not send the system notification."
msgstr "No se pudo emitir la notificación del sistema."

#: applet.js:197
#, javascript-format
msgid "AWS · Internal error"
msgstr "AWS · Error interno"

#: applet.js:210
#, javascript-format
msgid "no percentage"
msgstr "sin porcentaje"

#: applet.js:214
#, javascript-format
msgid "AWS · Error"
msgstr "AWS · Error"

#: applet.js:214
#, javascript-format
msgid "AWS · Retrying"
msgstr "AWS · Reintentando"

#: applet.js:214
#, javascript-format
msgid "AWS %s"
msgstr "AWS %s"

#: applet.js:214
#, javascript-format
msgid "AWS · %s"
msgstr "AWS · %s"

#: applet.js:218
#, javascript-format
msgid "AWS Cold Restore Monitor: %s"
msgstr "AWS Cold Restore Monitor: %s"

#: applet.js:219
#, javascript-format
msgid "%s · %s"
msgstr "%s · %s"

#: applet.js:220
#, javascript-format
msgid "Right-click and choose Configure to select a restore job."
msgstr "Haz clic derecho y elige Configurar para seleccionar un trabajo de restauración."

#: applet.js:223
#, javascript-format
msgid ""
"Automatic queries are paused. Fix the problem and click Refresh now or "
"change the settings."
msgstr "Las consultas automáticas están pausadas. Corrige el problema y pulsa Actualizar ahora o cambia la configuración."

#: applet.js:224
#, javascript-format
msgid "AWS: %s"
msgstr "AWS: %s"

#: applet.js:226
#, javascript-format
msgid "Status: %s (previous result; query pending)"
msgstr "Estado: %s (último dato; consulta pendiente)"

#: applet.js:226
#, javascript-format
msgid "Status: %s"
msgstr "Estado: %s"

#: applet.js:227
#, javascript-format
msgid "Estimated progress: %s"
msgstr "Avance estimado: %s"

#: applet.js:228
#, javascript-format
msgid "Job: %s"
msgstr "Trabajo: %s"

#: applet.js:228
#, javascript-format
msgid "not configured"
msgstr "sin configurar"

#: applet.js:229
#, javascript-format
msgid "Profile: %s · Region: %s"
msgstr "Perfil: %s · Región: %s"

#: applet.js:230
#, javascript-format
msgid "Started: %s"
msgstr "Inicio: %s"

#: applet.js:231
#, javascript-format
msgid "Completed: %s"
msgstr "Finalización: %s"

#: applet.js:232
#, javascript-format
msgid "Last successful query: %s"
msgstr "Última consulta correcta: %s"

#: applet.js:273
#, javascript-format
msgid "Configure"
msgstr "Configurar"

#: applet.js:274
#, javascript-format
msgid ""
"Enter the profile, region, restore job ID, and AWS CLI path in Configure."
msgstr "Completa el perfil, la región, el ID de restauración y la ruta de AWS CLI en Configurar."

#: applet.js:278
#, javascript-format
msgid "The interval must be between 10 and 3600 seconds. Check the settings."
msgstr "El intervalo debe estar entre 10 y 3600 segundos. Revisa la configuración."

#: applet.js:281
#, javascript-format
msgid "Querying…"
msgstr "Consultando…"

#: applet.js:339
#, javascript-format
msgid "AWS reports that the restore failed. Review the job in AWS Backup."
msgstr "AWS informa que la restauración falló. Revisa el trabajo en AWS Backup."

#: applet.js:339
#, javascript-format
msgid "AWS reports that the restore was aborted. Review the job in AWS Backup."
msgstr "AWS informa que la restauración fue abortada. Revisa el trabajo en AWS Backup."

#: applet.js:343
#, javascript-format
msgid "Query successful"
msgstr "Consulta correcta"

#: applet.js:345
#, javascript-format
msgid ""
"AWS has not reported a valid percentage. The job status is still available."
msgstr "AWS no ha informado un porcentaje válido. El estado del trabajo sigue disponible."

#: applet.js:348
#, javascript-format
msgid ""
"The query succeeded, but AWS CLI issued a warning. Run the query in your "
"terminal to review it."
msgstr "La consulta terminó correctamente, pero AWS CLI emitió una advertencia. Puedes revisarla ejecutando la consulta en tu terminal."

#: applet.js:380
#, javascript-format
msgid "Could not load the applet. Check the installation and add it again."
msgstr "No se pudo cargar el applet. Revisa la instalación y vuelve a añadirlo."

#: errors.js:28
#, javascript-format
msgid "The query exceeded 60 seconds. It will be retried automatically."
msgstr "La consulta superó los 60 segundos. Se reintentará automáticamente."

#: errors.js:30
#, javascript-format
msgid ""
"The monitor encountered an internal error. Remove the applet and add it "
"again."
msgstr "El monitor encontró un error interno. Retira y vuelve a añadir el applet."

#: errors.js:32
#, javascript-format
msgid ""
"AWS returned an invalid response. Check the query with AWS CLI and click "
"Refresh now."
msgstr "AWS devolvió una respuesta no válida. Comprueba la consulta con AWS CLI y pulsa Actualizar ahora."

#: errors.js:34
#, javascript-format
msgid ""
"Could not authenticate with AWS. Check your credentials or renew your SSO "
"session, then click Refresh now."
msgstr "No se pudo autenticar con AWS. Revisa las credenciales o renueva la sesión SSO y pulsa Actualizar ahora."

#: errors.js:36
#, javascript-format
msgid ""
"AWS denied access. Check the backup:DescribeRestoreJob permission for this "
"profile."
msgstr "AWS denegó el acceso. Revisa el permiso backup:DescribeRestoreJob del perfil."

#: errors.js:38
#, javascript-format
msgid ""
"The job or profile was not found. Check the profile, region, and restore job "
"ID."
msgstr "No se encontró el trabajo o el perfil. Comprueba el perfil, la región y el ID de restauración."

#: errors.js:40
#, javascript-format
msgid ""
"The secure connection could not be verified. Check your certificates and "
"network configuration."
msgstr "No se pudo verificar la conexión segura. Revisa los certificados y la configuración de red."

#: errors.js:42
#, javascript-format
msgid ""
"Could not start AWS CLI. Check that it is installed and that the executable "
"path and permissions are correct."
msgstr "No se pudo iniciar AWS CLI. Comprueba que esté instalado y que la ruta del ejecutable y sus permisos sean correctos."

#: errors.js:44
#, javascript-format
msgid ""
"The AWS CLI configuration or arguments are invalid. Check the applet "
"settings."
msgstr "La configuración o los argumentos de AWS CLI no son válidos. Revisa los ajustes del applet."

#: errors.js:46
#, javascript-format
msgid ""
"AWS is throttling requests. The query will be retried after a longer delay."
msgstr "AWS está limitando las consultas. Se reintentará con una espera mayor."

#: errors.js:48
#, javascript-format
msgid ""
"AWS is unavailable or there is a network problem. The query will be retried "
"automatically."
msgstr "AWS no está disponible o hay un problema de red. Se reintentará automáticamente."

#: errors.js:50
#, javascript-format
msgid ""
"Communication with AWS CLI was interrupted. The query will be retried "
"automatically."
msgstr "La comunicación con AWS CLI se interrumpió. Se reintentará automáticamente."

#: errors.js:51
#, javascript-format
msgid ""
"AWS CLI exited with an unrecognized error. Check the query in your terminal "
"and click Refresh now."
msgstr "AWS CLI terminó con un error no reconocido. Revisa la consulta en tu terminal y pulsa Actualizar ahora."

#: settings-schema.json
#, javascript-format
msgid "Restore job"
msgstr "Trabajo de restauración"

#: settings-schema.json
#, javascript-format
msgid "AWS profile (PROFILE)"
msgstr "Perfil de AWS (PROFILE)"

#: settings-schema.json
#, javascript-format
msgid "Region (REGION)"
msgstr "Región (REGION)"

#: settings-schema.json
#, javascript-format
msgid "Restore job ID (RESTORE_JOB_ID)"
msgstr "ID de restauración (RESTORE_JOB_ID)"

#: settings-schema.json
#, javascript-format
msgid "seconds"
msgstr "segundos"

#: settings-schema.json
#, javascript-format
msgid "Polling interval"
msgstr "Intervalo entre consultas"

#: settings-schema.json
#, javascript-format
msgid "AWS CLI executable"
msgstr "Ejecutable de AWS CLI"

#: settings-schema.json
#, javascript-format
msgid ""
"Use aws or the absolute path returned by command -v aws in your terminal."
msgstr "Usa aws o la ruta absoluta que devuelve command -v aws en tu terminal."

#: metadata.json
#, javascript-format
msgid ""
"Monitor the status and progress of cold storage restores through AWS Backup."
msgstr "Monitor de estado y avance de restauraciones desde almacenamiento frío mediante AWS Backup."

#: metadata.json
#, javascript-format
msgid "AWS Cold Restore Monitor"
msgstr "AWS Cold Restore Monitor"
