#: applet.js:62
#, javascript-format
msgid "AWS · Configure"
msgstr "AWS · Configurar"

#: applet.js:90
#, javascript-format
msgid "Refresh now"
msgstr "Atualizar agora"

#: applet.js:91
#, javascript-format
msgid "Configure…"
msgstr "Configurar…"

#: applet.js:180
#, javascript-format
msgid "Could not send the system notification."
msgstr "Não foi possível enviar a notificação do sistema."

#: applet.js:197
#, javascript-format
msgid "AWS · Internal error"
msgstr "AWS · Erro interno"

#: applet.js:210
#, javascript-format
msgid "no percentage"
msgstr "porcentagem indisponível"

#: applet.js:214
#, javascript-format
msgid "AWS · Error"
msgstr "AWS · Erro"

#: applet.js:214
#, javascript-format
msgid "AWS · Retrying"
msgstr "AWS · Tentando novamente"

#: applet.js:214
#, javascript-format
msgid "AWS %s"
msgstr "AWS %s"

#: applet.js:214
#, javascript-format
msgid "AWS · %s"
msgstr "AWS · %s"

#: applet.js:218
#, javascript-format
msgid "AWS Cold Restore Monitor: %s"
msgstr "AWS Cold Restore Monitor: %s"

#: applet.js:219
#, javascript-format
msgid "%s · %s"
msgstr "%s · %s"

#: applet.js:220
#, javascript-format
msgid "Right-click and choose Configure to select a restore job."
msgstr "Clique com o botão direito e escolha Configurar para selecionar um trabalho de restauração."

#: applet.js:223
#, javascript-format
msgid ""
"Automatic queries are paused. Fix the problem and click Refresh now or "
"change the settings."
msgstr "As consultas automáticas estão pausadas. Corrija o problema e clique em Atualizar agora ou altere as configurações."

#: applet.js:224
#, javascript-format
msgid "AWS: %s"
msgstr "AWS: %s"

#: applet.js:226
#, javascript-format
msgid "Status: %s (previous result; query pending)"
msgstr "Status: %s (resultado anterior; consulta pendente)"

#: applet.js:226
#, javascript-format
msgid "Status: %s"
msgstr "Status: %s"

#: applet.js:227
#, javascript-format
msgid "Estimated progress: %s"
msgstr "Progresso estimado: %s"

#: applet.js:228
#, javascript-format
msgid "Job: %s"
msgstr "Trabalho: %s"

#: applet.js:228
#, javascript-format
msgid "not configured"
msgstr "não configurado"

#: applet.js:229
#, javascript-format
msgid "Profile: %s · Region: %s"
msgstr "Perfil: %s · Região: %s"

#: applet.js:230
#, javascript-format
msgid "Started: %s"
msgstr "Início: %s"

#: applet.js:231
#, javascript-format
msgid "Completed: %s"
msgstr "Conclusão: %s"

#: applet.js:232
#, javascript-format
msgid "Last successful query: %s"
msgstr "Última consulta bem-sucedida: %s"

#: applet.js:273
#, javascript-format
msgid "Configure"
msgstr "Configurar"

#: applet.js:274
#, javascript-format
msgid ""
"Enter the profile, region, restore job ID, and AWS CLI path in Configure."
msgstr "Em Configurar, informe o perfil, a região, o ID do trabalho de restauração e o caminho da AWS CLI."

#: applet.js:278
#, javascript-format
msgid "The interval must be between 10 and 3600 seconds. Check the settings."
msgstr "O intervalo deve estar entre 10 e 3600 segundos. Verifique as configurações."

#: applet.js:281
#, javascript-format
msgid "Querying…"
msgstr "Consultando…"

#: applet.js:339
#, javascript-format
msgid "AWS reports that the restore failed. Review the job in AWS Backup."
msgstr "A AWS informa que a restauração falhou. Verifique o trabalho no AWS Backup."

#: applet.js:339
#, javascript-format
msgid "AWS reports that the restore was aborted. Review the job in AWS Backup."
msgstr "A AWS informa que a restauração foi abortada. Verifique o trabalho no AWS Backup."

#: applet.js:343
#, javascript-format
msgid "Query successful"
msgstr "Consulta bem-sucedida"

#: applet.js:345
#, javascript-format
msgid ""
"AWS has not reported a valid percentage. The job status is still available."
msgstr "A AWS não informou uma porcentagem válida. O status do trabalho continua disponível."

#: applet.js:348
#, javascript-format
msgid ""
"The query succeeded, but AWS CLI issued a warning. Run the query in your "
"terminal to review it."
msgstr "A consulta foi concluída com sucesso, mas a AWS CLI emitiu um aviso. Execute a consulta no terminal para visualizar o aviso."

#: applet.js:380
#, javascript-format
msgid "Could not load the applet. Check the installation and add it again."
msgstr "Não foi possível carregar o applet. Verifique a instalação e adicione-o novamente."

#: errors.js:28
#, javascript-format
msgid "The query exceeded 60 seconds. It will be retried automatically."
msgstr "A consulta excedeu 60 segundos. Uma nova tentativa será feita automaticamente."

#: errors.js:30
#, javascript-format
msgid ""
"The monitor encountered an internal error. Remove the applet and add it "
"again."
msgstr "O monitor encontrou um erro interno. Remova o applet e adicione-o novamente."

#: errors.js:32
#, javascript-format
msgid ""
"AWS returned an invalid response. Check the query with AWS CLI and click "
"Refresh now."
msgstr "A AWS retornou uma resposta inválida. Verifique a consulta com a AWS CLI e clique em Atualizar agora."

#: errors.js:34
#, javascript-format
msgid ""
"Could not authenticate with AWS. Check your credentials or renew your SSO "
"session, then click Refresh now."
msgstr "Não foi possível autenticar na AWS. Verifique suas credenciais ou renove sua sessão SSO e clique em Atualizar agora."

#: errors.js:36
#, javascript-format
msgid ""
"AWS denied access. Check the backup:DescribeRestoreJob permission for this "
"profile."
msgstr "A AWS negou o acesso. Verifique a permissão backup:DescribeRestoreJob para este perfil."

#: errors.js:38
#, javascript-format
msgid ""
"The job or profile was not found. Check the profile, region, and restore job "
"ID."
msgstr "O trabalho ou o perfil não foi encontrado. Verifique o perfil, a região e o ID do trabalho de restauração."

#: errors.js:40
#, javascript-format
msgid ""
"The secure connection could not be verified. Check your certificates and "
"network configuration."
msgstr "Não foi possível verificar a conexão segura. Verifique seus certificados e a configuração de rede."

#: errors.js:42
#, javascript-format
msgid ""
"Could not start AWS CLI. Check that it is installed and that the executable "
"path and permissions are correct."
msgstr "Não foi possível iniciar a AWS CLI. Verifique se ela está instalada e se o caminho e as permissões do executável estão corretos."

#: errors.js:44
#, javascript-format
msgid ""
"The AWS CLI configuration or arguments are invalid. Check the applet "
"settings."
msgstr "A configuração ou os argumentos da AWS CLI são inválidos. Verifique as configurações do applet."

#: errors.js:46
#, javascript-format
msgid ""
"AWS is throttling requests. The query will be retried after a longer delay."
msgstr "A AWS está limitando a frequência das solicitações. Uma nova tentativa será feita após um intervalo maior."

#: errors.js:48
#, javascript-format
msgid ""
"AWS is unavailable or there is a network problem. The query will be retried "
"automatically."
msgstr "A AWS está indisponível ou há um problema de rede. A consulta será repetida automaticamente."

#: errors.js:50
#, javascript-format
msgid ""
"Communication with AWS CLI was interrupted. The query will be retried "
"automatically."
msgstr "A comunicação com a AWS CLI foi interrompida. A consulta será repetida automaticamente."

#: errors.js:51
#, javascript-format
msgid ""
"AWS CLI exited with an unrecognized error. Check the query in your terminal "
"and click Refresh now."
msgstr "A AWS CLI foi encerrada com um erro não reconhecido. Verifique a consulta no terminal e clique em Atualizar agora."

#: settings-schema.json
#, javascript-format
msgid "Restore job"
msgstr "Trabalho de restauração"

#: settings-schema.json
#, javascript-format
msgid "AWS profile (PROFILE)"
msgstr "Perfil da AWS (PROFILE)"

#: settings-schema.json
#, javascript-format
msgid "Region (REGION)"
msgstr "Região (REGION)"

#: settings-schema.json
#, javascript-format
msgid "Restore job ID (RESTORE_JOB_ID)"
msgstr "ID do trabalho de restauração (RESTORE_JOB_ID)"

#: settings-schema.json
#, javascript-format
msgid "seconds"
msgstr "segundos"

#: settings-schema.json
#, javascript-format
msgid "Polling interval"
msgstr "Intervalo entre consultas"

#: settings-schema.json
#, javascript-format
msgid "AWS CLI executable"
msgstr "Executável da AWS CLI"

#: settings-schema.json
#, javascript-format
msgid ""
"Use aws or the absolute path returned by command -v aws in your terminal."
msgstr "Use aws ou o caminho absoluto retornado por command -v aws no terminal."

#: metadata.json
#, javascript-format
msgid ""
"Monitor the status and progress of cold storage restores through AWS Backup."
msgstr "Monitore o status e o progresso de restaurações a partir do armazenamento frio por meio do AWS Backup."

#: metadata.json
#, javascript-format
msgid "AWS Cold Restore Monitor"
msgstr "AWS Cold Restore Monitor"
