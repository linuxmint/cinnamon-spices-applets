msgid "Choose Folder"
msgstr "Mappa kiválasztása"

#. scripts/map-drive.py:778
msgid ""
"Examples:\n"
"\n"
"\\\\Computer\\SharedFolder\n"
"smb://Server.local/SharedFolder/\n"
"https://127.0.0.1/webdav/\n"
"sftp://user@127.0.0.1/ (SSH SFTP)\n"
"/path/to/file/\n"
"~/folder/"
msgstr ""
"Példák:\n"
"\n"
"\\\\Számítógép\\MegosztottMappa\n"
"smb://Kiszolgáló.local/MegosztottMappa/\n"
"https://127.0.0.1/webdav/\n"
"sftp://felhasználó@127.0.0.1/ (SSH SFTP)\n"
"/fájl/elérési_út/\n"
"~/mappa/"

