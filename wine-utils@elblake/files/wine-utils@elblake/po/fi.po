#. settings-schema.json->head0->description
msgid "Settings for wine-utils@elblake"
msgstr "Asetukset wine-utils@elblake"

#. settings-schema.json->head1->description
msgid "General"
msgstr "Yleinen"

#. settings-schema.json->show-launchers->description
msgid "Show Launchers"
msgstr "Näytä käynnistimet"

#. settings-schema.json->show-launchers->tooltip
msgid "Show some of the Wine launchers if they are installed."
msgstr "Näytä osa Wine-käynnistimistä, jos niitä on asennettu."

#. settings-schema.json->show-run-command->description
msgid "Show 'Run Command...'"
msgstr "Näytä \"Suorita komento...'"

#. settings-schema.json->show-run-command->tooltip
msgid "For running a Wine command."
msgstr "Wine-komennon suorittamiseen."

#. settings-schema.json->show-cmd->description
msgid "Show 'Command Prompt'"
msgstr "Näytä ”Komentokehote”"

#. settings-schema.json->show-cmd->tooltip
msgid "For easy access to the Wine command prompt."
msgstr "Helppo pääsy Winen komentoriville."

#. settings-schema.json->show-admin-programs-menu->description
msgid "Show the Configuration menu"
msgstr "Näytä Määritykset valikko"

#. settings-schema.json->show-admin-programs-menu->tooltip
msgid ""
"Show a menu of useful Wine utilities that typically need to be accessed by "
"CLI."
msgstr ""
"Näytä valikko hyödyllisiä Wine-apuohjelmia, joita on yleensä käytettävä "
"komentorivin kautta."

#. settings-schema.json->show-programs-menu->description
msgid "Show the Programs menu"
msgstr "Näytä Ohjelmat valikko"

#. settings-schema.json->show-programs-menu->tooltip
msgid ""
"Show a menu to access programs directly from Wine's installed program "
"shortcuts."
msgstr ""
"Näytä valikko, jolla pääset suoraan ohjelmiin Wine-asennettujen ohjelmien "
"pikanäppäimistä."

#. settings-schema.json->use-dark-theme-icons->description
msgid "Use dark theme icons when available."
msgstr "Tumman teeman kuvakkeet kun saatavilla."

#. settings-schema.json->icon-style->description
msgid "Panel Icon Style"
msgstr "Kuvake paneelissa"

#. settings-schema.json->icon-style->options
msgid "default"
msgstr "oletus"

#. settings-schema.json->icon-style->options
msgid "style 1"
msgstr "tyyli 1"

#. settings-schema.json->icon-style->options
msgid "style 2"
msgstr "tyyli 2"

#. settings-schema.json->icon-style->options
msgid "style 3"
msgstr "tyyli 3"

#. settings-schema.json->specify-custom-icon->description
msgid "Use custom panel icon"
msgstr "Käytä omaa kuvaketta paneelissa"

#. settings-schema.json->specify-custom-icon->tooltip
msgid "Use a custom icon for the applet."
msgstr "Käytä sovelmalle mukautettua kuvaketta."

#. settings-schema.json->custom-icon->description
msgid "Custom icon"
msgstr "Mukautettu kuvake"

#. settings-schema.json->head2->description
msgid "Advanced"
msgstr "Lisäasetukset"

#. settings-schema.json->prefix-file-list->description
msgid "Path to prefix list"
msgstr "Etuliitelistan polku"

#. settings-schema.json->prefix-file-list->tooltip
msgid ""
"Select a text file, each line in the file should contain the full path of a "
"wine prefix directory. You can add a name followed by a colon at the "
"beginning of each line to give that prefix path a label."
msgstr ""
"Valitse tekstitiedosto, jonka jokaisella rivillä tulee olla wine prefix "
"koko polku. Voit lisätä rivien alkuun nimen ja sitä seuraavan "
"kaksoispisteen antaaksesi kyseiselle polulle tunnisteen."

#. settings-schema.json->specify-wine-exec->description
msgid "Specify the wine executable"
msgstr "Määritä Wine-suoritustiedosto"

#. settings-schema.json->specify-wine-exec->tooltip
msgid "Specify the wine executable, by default 'wine' is used."
msgstr "Määritä wine-suoritustiedosto; oletuksena käytetään arvoa ”wine”."

#. settings-schema.json->wine-exec->description
msgid "Wine executable"
msgstr "Wine-suoritus"

#. settings-schema.json->wine-exec->tooltip
msgid "The wine executable to use."
msgstr "Käytettävä Wine-suoritustiedosto."

#. settings-schema.json->wineconsole-exec->description
msgid "Wine console executable"
msgstr "Wine-konsolisovellus"

#. settings-schema.json->wineconsole-exec->tooltip
msgid "The wine console executable to use."
msgstr "Käytettävä Wine-konsolisuoritustiedosto."

