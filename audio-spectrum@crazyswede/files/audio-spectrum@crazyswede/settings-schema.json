{
    "appearance": {
        "type": "section",
        "title": "Audio Spectrum — Display",
        "keys": [
            "bar_count",
            "sensitivity",
            "bar_width",
            "height_mode",
            "height",
            "vertical_alignment",
            "separator",
            "skin",
            "panel_color_mode"
        ],
        "description": "Audio Spectrum display settings"
    },
    "bar_count": {
        "type": "spinbutton",
        "default": 60,
        "min": 20,
        "max": 200,
        "step": 10,
        "units": "EQ bars",
        "description": "Visible spectrum bar count"
    },
    "sensitivity": {
        "type": "spinbutton",
        "default": 650,
        "min": 5,
        "max": 1000,
        "step": 1,
        "units": "%",
        "description": "Audio Spectrum input sensitivity"
    },
    "bar_width": {
        "type": "spinbutton",
        "default": 4,
        "min": 1,
        "max": 10,
        "step": 0.5,
        "units": "PX",
        "description": "Spectrum bar thickness"
    },
    "height_mode": {
        "type": "combobox",
        "default": "auto",
        "description": "Spectrum height mode",
        "options": {
            "Use full panel height": "auto",
            "Use custom height": "manual"
        }
    },
    "height": {
        "type": "spinbutton",
        "default": 24,
        "min": 10,
        "max": 60,
        "step": 1,
        "units": "PX",
        "description": "Custom spectrum height",
        "dependency": "height_mode=manual"
    },
    "vertical_alignment": {
        "type": "combobox",
        "default": "center",
        "description": "Spectrum vertical position",
        "options": {
            "Align to panel top": "top",
            "Center in panel": "center",
            "Align to panel bottom": "bottom"
        },
        "dependency": "height_mode=manual"
    },
    "separator": {
        "type": "spinbutton",
        "default": 0.8,
        "min": 0,
        "max": 3,
        "step": 0.1,
        "units": "PX",
        "description": "Gap between spectrum bars"
    },
    "skin": {
        "type": "combobox",
        "default": "classic",
        "description": "Spectrum design",
        "options": {
            "Classic LED": "classic",
            "80s Car Stereo": "stereo80",
            "Dot Matrix": "dotmatrix",
            "Classic Spectrum": "spectrum",
            "Fire": "fire",
            "Neon Line": "neon",
            "VU Meter": "vu",
            "1980s Digital": "digital80",
            "Oscilloscope": "oscilloscope",
            "Classic Neon": "classicneon",
            "Vacuum Fluorescent": "vacuumfluorescent",
            "Amber Analyzer": "amberanalyzer",
            "LED Tower": "ledtower",
            "Futuristic Dashboard": "futuristicdashboard",
            "Oscilloscope Blocks": "oscilloscopeblocks",
            "Cassette Deck": "cassettedeck",
            "Pixel Plasma": "pixelplasma"
        }
    },
    "panel_color_mode": {
        "type": "combobox",
        "default": "auto",
        "description": "Panel color mode",
        "tooltip": "Automatically detect the panel background, or force the light/dark skin variant",
        "options": {
            "Auto detect": "auto",
            "Light panel": "light",
            "Dark panel": "dark"
        }
    },
    "animation": {
        "type": "section",
        "title": "Audio Spectrum — Motion",
        "keys": [
            "fps",
            "gravity",
            "peak_hold"
        ],
        "description": "Audio Spectrum motion settings"
    },
    "fps": {
        "type": "combobox",
        "default": "25",
        "description": "FPS",
        "options": {
            "20 FPS": "20",
            "25 FPS": "25",
            "30 FPS": "30",
            "60 FPS": "60"
        }
    },
    "gravity": {
        "type": "spinbutton",
        "default": 400,
        "min": 50,
        "max": 600,
        "step": 25,
        "units": "%",
        "description": "Spectrum fall speed (higher is faster)"
    },
    "peak_hold": {
        "type": "spinbutton",
        "default": 0,
        "min": 0,
        "max": 2000,
        "step": 50,
        "units": "ms",
        "description": "Peak marker hold time (0 disables it)"
    },
    "reset": {
        "type": "section",
        "title": "Audio Spectrum — Reset",
        "keys": [
            "restore_defaults"
        ],
        "description": "Audio Spectrum reset controls"
    },
    "restore_defaults": {
        "type": "button",
        "description": "Reset Audio Spectrum settings",
        "callback": "_restoreDefaultSettings",
        "tooltip": "Reset every Audio Spectrum option to its original value"
    }
}
