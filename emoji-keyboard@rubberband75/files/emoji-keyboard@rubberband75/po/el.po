#. applet.js:519
msgid "Your recently used emoji will appear here"
msgstr "Τα πρόσφατα emoji σας θα εμφανίζονται εδώ"

#. applet.js:520
msgid "No emoji found"
msgstr "Δεν βρέθηκαν emoji"

#. metadata.json->description
msgid "Search, copy, and insert emoji from a native Cinnamon panel popup."
msgstr ""
"Αναζητήστε, αντιγράψτε και εισαγάγετε emoji από ένα αναδυόμενο παράθυρο του "
"πίνακα του Cinnamon."

#. settings-schema.json->copy-to-clipboard->description
msgid "Copy emoji to clipboard"
msgstr "Αντιγραφή emoji στο πρόχειρο"

#. settings-schema.json->copy-to-clipboard->tooltip
msgid ""
"When enabled, the selected emoji stays on the clipboard after it is "
"inserted. When disabled, the clipboard is restored to its previous contents "
"after insertion."
msgstr ""
"Όταν είναι ενεργοποιημένο, το επιλεγμένο emoji παραμένει στο πρόχειρο μετά "
"την εισαγωγή του. Όταν είναι απενεργοποιημένο, το προηγούμενο περιεχόμενο "
"του προχείρου επαναφέρεται αμέσως μετά την εισαγωγή."

#. settings-schema.json->category-icon-size->description
msgid "Category icon size"
msgstr "Μέγεθος εικονιδίου κατηγορίας"

#. settings-schema.json->category-icon-size->options
#. settings-schema.json->emoji-size->options
msgid "Match Panel Colored Icon Size"
msgstr "Ταίριασμα με το έγχρωμο μέγεθος εικονιδίων του πίνακα"

#. settings-schema.json->category-icon-size->options
#. settings-schema.json->emoji-size->options
msgid "Match Panel Symbolic Icon Size"
msgstr "Ταίριασμα με το συμβολικό μέγεθος εικονιδίων του πίνακα"

