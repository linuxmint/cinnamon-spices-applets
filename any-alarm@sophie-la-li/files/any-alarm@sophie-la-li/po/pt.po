#. settings-schema.json->mode->options
msgid "every # seconds (see option below)"
msgstr "a cada # segundos (consultar opção abaixo)"

#. settings-schema.json->mode->options
msgid "every full minute"
msgstr "a cada minuto completo"

#. settings-schema.json->mode->options
msgid "every quarter hour"
msgstr "a cada 15 minutos"

#. settings-schema.json->mode->options
msgid "every half hour"
msgstr "a cada meia hora"

#. settings-schema.json->mode->options
msgid "every full hour"
msgstr "a cada hora completa"

#. settings-schema.json->xs-mode-seconds->units
msgid "seconds"
msgstr "segundos"

#. settings-schema.json->xs-mode-seconds->description
msgid "Seconds for the \"every # seconds\" mode"
msgstr "Segundos para modo \"a cada # segundos \""

#. settings-schema.json->alarm-text->description
msgid "Alarm Text"
msgstr "Texto do alarme"
