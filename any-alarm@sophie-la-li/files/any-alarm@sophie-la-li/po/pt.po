msgid "AnyAlarm"
msgstr "AnyAlarm"

#. metadata.json->name
msgid "Any Alarm"
msgstr "Qualquer alarme"

#. metadata.json->description
msgid "Will remind you regularly about something"
msgstr "Irá lembra-lo regularmente de alguma coisa"

#. settings-schema.json->enabled->description
msgid "Alarm enabled"
msgstr "Alarme ativado"

#. settings-schema.json->mode->description
msgid "When to trigger the alarm"
