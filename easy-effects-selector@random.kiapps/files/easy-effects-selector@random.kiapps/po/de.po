#, javascript-format
msgid "%s (no longer available)"
msgstr "%s (nicht mehr vorhanden)"

msgid "Applet"
msgstr "Applet"

#, javascript-format
msgid "Autostart could not be changed: %s"
msgstr "Autostart konnte nicht geändert werden: %s"

#, javascript-format
msgid "Comparison unavailable: %s"
msgstr "Vergleich nicht möglich: %s"

msgid "Default preset"
msgstr "Standardpreset"

#, javascript-format
msgid "Default preset: %s"
msgstr "Standardpreset: %s"

msgid "Easy Effects"
msgstr "Easy Effects"

msgid "EasyEffects Preset Selector"
msgstr "EasyEffects Preset Selector"

msgid "EasyEffects did not load the output preset. Please check the preset file."
msgstr "EasyEffects hat das Ausgabe-Preset nicht übernommen. Bitte die Preset-Datei prüfen."

msgid "EasyEffects output preset"
msgstr "EasyEffects-Ausgabevoreinstellung"

#, javascript-format
msgid "EasyEffects output preset: %s"
msgstr "EasyEffects-Ausgabevoreinstellung: %s"

msgid "EasyEffects: loading preset…"
msgstr "EasyEffects: Voreinstellung wird geladen …"

msgid "Effect settings changed"
msgstr "Effekteinstellungen verändert"

msgid "Global bypass enabled"
msgstr "Globaler Bypass eingeschaltet"

msgid "Incomplete structure in the default preset."
msgstr "Unvollständige Struktur im Standardpreset."

msgid "Invalid effect name in the default preset."
msgstr "Ungültiger Effektname im Standardpreset."

msgid "Invalid structure in the default preset."
msgstr "Ungültige Struktur im Standardpreset."

msgid "Launch EasyEffects from the menu title"
msgstr "EasyEffects über die Titelzeile starten"

msgid "Launch Service at System Startup"
msgstr "Dienst beim Systemstart starten"

msgid "Make the Easy Effects menu title clickable to launch EasyEffects."
msgstr "Die Titelzeile „Easy Effects“ im Menü anklickbar machen, um EasyEffects zu starten."

msgid "No default preset"
msgstr "Kein Standardpreset"

msgid "No output presets saved"
msgstr "Keine Ausgabevoreinstellungen gespeichert"

#, javascript-format
msgid "Preset “%s” could not be loaded.\n%s"
msgstr "Voreinstellung „%s“ konnte nicht geladen werden.\n%s"

msgid "Presets could not be read"
msgstr "Voreinstellungen konnten nicht gelesen werden"

msgid "Quit EasyEffects when its window closes. This setting is synchronized in both directions with the EasyEffects settings window."
msgstr "EasyEffects beim Schließen seines Fensters vollständig beenden. Diese Einstellung ist mit dem EasyEffects-Einstellungsfenster in beide Richtungen synchronisiert."

msgid "Select EasyEffects 7.2.3 output presets from the panel"
msgstr "Ausgabevoreinstellungen von EasyEffects 7.2.3 direkt aus der Leiste auswählen"

msgid "Shutdown on Window Closing"
msgstr "Beim Schließen des Fensters beenden"

msgid "Start EasyEffects as a background service at login. If its settings window is already open, reopen it to see external autostart changes."
msgstr "EasyEffects beim Anmelden als Hintergrunddienst starten. Ein bereits geöffnetes EasyEffects-Einstellungsfenster zeigt externe Autostart-Änderungen erst nach erneutem Öffnen an."

msgid "The Cinnamon applet settings could not be initialized."
msgstr "Die Cinnamon-Applet-Einstellungen konnten nicht initialisiert werden."

msgid "The EasyEffects autostart path is not a regular file."
msgstr "Der EasyEffects-Autostartpfad ist keine reguläre Datei."

msgid "The EasyEffects command failed."
msgstr "EasyEffects-Befehl fehlgeschlagen."

#, javascript-format
msgid "The EasyEffects effect parameter is missing: %s"
msgstr "EasyEffects-Effektparameter fehlt: %s"

msgid "The EasyEffects setting could not be saved."
msgstr "Die EasyEffects-Einstellung konnte nicht gespeichert werden."

msgid "The EasyEffects setting is not available."
msgstr "Die EasyEffects-Einstellung ist nicht verfügbar."

#, javascript-format
msgid "The EasyEffects settings schema is missing: %s"
msgstr "EasyEffects-Einstellungsschema fehlt: %s"

msgid "The EasyEffects settings schema was not found."
msgstr "Das EasyEffects-Einstellungsschema wurde nicht gefunden."

msgid "The autostart directory could not be created."
msgstr "Das Autostart-Verzeichnis konnte nicht erstellt werden."

#, javascript-format
msgid "The default preset cannot be read: %s"
msgstr "Standardpreset nicht lesbar: %s"

msgid "The default preset could not be read."
msgstr "Standardpreset konnte nicht gelesen werden."

msgid "The default preset does not contain a valid output effect list."
msgstr "Das Standardpreset enthält keine gültige Ausgabe-Effektliste."

#, javascript-format
msgid "The effect configuration is missing from the default preset: %s"
msgstr "Effektkonfiguration fehlt im Standardpreset: %s"

msgid "The effect parameter map could not be read."
msgstr "Die Effektparameter-Zuordnung konnte nicht gelesen werden."

msgid "The original preset name could not be restored."
msgstr "Der ursprüngliche Preset-Name konnte nicht wiederhergestellt werden."

msgid "The preset file was moved or deleted."
msgstr "Die Preset-Datei wurde verschoben oder gelöscht."

#, javascript-format
msgid "Unknown EasyEffects effect: %s"
msgstr "Unbekannter EasyEffects-Effekt: %s"

msgid "Use as the reference for the blue dot and as the last entry in the preset menu. Selecting a default does not load a preset."
msgstr "Als Vergleichswert für den blauen Punkt und als letzten Eintrag im Preset-Menü speichern. Die Auswahl lädt kein Preset."

msgid "When a default preset is selected, a blue dot indicates that the current overall settings differ from the default preset. This setting does not load anything at startup."
msgstr "Bei Wahl eines Standardpresets zeigt ein blauer Punkt an, dass die aktuellen Gesamteinstellungen vom Standardpreset abweichen. Beim Start wird durch diese Einstellung nichts geladen."

msgid "random.kiapps"
msgstr "random.kiapps"
