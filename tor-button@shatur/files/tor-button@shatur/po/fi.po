msgstr "Asetukset"

#. tor-button@shatur->settings-schema.json->configPath->description
msgid "Tor config path"
msgstr "Tor-määrityksen (torrc) polku"

#. tor-button@shatur->settings-schema.json->configPath->tooltip
msgid "Specify the path to torrc file."
msgstr "Määritä torrc-tiedoston polku."

#. tor-button@shatur->settings-schema.json->runAsRoot->description
msgid "Launch Tor as tor user"
msgstr "Käynnistä Tor tor-käyttäjänä"

#. tor-button@shatur->settings-schema.json->runAsRoot->tooltip
msgid ""
"Launch Tor with polkit as tor user. Needed if you don't have permissions to "
"launch Tor as normal user."
msgstr ""
"Käynnistä Tor polkit avulla tor-käyttäjänä. Tarpeellinen, jos sinulla ei "
"ole oikeuksia käynnistää Toria tavallisena käyttäjänä."

