#. tor-button@shatur->settings-schema.json->showNotifications->description
msgid "Show notifications"
msgstr "Näytä ilmoitukset"

#. tor-button@shatur->settings-schema.json->showNotifications->tooltip
msgid "Show notifications when the Tor network is turned on/off."
msgstr "Näytä ilmoitus kun Tor otetaan käyttöön tai poistetaan."

#. tor-button@shatur->settings-schema.json->torPath->description
msgid "Tor location path"
msgstr "Tor-polku"

#. tor-button@shatur->settings-schema.json->torPath->tooltip
msgid "Specify the command to launch Tor."
msgstr "Komento Torin käynnistämiseksi."

#. tor-button@shatur->settings-schema.json->torrc-page->title
msgid "Tor settings"
msgstr "Tor-asetukset"

#. tor-button@shatur->settings-schema.json->applet-section->title
