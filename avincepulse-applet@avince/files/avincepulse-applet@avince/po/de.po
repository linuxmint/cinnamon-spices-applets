#. settings-schema.json->btn-speedtest->description
#: applet.js:398
msgid "Run a speed test now"
msgstr "Internet-Speedtest starten"

#: applet.js:844 applet.js:1161 hardwareDetection.js:273 measurement.js:726
#: speedtest.js:474
#, javascript-format
msgid "Not found: %s"
msgstr "Nicht gefunden: %s"

