#. files->appman-manager@z3n0e->metadata.json->name
msgid "AppMan Manager"
msgstr "AppMan Manager"

#. files->appman-manager@z3n0e->metadata.json->description
msgid ""
"Check, update, install, reinstall and remove AppImages and portable apps "
"managed by AppMan (ivan-hc/AM). Battery friendly, with a user-defined update "
"schedule."
msgstr ""
"Controlla, aggiorna, installa, reinstalla e rimuove AppImage e app portabili "
"gestite da AppMan (ivan-hc/AM). Leggero sulla batteria, con una "
"pianificazione degli aggiornamenti a tua scelta."

#. files->appman-manager@z3n0e->settings-schema.json->page-updates->title
msgid "Updates"
msgstr "Aggiornamenti"

#. files->appman-manager@z3n0e->settings-schema.json->sec-schedule->title
msgid "When to check for updates"
msgstr "Quando controllare gli aggiornamenti"

#. files->appman-manager@z3n0e->settings-schema.json->sec-power->title
msgid "Battery and network"
msgstr "Batteria e rete"

#. files->appman-manager@z3n0e->settings-schema.json->sec-found->title
msgid "When updates are found"
msgstr "Quando ci sono aggiornamenti"

#. files->appman-manager@z3n0e->settings-schema.json->page-operations->title
msgid "Operations"
msgstr "Operazioni"

#. files->appman-manager@z3n0e->settings-schema.json->sec-run->title
msgid "How AppMan commands run"
msgstr "Come vengono eseguiti i comandi di AppMan"

#. files->appman-manager@z3n0e->settings-schema.json->sec-advanced->title
msgid "Advanced"
msgstr "Avanzate"

#. files->appman-manager@z3n0e->settings-schema.json->page-panel->title
msgid "Panel"
msgstr "Pannello"

#. files->appman-manager@z3n0e->settings-schema.json->sec-panel->title
msgid "Panel and menu"
msgstr "Pannello e menu"

#. files->appman-manager@z3n0e->settings-schema.json->check-mode->options
msgid "Only when I ask (manual)"
msgstr "Solo quando lo chiedo (manuale)"

#. files->appman-manager@z3n0e->settings-schema.json->check-mode->options
msgid "Every N hours"
msgstr "Ogni N ore"

#. files->appman-manager@z3n0e->settings-schema.json->check-mode->options
msgid "Every day at a set time"
msgstr "Ogni giorno a un'ora stabilita"

#. files->appman-manager@z3n0e->settings-schema.json->check-mode->options
msgid "Once a week"
msgstr "Una volta a settimana"

#. files->appman-manager@z3n0e->settings-schema.json->check-mode->tooltip
msgid ""
"Checks only query the AppMan sources online. Nothing is downloaded or "
"installed unless you choose to."
msgstr ""
"I controlli interrogano solo le fonti online di AppMan. Non viene scaricato "
"né installato nulla, a meno che non lo scelga tu."

#. files->appman-manager@z3n0e->settings-schema.json->check-interval->units
msgid "hours"
msgstr "ore"

#. files->appman-manager@z3n0e->settings-schema.json->check-interval->description
msgid "Interval"
msgstr "Intervallo"

#. files->appman-manager@z3n0e->settings-schema.json->check-time->description
#. files->appman-manager@z3n0e->settings-schema.json->check-weekly-time->description
msgid "Time of day"
msgstr "Ora del giorno"

#. files->appman-manager@z3n0e->settings-schema.json->check-weekday->description
msgid "Day of the week"
msgstr "Giorno della settimana"

#. files->appman-manager@z3n0e->settings-schema.json->check-weekday->options
msgid "Monday"
msgstr "Lunedì"

#. files->appman-manager@z3n0e->settings-schema.json->check-weekday->options
msgid "Tuesday"
msgstr "Martedì"

#. files->appman-manager@z3n0e->settings-schema.json->check-weekday->options
msgid "Wednesday"
msgstr "Mercoledì"

#. files->appman-manager@z3n0e->settings-schema.json->check-weekday->options
msgid "Thursday"
msgstr "Giovedì"

#. files->appman-manager@z3n0e->settings-schema.json->check-weekday->options
msgid "Friday"
msgstr "Venerdì"

#. files->appman-manager@z3n0e->settings-schema.json->check-weekday->options
msgid "Saturday"
msgstr "Sabato"

#. files->appman-manager@z3n0e->settings-schema.json->check-weekday->options
msgid "Sunday"
msgstr "Domenica"

#. files->appman-manager@z3n0e->settings-schema.json->check-at-login->description
msgid "Catch up at login if a scheduled check was missed"
msgstr "Recupera all'accesso un controllo programmato saltato"

#. files->appman-manager@z3n0e->settings-schema.json->check-at-login->tooltip
msgid ""
"If the computer was off or asleep at the scheduled time, check once shortly "
"after login or resume."
msgstr ""
"Se all'ora programmata il computer era spento o in sospensione, controlla "
"una volta poco dopo l'accesso o il risveglio."

#. files->appman-manager@z3n0e->settings-schema.json->login-delay->units
msgid "minutes"
msgstr "minuti"

#. files->appman-manager@z3n0e->settings-schema.json->login-delay->description
msgid "Wait after login before catching up"
msgstr "Attesa dopo l'accesso prima del recupero"

#. files->appman-manager@z3n0e->settings-schema.json->btn-check-now->description
msgid "Check for updates now"
msgstr "Controlla aggiornamenti ora"

#. files->appman-manager@z3n0e->settings-schema.json->skip-on-battery->description
msgid "Postpone automatic checks and updates while on battery"
msgstr "Rimanda controlli e aggiornamenti automatici quando sei a batteria"

#. files->appman-manager@z3n0e->settings-schema.json->skip-on-battery->tooltip
msgid ""
"The postponed check runs as soon as the charger is connected (event-driven, "
"no polling)."
msgstr ""
"Il controllo rimandato parte appena colleghi il caricatore (a eventi, senza "
"polling)."

#. files->appman-manager@z3n0e->settings-schema.json->skip-on-metered->description
msgid "Postpone automatic checks and updates on metered connections"
msgstr ""
"Rimanda controlli e aggiornamenti automatici sulle connessioni a consumo"

#. files->appman-manager@z3n0e->settings-schema.json->power-note->description
msgid "Manual checks and actions from the menu always run."
msgstr "I controlli manuali e le azioni dal menu vengono sempre eseguiti."

#. files->appman-manager@z3n0e->settings-schema.json->on-updates->description
msgid "Action"
msgstr "Azione"

#. files->appman-manager@z3n0e->settings-schema.json->on-updates->options
msgid "Show them in the panel only"
msgstr "Mostrali solo nel pannello"

#. files->appman-manager@z3n0e->settings-schema.json->on-updates->options
msgid "Send a notification"
msgstr "Invia una notifica"

#. files->appman-manager@z3n0e->settings-schema.json->on-updates->options
msgid "Install them automatically (in background)"
msgstr "Installali automaticamente (in background)"

#. files->appman-manager@z3n0e->settings-schema.json->update-all-syncs->description
msgid "\"Full update\" also updates AppMan itself"
msgstr "\"Aggiornamento completo\" aggiorna anche AppMan stesso"

#. files->appman-manager@z3n0e->settings-schema.json->update-all-syncs->tooltip
msgid "On: runs \"appman -u\". Off: runs \"appman -u --apps\" (apps only)."
msgstr ""
"Attivo: esegue \"appman -u\". Disattivo: esegue \"appman -u --apps\" (solo "
"le app)."

#. files->appman-manager@z3n0e->settings-schema.json->use-terminal->description
msgid "Run menu actions in a terminal window (shows progress)"
msgstr ""
"Esegui le azioni del menu in una finestra di terminale (mostra l'avanzamento)"

#. files->appman-manager@z3n0e->settings-schema.json->use-terminal->tooltip
msgid ""
"When off, actions run silently in background with \"-y\" (assume yes). "
"Progress shows in the panel icon; the result and full log appear in the menu "
"(\"Last operation\"). Automatic updates always run in background."
msgstr ""
"Se disattivato, le azioni vengono eseguite in silenzio in background con \"-"
"y\" (sì automatico). L'avanzamento si vede dall'icona nel pannello; l'esito "
"e il log completo compaiono nel menu (\"Ultima operazione\"). Gli "
"aggiornamenti automatici vengono sempre eseguiti in background."

#. files->appman-manager@z3n0e->settings-schema.json->terminal-command->description
msgid "Terminal command (empty = system default)"
msgstr "Comando del terminale (vuoto = predefinito di sistema)"

#. files->appman-manager@z3n0e->settings-schema.json->terminal-command->tooltip
msgid ""
"The AppMan command is appended to this, e.g. \"gnome-terminal --\", "
"\"ghostty -e\", \"xfce4-terminal -x\", \"kitty\"."
msgstr ""
"Il comando di AppMan viene aggiunto in coda, per esempio \"gnome-terminal --"
"\", \"ghostty -e\", \"xfce4-terminal -x\", \"kitty\"."

#. files->appman-manager@z3n0e->settings-schema.json->appman-path->description
