#: display-scale@rasmarc/settings-schema.json
msgid "The same setting as in System Settings → Backgrounds. Changes are synchronized in both directions."
msgstr "Той самий параметр, що й у Параметрах системи → Тло. Зміни синхронізуються в обох напрямках."

#: display-scale@rasmarc/native-scale.py:426
msgid "The scaling value is missing."
msgstr "Не вказано значення масштабу."

#: display-scale@rasmarc/native-scale.py:126
msgid "The scaling value must be between 100 and 200 percent."
msgstr "Значення масштабу має бути від 100 до 200 відсотків."

#: display-scale@rasmarc/applet.js:483
msgid "The screen scaling could not be changed."
msgstr "Не вдалося змінити масштаб екрана."

#: display-scale@rasmarc/native-scale.py:129
msgid "The switch point must be 50, 75, 100, 125 or 150."
msgstr "Точка перемикання має бути 50, 75, 100, 125 або 150."

#: display-scale@rasmarc/native-scale.py:211
msgid "The text scaling factor was not applied."
msgstr "Коефіцієнт масштабування тексту не застосовано."

#: display-scale@rasmarc/native-scale.py:416
msgid "This applet requires an X11 session."
msgstr "Цей аплет потребує сеансу X11."

#: display-scale@rasmarc/settings_widgets.py:419
msgid "Tiled"
msgstr "Плитками"

#: display-scale@rasmarc/onboard-process.py:191
msgid "Unknown Onboard action."
msgstr "Невідома дія Onboard."

#: display-scale@rasmarc/onboard-process.py:64
msgid "Unknown Onboard geometry section."
msgstr "Невідомий розділ геометрії Onboard."

#: display-scale@rasmarc/settings-schema.json
msgid "Whole numbers from 101 to 199 only. Leave the field empty to omit this level. Incomplete entries are not applied; invalid characters are rejected."
msgstr "Лише цілі числа від 101 до 199. Залиште поле порожнім, щоб пропустити цей ступінь. Незавершені значення не застосовуються; неприпустимі символи відхиляються."

#: install.py:106
msgid "Without the extension enabled, scaling works with the adjustment options grayed out."
msgstr "Без увімкненого розширення масштабування працює, а параметри пристосування недоступні."

#: display-scale@rasmarc/settings_widgets.py:421
msgid "Zoom"
msgstr "Збільшене"

#: display-scale@rasmarc/native-scale.py:367
#, python-brace-format
msgid "{error}\nReset failed: {recovery_error}"
msgstr "{error}\nНе вдалося скинути налаштування: {recovery_error}"

#: display-scale@rasmarc/settings_widgets.py:341
#, python-format
msgid "“%s” is enabled."
msgstr "«%s» увімкнено."
