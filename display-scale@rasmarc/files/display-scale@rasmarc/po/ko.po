#, python-format
msgid "Display Scale %s and its optional additional features are installed."
msgstr "Display Scale %s 및 선택적 추가 기능이 설치되었습니다."

#: display-scale@rasmarc/settings_widgets.py:340
msgid "Display Scale - Additional Features"
msgstr "Display Scale – 추가 기능"

#: display-scale@rasmarc/onboard-position-compensation.js:143
msgid "Display Scale: Onboard scaling"
msgstr "Display Scale: Onboard 배율 조정"

#: install.py:105
msgid "Enable “Display Scale - Additional Features” in System Settings → Extensions."
msgstr "시스템 설정 → 확장 프로그램에서 “Display Scale – 추가 기능”을 켜세요."

#: display-scale@rasmarc/settings-schema.json
msgid "Five positions: the middle uses the regular switch point at the next screen scaling level; the ends switch half a step earlier or later. The two intermediate marks halve these distances. Text compensation preserves the selected text size. With a later switch point, screen scaling can remain below 200% even at 200% text size."
msgstr "위치는 다섯 개입니다. 가운데는 다음 화면 확대 단계에 도달할 때 기본 전환점을 사용하며, 양 끝은 반 단계 일찍 또는 늦게 전환합니다. 두 중간 눈금은 이 간격을 절반으로 나눕니다. 텍스트 보정으로 선택한 텍스트 크기를 유지합니다. 전환점을 늦추면 텍스트 크기가 200%여도 화면 배율은 200% 미만으로 유지될 수 있습니다."

#: display-scale@rasmarc/scale-slider.js:283
msgid "Half a step earlier"
msgstr "반 단계 일찍"

#: display-scale@rasmarc/scale-slider.js:284
msgid "Half a step later"
msgstr "반 단계 늦게"

#: display-scale@rasmarc/settings-schema.json
msgid "Increment"
msgstr "조절 간격"

#: display-scale@rasmarc/onboard-position-compensation.js:568
msgid "Invalid Onboard geometry."
msgstr "Onboard의 위치와 크기가 잘못되었습니다."

#: display-scale@rasmarc/settings-schema.json
msgid "Keep all panels approximately unchanged in both modes. Screen scaling adjusts panel height (width for vertical panels), icons and text; text scaling adjusts text and font-dependent spacing."
msgstr "두 모드 모두에서 모든 패널을 거의 그대로 유지합니다. 화면 확대는 패널 높이(세로 패널은 너비), 아이콘, 텍스트를 조정하고, 텍스트 확대는 텍스트와 글꼴에 따른 간격을 조정합니다."

#: display-scale@rasmarc/settings-schema.json
msgid "Keep panel size when scaling"
msgstr "확대 시 패널 크기 유지"

#: display-scale@rasmarc/settings-schema.json
msgid "Keep size and position"
msgstr "크기와 위치 유지"

#: display-scale@rasmarc/settings-schema.json
msgid "Keep size and position: Compensate for screen scaling so the keyboard keeps its visible size and position.\nAdapt scaling to keyboard size: Small keyboards grow more; keyboards spanning the screen width or height keep their screen coverage. The larger width or height share determines the adjustment; the ratio of opposite edge distances is preserved.\nManual size and position changes become the new reference. At 100%, the corresponding reference geometry is restored."
msgstr "크기와 위치 유지: 화면 확대를 보정하여 키보드의 보이는 크기와 위치를 유지합니다.\n키보드 크기에 맞춰 배율 조정: 작은 키보드는 더 많이 커지고, 화면 너비나 높이를 가득 채우는 키보드는 화면 점유율을 유지합니다. 너비와 높이 점유율 중 더 큰 값으로 조정하며, 마주 보는 가장자리까지의 거리 비율을 유지합니다.\n크기와 위치를 수동으로 바꾸면 새 기준이 됩니다. 100%에서는 해당 기준 위치와 크기가 복원됩니다."

#: display-scale@rasmarc/settings-schema.json
msgid "Keep the current mode"
msgstr "현재 모드 유지"

#: display-scale@rasmarc/settings-schema.json
msgid "Keep the menu open"
msgstr "메뉴를 열린 상태로 유지"

#: display-scale@rasmarc/settings-schema.json
msgid "Keep the menu open after moving the switch point, including when the screen scaling level changes. When disabled, the menu closes after each successfully applied move."
msgstr "전환점을 옮긴 뒤 화면 확대 단계가 바뀌더라도 메뉴를 열린 상태로 유지합니다. 끄면 이동이 성공적으로 적용될 때마다 메뉴가 닫힙니다."

#: display-scale@rasmarc/settings-schema.json
msgid "Let panel text grow with the selected scaling mode. Text scaling does not reduce panel dimensions or pixel-based icons; spacing protection remains active during screen scaling."
msgstr "선택한 확대 모드에 따라 패널 텍스트가 커지도록 합니다. 텍스트 확대는 패널 치수나 픽셀 단위 아이콘을 줄이지 않으며, 화면 확대 중에도 간격 보호가 유지됩니다."

#: display-scale@rasmarc/settings-schema.json
msgid "Menu"
msgstr "메뉴"

#: display-scale@rasmarc/settings-schema.json
msgid "Move the switch point in the menu"
msgstr "메뉴에서 전환점 이동"

#: display-scale@rasmarc/settings_widgets.py:419
msgid "No picture"
msgstr "이미지 없음"

#: display-scale@rasmarc/onboard-position-compensation.js:411
msgid "Onboard could not be restarted."
msgstr "Onboard를 다시 시작할 수 없습니다."

#: display-scale@rasmarc/onboard-process.py:117
msgid "Onboard did not exit normally. The screen scaling change has been stopped."
msgstr "Onboard가 정상적으로 종료되지 않았습니다. 화면 배율 변경을 중단했습니다."

#: display-scale@rasmarc/onboard-process.py:87
msgid "Onboard does not belong to the current user session."
msgstr "Onboard가 현재 사용자 세션에 속하지 않습니다."

#: display-scale@rasmarc/onboard-process.py:174
msgid "Onboard exited during restart (status {})."
msgstr "다시 시작하는 중 Onboard가 종료되었습니다(상태 {})."

#: display-scale@rasmarc/onboard-position-compensation.js:426
msgid "Onboard is already being restarted."
msgstr "Onboard를 이미 다시 시작하는 중입니다."

#: display-scale@rasmarc/onboard-process.py:177
msgid "Onboard started but has not yet registered with the session."
msgstr "Onboard가 시작되었지만 아직 세션에 등록되지 않았습니다."

#: display-scale@rasmarc/onboard-position-compensation.js:463
msgid "Onboard's final saved geometry could not be read."
msgstr "Onboard가 마지막으로 저장한 위치와 크기를 읽을 수 없습니다."

#: display-scale@rasmarc/onboard-position-compensation.js:454
msgid "Onboard's final saved geometry is invalid."
msgstr "Onboard가 마지막으로 저장한 위치와 크기가 잘못되었습니다."

#: display-scale@rasmarc/onboard-position-compensation.js:558
msgid "Onboard's geometry could not be applied."
msgstr "Onboard의 위치와 크기를 적용할 수 없습니다."

#: display-scale@rasmarc/onboard-position-compensation.js:553
msgid "Onboard's geometry settings are read-only."
msgstr "Onboard의 위치와 크기 설정이 읽기 전용입니다."

#: display-scale@rasmarc/onboard-position-compensation.js:575
msgid "Onboard's reference geometry could not be saved."
msgstr "Onboard의 기준 위치와 크기를 저장할 수 없습니다."

#: display-scale@rasmarc/onboard-process.py:102
msgid "Onboard's relative executable path could not be resolved for restart."
msgstr "다시 시작하는 데 필요한 Onboard 실행 파일의 상대 경로를 확인할 수 없습니다."

#: display-scale@rasmarc/onboard-process.py:150
msgid "Onboard's restart data is invalid."
msgstr "Onboard의 다시 시작 데이터가 잘못되었습니다."

#: display-scale@rasmarc/onboard-position-compensation.js:488
msgid "Onboard's target geometry could not be calculated."
msgstr "Onboard의 목표 위치와 크기를 계산할 수 없습니다."

#: display-scale@rasmarc/settings_widgets.py:332
msgid "Open Extensions"
msgstr "확장 프로그램 열기"

#: display-scale@rasmarc/settings-schema.json
msgid "Press directly on the shaded band and drag it. Five positions range from half a step earlier to half a step later, with the regular switch point in the middle. The band moves one quarter of the pointer distance. Release to apply; Escape cancels. In text mode, the switch point is saved for the next use of screen scaling. The settings slider remains available."
msgstr "음영 띠를 직접 누른 채 드래그하세요. 다섯 위치는 반 단계 일찍부터 반 단계 늦게까지이며, 가운데가 기본 전환점입니다. 띠는 포인터 이동 거리의 1/4만큼 움직입니다. 놓으면 적용하고 Escape를 누르면 취소합니다. 텍스트 모드에서는 다음에 화면 확대를 사용할 때를 위해 전환점을 저장합니다. 설정의 슬라이더도 계속 사용할 수 있습니다."

#: display-scale@rasmarc/scale-slider.js:66
msgid "Press on the band and drag it. Five positions range from half a step earlier to half a step later, with the regular switch point in the middle. The band moves one quarter of the pointer distance. Release to apply; Escape cancels."
msgstr "띠를 누른 채 드래그하세요. 다섯 위치는 반 단계 일찍부터 반 단계 늦게까지이며, 가운데가 기본 전환점입니다. 띠는 포인터 이동 거리의 1/4만큼 움직입니다. 놓으면 적용하고 Escape를 누르면 취소합니다."

