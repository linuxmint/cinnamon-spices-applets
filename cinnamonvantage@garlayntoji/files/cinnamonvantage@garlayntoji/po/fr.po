msgid "System reboot required"
msgstr "Redémarrage du système requis"

#: applet.js:250
msgid "A system reboot is required for this change to take effect."
msgstr "Un redémarrage du système est nécessaire pour que ce changement prenne effet."

#. metadata.json->description
msgid "Displays information and togglables about Lenovo Legion hardware"
msgstr "Affiche des informations et des éléments activables concernant le matériel Lenovo Legion"

#. settings-schema.json->panel->title
msgid "Cinnamon Vantage settings"
msgstr "Paramètres de Cinnamon Vantage"

#. settings-schema.json->winkey-section->title
msgid "Super key"
msgstr "Touche Super"

#. settings-schema.json->usbCharging-section->title
msgid "Alway On USB"
msgstr "USB toujours activé"

#. settings-schema.json->fnLock->description
msgid "Access multimedia keys without holding Fn"
msgstr "Accéder aux touches multimédia sans maintenir Fn"

#. settings-schema.json->winkey->description
msgid "Enables the Super/Windows key"
msgstr "Active la touche Super/Windows"

#. settings-schema.json->touchpad->description
msgid "Enables the laptop's touchpad"
msgstr "Active le pavé tactile du portable"

#. settings-schema.json->conservationMode->description
msgid "Limits the charge of the battery to extend its lifespan"
msgstr "Limite la charge de la batterie pour prolonger sa durée de vie"

#. settings-schema.json->rapidCharge->description
msgid "Allow the battery to charge faster"
msgstr "Permet à la batterie de se recharger plus rapidement"

#. settings-schema.json->usbCharging->description
msgid "Keeps the USB ports always powered on"
msgstr "Garde les ports USB toujours alimentés"

#. settings-schema.json->overdrive->description
msgid "Reduces the laptop's display latency"
msgstr "Réduit la latence de l'écran du portable"

#. settings-schema.json->gsync->description
msgid "Enables the laptop's integrated graphics.\n This setting requires a reboot to take effect."
msgstr "Active la carte graphique intégrée du portable.\n Ce paramètre nécessite un redémarrage pour prendre effet."

#. applet.js:139
msgid "Limit battery charge"
msgstr "Limiter la charge de la batterie"

#. settings-schema.json->chargeLimit-section->title
msgid "Battery charge limit"
msgstr "Limite de charge de la batterie"

#. settings-schema.json->chargeLimitEnabled->description
msgid "Enable a custom battery charge limit"
msgstr "Activer une limite de charge personnalisée"

#. settings-schema.json->chargeLimit->description
msgid "Stop charging at (%)"
msgstr "Arrêter la charge à (%)"

#: applet.js:408 applet.js:432
