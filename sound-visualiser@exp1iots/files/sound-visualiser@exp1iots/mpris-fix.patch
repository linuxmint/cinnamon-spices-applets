+    // Read all player properties from "dest" and store them under the unique name "owner".
+    _readState(dest, owner) {
+        if (this._pending.has(owner))
+            return;
+        this._pending.add(owner);
+        Gio.DBus.session.call(
+            dest, MPRIS_PATH, PROPS_IFACE,
+            'GetAll', new GLib.Variant('(s)', [PLAYER_IFACE]),
+            new GLib.VariantType('(a{sv})'),
+            Gio.DBusCallFlags.NONE, -1, null,
+            (conn, res) => {
+                this._pending.delete(owner);
+                let data;
+                try {
+                    data = conn.call_finish(res).get_child_value(0).recursiveUnpack();
+                } catch (e) {
+                    return;
+                }
+                if (this._destroyed)
+                    return;
+                let player = this._players.get(owner) || this._newPlayer();
