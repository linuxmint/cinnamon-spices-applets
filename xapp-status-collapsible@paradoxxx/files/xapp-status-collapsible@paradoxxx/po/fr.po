#. metadata.json->name
msgid "Collapsible Status Area"
msgstr "Zone de statut repliable"

#. metadata.json->description
msgid "Status icons (XApp and legacy tray) where the applications you choose are tucked behind an arrow, like on Windows. Replaces both the XApp Status and System Tray applets."
msgstr "Icônes de statut (XApp et ancienne zone de notification) où les applications de votre choix se rangent derrière une flèche, comme sous Windows. Remplace les applets XApp Status et Zone de notification."

#. settings-schema.json->head-icons->description
msgid "Applications"
msgstr "Applications"

#. settings-schema.json->icons->description
msgid "Check \"Add\" to move an application into the collapsible area, behind the arrow. Unchecked applications stay on the panel. Double-click a row to rename it, use \"-\" to remove an application that is no longer installed."
msgstr "Cochez « Ajouter » pour ranger une application dans la zone repliable, derrière la flèche. Les applications décochées restent dans la barre. Double-cliquez sur une ligne pour la renommer, utilisez « - » pour retirer une application désinstallée."

#. settings-schema.json->icons->columns->title
msgid "Application"
msgstr "Application"

#. settings-schema.json->icons->columns->title
msgid "Add"
msgstr "Ajouter"

#. settings-schema.json->icons->columns->title
msgid "Identifier"
msgstr "Identifiant"

#. settings-schema.json->head-behavior->description
msgid "Behavior"
msgstr "Comportement"

#. settings-schema.json->auto-collapse->description
msgid "Collapse automatically after"
msgstr "Replier automatiquement après"

#. settings-schema.json->auto-collapse->tooltip
msgid "0 = never collapse automatically"
msgstr "0 = ne jamais replier automatiquement"

#. settings-schema.json->auto-collapse->units
msgid "seconds"
msgstr "secondes"
