      { "name": "海洋", "nameEn": "Ocean", "stops": ["#1B7C83", "#0969DA", "#8250DF"] },
      { "name": "极光", "nameEn": "Aurora", "stops": ["#1A7F37", "#1B7C83", "#0969DA"] },
      { "name": "火焰", "nameEn": "Ember", "stops": ["#9A6700", "#BC4C00", "#D1242F"] },
      { "name": "霓虹", "nameEn": "Neon", "stops": ["#BF3989", "#8250DF", "#0969DA"] }
    ]
  },
  "effects": { "shadowOpacity": 0.18 }
