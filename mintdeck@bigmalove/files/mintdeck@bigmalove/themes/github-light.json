  "apps": {
    "claude": "#BC4C00", "codex": "#1A7F37", "antigravity": "#0969DA", "cursor": "#59636E", "zcode": "#1B7C83",
    "dsh": "#0550AE", "grokBot": "#59636E", "kimi": "#0A8DAE", "manual": "#8250DF", "other": "#59636E", "warning": "#9A6700", "critical": "#D1242F"
