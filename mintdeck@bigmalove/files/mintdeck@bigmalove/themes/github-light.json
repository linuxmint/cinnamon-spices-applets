{
  // Colors from GitHub Theme for Visual Studio Code, "GitHub Light Default" (primer/github-vscode-theme, MIT License).
  "formatVersion": 1,
  "id": "github-light",
  "name": "GitHub Light",
  "description": "GitHub 浅色默认主题：白色底色，清晰的灰阶与语义色。",
  "descriptionEn": "GitHub Light Default: a white surface with crisp grays and semantic colors.",
  "author": "GitHub (Primer)",
  "license": "MIT",
  "homepage": "https://github.com/primer/github-vscode-theme",
  "base": "light",
  "colors": {
    "surface": "#FFFFFF",
    "textPrimary": "#1F2328",
    "textSecondary": "#59636E",
    "textTertiary": "#818B98",
    "accent": "#0969DA",
    "onAccent": "#FFFFFF",
    "danger": "#D1242F",
    "liked": "#CF222E",
    "clock": "#1F2328",
    "equalizer": "#0969DA",
    "hairline": "#D8DEE4",
    "track": "#E6EAEF",
    "ringTrack": "#D1D9E0",
    "fill": "#F6F8FA",
    "fillSelected": "#E1E6EB",
    "hover": "#EFF2F5",
    "pressed": "#E1E6EB",
    "outline": "#D1D9E0",
    "popup": "#FFFFFF",
    "popupBorder": "#D1D9E0",
    "input": "#F6F8FA",
    "rangeFill": "#2E0969DA",
    "coverPlaceholder": "#F6F8FA",
    "coverOutline": "#D1D9E0",
    "scrollThumb": "#C1C8CF",
    "rim": "#D1D9E0",
    "shadow": "#1F2328",
    "indicator": "#8C959F",
    "indicatorProgress": "#1F2328",
    "switchFill": "#F6F8FA",
    "seekRail": "#D1D9E0",
    "rowDivider": "#D8DEE4",
    "rowHover": "#F6F8FA",
    "menuDetail": "#59636E",
    "tooltip": "#FFFFFF",
    "tooltipBorder": "#D1D9E0",
    "bubble": "#FFFFFF",
    "bubbleBorder": "#D1D9E0"
