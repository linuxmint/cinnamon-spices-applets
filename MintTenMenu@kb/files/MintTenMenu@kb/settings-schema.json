{
    "layout1": {
        "type": "layout",
        "pages": ["page-general", "page-nav-rail"],
        "page-general": {
            "type": "page",
            "title": "General",
            "sections": ["section-behavior", "section-panel", "section-menu-size", "section-app-list", "section-tiles"]
        },
        "page-nav-rail": {
            "type": "page",
            "title": "Navigation Rail",
            "sections": ["section-nav-layout", "section-nav-profile", "section-nav-shortcuts", "section-nav-session"]
        },
        "section-behavior": {
            "type": "section",
            "title": "Behavior",
            "keys": ["overlay-key", "activate-on-hover", "hover-delay", "enable-animation"]
        },
        "section-panel": {
            "type": "section",
            "title": "Panel Button",
            "keys": ["menu-label", "menu-icon-preset", "menu-icon-custom", "menu-icon"]
        },
        "section-menu-size": {
            "type": "section",
            "title": "Menu Size",
            "keys": ["custom-menu-width", "custom-menu-height", "font-size-base"]
        },
        "section-app-list": {
            "type": "section",
            "title": "Application List",
            "keys": ["show-recently-used", "show-app-description", "app-description-color"]
        },
        "section-tiles": {
            "type": "section",
            "title": "Tiles",
            "keys": ["tile-corner-radius", "tile-accent-colors"]
        },
        "section-nav-layout": {
            "type": "section",
            "title": "Layout",
            "keys": ["nav-rail-expanded"]
        },
        "section-nav-profile": {
            "type": "section",
            "title": "Profile",
            "keys": ["nav-show-profile"]
        },
        "section-nav-shortcuts": {
            "type": "section",
            "title": "Navigation Shortcuts",
            "keys": [
                "nav-show-recent",
                "nav-show-documents",
                "nav-show-downloads",
                "nav-show-music",
                "nav-show-pictures",
                "nav-show-videos",
                "nav-show-files",
                "nav-show-settings"
            ]
        },
        "section-nav-session": {
            "type": "section",
            "title": "Session Actions",
            "keys": ["nav-show-lock", "nav-show-logout", "nav-show-power"]
        }
    },
    "overlay-key": {
        "type": "keybinding",
        "default": "<Super>",
        "description": "Keyboard shortcut to toggle the menu"
    },
    "activate-on-hover": {
        "type": "switch",
        "default": false,
        "description": "Open the menu when hovering over the panel button"
    },
    "hover-delay": {
        "type": "scale",
        "default": 300,
        "min": 0,
        "max": 2000,
        "step": 50,
        "units": "ms",
        "description": "Delay before opening menu on hover (ms)"
    },
    "enable-animation": {
        "type": "switch",
        "default": true,
        "description": "Enable menu open/close animation"
    },
    "menu-label": {
        "type": "entry",
        "default": "",
        "description": "Label to show next to the Start button icon"
    },
    "menu-icon-preset": {
        "type": "combobox",
        "default": "Default",
        "description": "Start button icon",
        "options": {
            "Default": "Default",
            "Black": "Black",
            "White": "White"
        },
        "dependency": "!menu-icon-custom"
    },
    "menu-icon-custom": {
        "type": "switch",
        "default": false,
        "description": "Use a custom icon for the Start button"
    },
    "menu-icon": {
        "type": "iconfilechooser",
        "default": "",
        "description": "Custom icon for the Start button",
        "dependency": "menu-icon-custom"
    },
    "custom-menu-width": {
        "type": "scale",
        "default": 940,
        "min": 700,
        "max": 1400,
        "step": 10,
        "units": "px",
        "description": "Total menu width"
    },
    "custom-menu-height": {
        "type": "scale",
        "default": 640,
        "min": 400,
        "max": 1200,
        "step": 10,
        "units": "px",
        "description": "Total menu height"
    },
    "font-size-base": {
        "type": "scale",
        "default": 14,
        "min": 10,
        "max": 20,
        "step": 1,
        "units": "px",
        "description": "Base font size for the menu (all text scales from this)"
    },
    "tile-corner-radius": {
        "type": "scale",
        "default": 0,
        "min": 0,
        "max": 16,
        "step": 1,
        "units": "px",
        "description": "Tile corner radius (0 = sharp Win10 style)"
    },
    "show-recently-used": {
        "type": "switch",
        "default": true,
        "description": "Show Recently Used apps section at the top of the app list"
    },
    "nav-rail-expanded": {
        "type": "switch",
        "default": false,
        "description": "Start with the navigation rail expanded (shows labels)"
    },
    "nav-show-profile": {
        "type": "switch",
        "default": true,
        "description": "Show profile picture"
    },
    "nav-show-recent": {
        "type": "switch",
        "default": true,
        "description": "Show Recent"
    },
    "nav-show-documents": {
        "type": "switch",
        "default": true,
        "description": "Show Documents"
    },
    "nav-show-downloads": {
        "type": "switch",
        "default": true,
        "description": "Show Downloads"
    },
    "nav-show-music": {
        "type": "switch",
        "default": true,
        "description": "Show Music"
    },
    "nav-show-pictures": {
        "type": "switch",
        "default": true,
        "description": "Show Pictures"
    },
    "nav-show-videos": {
        "type": "switch",
        "default": true,
        "description": "Show Videos"
    },
    "nav-show-files": {
        "type": "switch",
        "default": true,
        "description": "Show File Manager"
    },
    "nav-show-settings": {
        "type": "switch",
        "default": true,
        "description": "Show Settings"
    },
    "nav-show-lock": {
        "type": "switch",
        "default": true,
        "description": "Show Lock Screen"
    },
    "nav-show-logout": {
        "type": "switch",
        "default": true,
        "description": "Show Log Out"
    },
    "nav-show-power": {
        "type": "switch",
        "default": true,
        "description": "Show Power"
    },
    "tile-accent-colors": {
        "type": "switch",
        "default": true,
        "description": "Allow tiles to have custom accent background colors"
    },
    "show-app-description": {
        "type": "switch",
        "default": true,
        "description": "Show app descriptions in the app list"
    },
    "app-description-color": {
        "type": "colorchooser",
        "default": "rgba(255, 255, 255, 0.6)",
        "description": "App description text color",
        "dependency": "show-app-description"
    }
}
