{
    "daily-reset":{
        "type":"switch",
        "description":"Reset the schedule daily",
        "default":true
    },
    "update-interval":{
        "type":"spinbutton",
        "description":"Clock check interval",
        "default":100,
        "min":1,
        "max":10000,
        "step":1,
        "units":"ms"
    },



    "editSchedules":{
        "type": "button",
        "description": "Edit schedules",
        "callback": "launchScheduleEditor"
    },


    "show-json":{
        "type": "switch",
        "default": false,
        "description": "Show schedule JSON below (not recommended)"
    },
    "schedule-data":{
        "type": "textview",
        "default": "{}",
        "description":"WARNING: Editing this manually can seriously break things.  Use the Edit Schedules button above instead.",
        "dependency": "show-json"
    }
}