{
    "gameMode": {
        "type": "combobox",
        "description": "Game Mode",
        "tooltip": "Select your preferred arcade game mode variant.",
        "options": {
            "Obstacles Course": "obstacles",
            "Jungle Run": "track",
            "Pac-Man Arcade": "pacman",
            "Chinese GO": "go",
            "IQ Test": "iqtest",
            "Sudoku Puzzle": "sudoku",
            "Tetris Block Game": "tetris"
        },
        "default": "pacman"
    },
    "difficulty": {
        "type": "combobox",
        "description": "Game Difficulty",
        "tooltip": "Select your starting game difficulty tier.",
        "options": {
            "Beginner": "Beginner",
            "Easy": "Easy",
            "Normal": "Normal",
            "Hard": "Hard",
            "Professional": "Professional"
        },
        "default": "Normal"
    },
    "speed": {
        "type": "spinbutton",
        "description": "Base Game Speed",
        "tooltip": "Adjust the baseline movement speed.",
        "min": 1,
        "max": 10,
        "step": 1,
        "units": "mps",
        "default": 5
    },
    "carChoice_obstacles": {
        "type": "combobox",
        "default": "🏎️",
        "description": "Select your Emoji (Obstacles)",
        "dependency": "gameMode=obstacles",
        "options": {
            "Race Car": "🏎️", "Classic Car": "🚗", "Police Car": "🚓", "Motorcycle": "🏍️", "Bicycle": "🚲", "Linus" : "🐧"
        }
    },
    "carChoice_track": {
        "type": "combobox",
        "default": "🐘",
        "description": "Select your Emoji (Jungle Run)",
        "dependency": "gameMode=track",
        "options": {
            "Jungle Run Elephant": "🐘", "Jungle Run Gorilla": "🦍", "Jungle Run Hippo": "🦛", "Jungle Run Monkey": "🐒", "Jungle Run Man": "🏃", "Jungle Run Woman": "🏃‍♀️", "Linus" : "🐧"
        }
    },
    "carChoice_pacman": {
        "type": "combobox",
        "default": "😂",
        "description": "Select your Emoji (Pac-Man)",
        "dependency": "gameMode=pacman",
        "options": {
            "Pac Man Smile": "😁", "Pac Man Laugh": "😂", "Pac Man Hearts": "🥰", "Pac Man Alien": "👽", "Linus" : "🐧"
        }
    },
    "carChoice_go": {
        "type": "combobox",
        "default": "⚫",
        "description": "Select your Emoji (Chinese GO)",
        "dependency": "gameMode=go",
        "options": {
            "Black Stone": "⚫"
        }
    },
    "carChoice_iqtest": {
        "type": "combobox",
        "default": "🧠",
        "description": "Select your Emoji (IQ Test)",
        "dependency": "gameMode=iqtest",
        "options": {
            "Brain": "🧠", "Thinking Face": "🤔"
        }
    },
    "carChoice_sudoku": {
        "type": "combobox",
        "default": "🧩",
        "description": "Select your Emoji (Sudoku)",
        "dependency": "gameMode=sudoku",
        "options": {
            "Puzzle Piece": "🧩",
            "Race Car": "🏎️",
            "Pac Man Laugh": "😂",
            "Brain": "🧠"
        }
    },
    "carChoice_tetris": {
        "type": "combobox",
        "default": "🧱",
        "description": "Select your Emoji (Tetris)",
        "dependency": "gameMode=tetris",
        "options": {
            "Tetris Red": "🟥", "Tetris Green": "🟩", "Tetris Blue": "🟦", "Tetris Wall": "🧱"
        }
    },
    "scale": {
        "type": "scale",
        "description": "Applet Scale / Size",
        "tooltip": "Drag to scale up or down the gameplay canvas window.",
        "min": 0.5,
        "max": 2.0,
        "step": 0.05,
        "default": 2.0
    },
    "show_gta_artwork_btn": {
        "type": "button",
        "description": "Show GTA Artwork",
        "tooltip": "Opens the high-resolution applet asset artwork.",
        "label": "Show GTA Artwork",
        "callback": "on_show_artwork_pressed"
    },
    "clear_high_score_btn": {
        "type": "button",
        "description": "Reset High Score Tracker",
        "tooltip": "Wipes your local high scores completely.",
        "label": "Clear High Score",
        "callback": "on_clear_high_score_pressed"
    },
    "tips_header": {
        "type": "label",
        "description": "Tips & Tricks"
    },
    "tips_content": {
        "type": "label",
        "description": "  • Car/Pac-Man: Use keyboard arrows to navigate the board corridors.\n  • Chinese GO: Arrows move the cursor, Space/Start drops Black/White stones.\n  • IQ Test: Left=A, Up=B, Right=C, Down=D.\n  • Tetris: Left/Right to slide blocks, Up to rotate shapes, Down to drop faster."
    },
    "Ack_header": {
        "type": "label",
        "description": "Acknowledgements"
    },
    "Ack_content": {
        "type": "label",
        "description": "  • Thank you to my wife Judy for her testing and ideas.\n  • Thank you to the AI assistant at Google for help with designing and coding the applet logic."
    }
}

